#!/usr/bin/env python3
#
# fleet — my Azure DevOps work and PRs to review, one key to hand each to a
# background Claude agent.
#
# Shares tracker, auth and PR plumbing with wf/wp/wr (bin/wf, bin/wr). Whole
# org: work items assigned to me in To Do/Doing, active PRs I haven't approved, my own
# active PRs, and fleet agents whose item/PR has left the list.
#
# Type:
#
#   fleet                    live list (TUI); in Ghostty also opens `claude agents` (only sessions under the
#                            first root) in a pane to the left;
#                            autopilot: starts review/fix agents by itself, weekdays 07–17 (~/.config/fleet/config.toml);
#                            keeps the Mac from idle-sleeping while it runs (caffeinate -i)
#   fleet ls                 same list, printed once
#   fleet go 8698            background agent on a work item: map → /wayfinder, else /implement
#   fleet review 6966        background agent reviewing a PR: /review-pr
#   fleet fix 7012           background agent fixing my PR: conflicts, failing build, review comments
#   fleet prune [-n]         remove finished fleet agents whose item/PR is gone from the list
#   fleet code 9006          VS Code in the item's worktree, .env* copied from the main checkout
#   fleet clean [-n]         remove worktrees of Done work items where nothing can be lost
#   fleet help               explained (Norwegian)
#
# What the list shows is written to ~/.cache/fleet/screen.txt and state.json every
# 15 s, so a Claude session can read it.
#
# Agents run in the local clone of the item's/PR's repo (found under FLEET_ROOTS,
# default ~/visense), else in the first root. Named fleet-wi-<id> / fleet-pr-<id> / fleet-fix-<id>.
# TUI: ↑↓/jk move · m actions for the row · enter start agent (pick prompt, or type one) · →/← unfold/fold a map or spec · o open · a all PRs · A autopilot · r refresh · q quit

import argparse
import concurrent.futures
import curses
import datetime
import fcntl
import importlib.machinery
import importlib.util
import json
import locale
import os
import re
import shlex
import shutil
import subprocess
import sys
import threading
import time
import tomllib
import urllib.error
import urllib.parse
import urllib.request


def _load(name):
    loader = importlib.machinery.SourceFileLoader(name, os.path.join(os.path.dirname(os.path.realpath(__file__)), name))
    mod = importlib.util.module_from_spec(importlib.util.spec_from_loader(name, loader))
    loader.exec_module(mod)
    return mod


wr = _load("wr")
wf, wp = wr.wf, wr.wp
from_wf = ("bold", "dim", "cyan", "green", "yellow", "red", "TTY")
globals().update({k: getattr(wf, k) for k in from_wf})
A, ts, ago, rest, me = wp.A, wp.ts, wp.ago, wr.rest, wr.me

STATES = ("Doing", "To Do")
OLD = 45  # days: work items created before this only show as one row that opens their query
REFRESH = 15  # seconds between data refreshes
SKIP = "--dangerously-skip-permissions"  # every agent fleet starts, and every one dispatched from agent view
WRITE = 15    # seconds between state file writes
OUT = os.path.expanduser(os.environ.get("FLEET_OUT", "~/.cache/fleet"))
ROOTS = [os.path.expanduser(p) for p in os.environ.get("FLEET_ROOTS", "~/visense").split(":") if p]
HOME = ROOTS[0]
AGENTS = f"claude agents --cwd {shlex.quote(HOME)} {SKIP}"  # only sessions started under the first root


def die(msg):
    print(f"fleet: {msg}", file=sys.stderr)
    sys.exit(1)


# ── local clones ────────────────────────────────────────────────────────────

_clones = None


def clones():
    """{(project, repo) lowercased: path} for ADO clones one level under each root.
    A dir named like its repo wins over other clones of it (feature copies)."""
    global _clones
    if _clones is None:
        _clones = {}
        for root in ROOTS:
            try:
                names = sorted(os.listdir(root))
            except OSError:
                continue
            for n in names:
                d = os.path.join(root, n)
                if not os.path.exists(os.path.join(d, ".git")):
                    continue
                m = re.search(r"dev\.azure\.com/[^/]+/([^/]+)/_git/([^/]+?)/?$",
                              wf.sh("git", "-C", d, "remote", "get-url", "origin"))
                if not m:
                    continue
                key = (urllib.parse.unquote(m.group(1)).lower(), urllib.parse.unquote(m.group(2)).lower())
                if key not in _clones or n.lower() == key[1]:
                    _clones[key] = d
    return _clones


_repo_ids = None


def repo_ids():
    """{repo id: (project, name)} for every repo in the org."""
    global _repo_ids
    if _repo_ids is None:
        _repo_ids = {r["id"]: (r["project"]["name"], r["name"])
                     for r in rest("git/repositories", scope="org")["value"]}
    return _repo_ids


# ── data ────────────────────────────────────────────────────────────────────


class Work:
    def __init__(self, it, parent=None, status=None):
        self.it, self.parent, self.status = it, parent, status
        self.id, self.title, self.state, self.url = it.id, it.title, it.state, it.url
        self.project, self.type = it.project, it.type
        self.kind = "map" if it.is_map else "spec" if it.is_spec else "item"
        self.key = f"fleet-wi-{self.id}"
        self.children, self.done_children = [], 0  # a map's/spec's open tickets (Work), and how many are done
        self.trees = []  # local worktrees for this item, see worktrees()
        self.prs = []  # my active PRs (Mine) that link this item or carry its id in their branch

    @property
    def decision(self):
        """A map ticket that resolves a decision (research, grilling, …), not a task to execute."""
        return self.parent is not None and self.it.kind not in (None, "task") and not self.it.is_spec

    @property
    def skill(self):
        return "/wayfinder" if self.kind == "map" or self.decision else "/implement"

    @property
    def folds(self):
        """Shows its open tickets under it: maps and specs."""
        return self.kind in ("map", "spec")

    @property
    def task(self):
        return not self.folds and (self.type.lower() == "task" or self.it.kind == "task")

    @property
    def prompt(self):
        return f"/wayfinder {self.parent.id} ticket {self.id}" if self.decision else f"{self.skill} {self.id}"


def unfold(m):
    """Fill a map's or spec's children: open tickets as frontier (ledig), claimed (tatt), blocked (blokkert)."""
    kids = wf.many(m.it.links(wf.CHILD))
    take, claimed, blocked = wf.classify(kids, need_ready=False)
    m.children = [Work(t, m, st) for st, ts_ in (("ledig", take), ("tatt", claimed), ("blokkert", blocked))
                  for t in ts_]
    m.done_children = sum(k.done for k in kids)


class Old:
    """The one row for my To Do/Doing work items older than OLD days: enter opens their query."""
    def __init__(self, n):
        self.n, self.id, self.key, self.title = n, None, "fleet-old", f"{n} gamle work items tildelt meg"
        self.url = f"{A().org}/{urllib.parse.quote(A().project)}/_queries/query/?wiql=" \
            + urllib.parse.quote(wiql(f"[System.CreatedDate] < @Today - {OLD}"))


def wiql(when):
    return ("SELECT [System.Id], [System.WorkItemType], [System.Title], [System.State], [System.CreatedDate], "
            "[System.TeamProject] FROM WorkItems WHERE [System.AssignedTo] = @Me AND [System.State] IN ("
            + ", ".join(f"'{s}'" for s in STATES) + f") AND {when} ORDER BY [System.CreatedDate] DESC")


def work():
    """(items, Old): my work items in To Do/Doing across the org created the last OLD days: bugs
    first, then Doing, then by id. Tasks under a map or spec only show as its children; the parent
    is listed even if not mine."""
    q = lambda when: [w["id"] for w in rest("wit/wiql", {"query": wiql(when)}, scope="org")["workItems"]]
    ids, old = q(f"[System.CreatedDate] >= @Today - {OLD}"), Old(len(q(f"[System.CreatedDate] < @Today - {OLD}")))
    wf._cache.clear()
    its = wf.many(ids)
    wf.fetch([p for t in its for p in t.links(wf.PARENT)])
    heads = {p.id: p for t in its for p in wf.many(t.links(wf.PARENT)) if p.is_map or p.is_spec}
    items = [Work(t, next((Work(heads[p]) for p in t.links(wf.PARENT) if p in heads), None)) for t in its]
    under = {w.parent.id for w in items if w.task and w.parent}
    items = [w for w in items if not (w.task and w.parent)]
    mine_ = {w.id for w in items}
    items += [Work(heads[i]) for i in sorted(under - mine_)]
    folds = [w for w in items if w.folds]
    wf.fetch([c for m in folds for c in m.it.links(wf.CHILD)])
    for m in folds:
        unfold(m)
    return sorted(items, key=lambda w: (w.type.lower() != "bug",
                                        STATES.index(w.state) if w.state in STATES else 9, w.id)), old


class Review:
    def __init__(self, raw, my_id):
        self.pr = wr.PR(raw)
        p = self.pr
        self.id, self.title, self.repo, self.url = p.id, p.title, p.repo, p.url
        self.project = raw["repository"]["project"]["name"]
        self.url = f"{A().org}/{urllib.parse.quote(self.project)}/_git/{urllib.parse.quote(self.repo)}" \
                   f"/pullrequest/{self.id}"
        self.who, self.created, self.source, self.target = p.who, p.created, p.source, p.target
        mine = next((r for r in raw.get("reviewers") or [] if r.get("id") == my_id), None)
        self.asked = mine is not None
        self.vote = mine.get("vote", 0) if mine else 0
        self.key = f"fleet-pr-{self.id}"


def active():
    """Every active PR in the org, raw."""
    return rest("git/pullrequests?searchCriteria.status=active&$top=500", scope="org")["value"]


def reviews(raw, everyone):
    """Active, non-draft PRs by others that I haven't approved. Only those I'm a reviewer
    on unless everyone. Newest first."""
    my_id = me()[0]
    out = [Review(r, my_id) for r in raw
           if not r.get("isDraft") and (r.get("createdBy") or {}).get("id") != my_id]
    return [r for r in out if r.vote < 5 and (everyone or r.asked)]


class Mine:
    """One of my own active PRs, and what stands between it and completing."""
    def __init__(self, raw):
        self.pr = p = wr.PR(raw)
        self.id, self.title, self.repo, self.project = p.id, p.title, p.repo, p.project
        self.url = f"{A().org}/{urllib.parse.quote(self.project)}/_git/{urllib.parse.quote(self.repo)}" \
                   f"/pullrequest/{self.id}"
        self.source, self.target, self.created = p.source, p.target, p.created
        self.votes = [(n.split(" ")[0], v) for n, v, _ in p.reviewers if v < 0]  # (first name, -5/-10)
        self.threads = 0  # active comment threads, see detail()
        self.items = set()  # work item ids it links, or its branch carries
        self.key = f"fleet-fix-{self.id}"

    @property
    def failing(self):
        return [n for n, st, b in self.pr.policies if b and st in ("rejected", "broken")]

    @property
    def todo(self):
        """What a fix agent should deal with, in words."""
        return ((["merge-konflikter"] if self.pr.conflicts else [])
                + [f"{n} feiler" for n in self.failing]
                + [f"{n} {'avviste' if v == -10 else 'venter på endringer'}" for n, v in self.votes]
                + ([f"{self.threads} aktive kommentartråder"] if self.threads else []))

    @property
    def prompt(self):
        todo = "; ".join(self.todo) or "ingenting åpenbart blokkerer — sjekk bygg og kommentarer likevel"
        return (f"Min PR !{self.id} i {self.repo} ({self.url}): {todo}. Jobb på kildebranchen {self.source} "
                f"(`git fetch origin && git switch {self.source}` om du ikke står på den). Løs konflikter mot "
                f"{self.target}, få bygget grønt, og ta tak i aktive review-kommentarer: fiks, svar i tråden og "
                f"sett den til resolved — er du uenig, svar med begrunnelse og la den stå. Push til "
                f"{self.source}. Ikke complete PR-en.")


def detail(m):
    """Fill in a Mine's policies, active threads and linked work items. ADO errors leave them empty."""
    p = m.pr
    base = f"git/repositories/{p.raw['repository']['id']}/pullRequests/{p.id}"
    wr.policies(p)
    try:
        ts_ = rest(f"{base}/threads", project=p.project)["value"]
        m.threads = sum(1 for t in ts_ if t.get("status") == "active" and not t.get("isDeleted")
                        and (t.get("comments") or [{}])[0].get("commentType") != "system")
        m.items |= {int(w["id"]) for w in rest(f"{base}/workitems", project=p.project)["value"]}
    except RuntimeError:
        pass
    m.items |= {int(i) for i in TREE_ID.findall(m.source)}


def mine(raw):
    """My active PRs, drafts included. Newest first."""
    my_id = me()[0]
    out = [Mine(r) for r in raw if (r.get("createdBy") or {}).get("id") == my_id]
    with concurrent.futures.ThreadPoolExecutor(8) as ex:
        list(ex.map(detail, out))
    return out


def sessions():
    """Every background/interactive Claude session `claude agents` knows, done ones included."""
    try:
        return json.loads(subprocess.run(["claude", "agents", "--json", "--all"], capture_output=True,
                                         text=True, timeout=20).stdout or "[]")
    except (subprocess.SubprocessError, ValueError, OSError):
        return []


def agents(raw):
    """{name: state} for fleet's sessions (the newest wins a shared name)."""
    out = {}
    for a in sorted(raw, key=lambda a: a.get("startedAt", 0)):
        if (a.get("name") or "").startswith("fleet-"):
            out[a["name"]] = a.get("state") or a.get("status") or "?"
    return out


class Orphan:
    """A fleet session whose work item or PR is no longer in the list (Done, reassigned,
    approved, completed)."""
    def __init__(self, a):
        self.a, self.sid, self.name, self.cwd = a, a["id"], a.get("name", ""), a.get("cwd", "")
        self.state = a.get("state") or a.get("status") or "?"
        self.started = datetime.datetime.fromtimestamp(a.get("startedAt", 0) / 1000, datetime.timezone.utc)
        self.id, self.title, self.url = self.sid, self.name, None
        self.key = f"fleet-orphan-{self.sid}"

    @property
    def finished(self):
        return self.state in ("done", "failed", "error")


def orphans(raw, keys):
    """Orphans among the fleet sessions, oldest first. keys: the agent names something in the list owns."""
    return [Orphan(a) for a in sorted(raw, key=lambda a: a.get("startedAt", 0))
            if (a.get("name") or "").startswith("fleet-") and a["name"] not in keys]


def end(o):
    """Stop (if running) and delete an orphan's session. `claude rm` keeps a worktree
    with unpushed work and says so."""
    if not o.finished:
        subprocess.run(["claude", "stop", o.sid], capture_output=True)
    r = subprocess.run(["claude", "rm", o.sid], capture_output=True, text=True)
    out = (r.stderr or r.stdout).strip()
    if r.returncode:
        raise RuntimeError(f"{o.name}: {out.splitlines()[-1] if out else f'claude rm feilet ({r.returncode})'}")
    return f"✓ fjernet {o.name} ({o.sid})" + (f" · {out.splitlines()[-1][:80]}" if out else "")


def stop(o):
    r = subprocess.run(["claude", "stop", o.sid], capture_output=True, text=True)
    if r.returncode:
        raise RuntimeError(f"{o.name}: {(r.stderr or r.stdout).strip()[:80] or 'claude stop feilet'}")
    return f"■ stoppet {o.name} ({o.sid})"


class Snapshot:
    def __init__(self, items=(), prs=(), agents_=None, at=0.0, error="", mine_=(), old=None):
        self.old = old  # Old, or None before the first fetch
        self.items, self.prs, self.agents, self.at, self.error = list(items), list(prs), agents_ or {}, at, error
        self.mine = list(mine_)  # Mine
        self.orphans = []  # Orphan
        self.cleanup = []  # Cleanup: worktrees of Done items fleet couldn't safely remove
        self.cleaned = []  # result lines of what this refresh removed
        self.auto, self.autohead, self.news = {}, "", []  # autopilot: {key: chip}, header text, result lines


def snapshot(everyone, clean=False):
    """Everything the list shows. clean: also remove worktrees of Done items where it's safe."""
    raw = sessions()
    try:
        prs = active()
        items, old = work()
        s = Snapshot(items, reviews(prs, everyone), agents(raw), time.time(), mine_=mine(prs), old=old)
        others = reviews(prs, True)
    except RuntimeError as e:
        return Snapshot(at=time.time(), error=str(e))
    flat = s.items + [t for m in s.items for t in m.children]
    by_pr = {}
    for m in s.mine:
        for i in m.items:
            by_pr.setdefault(i, []).append(m)
    for w in flat:
        w.prs = by_pr.get(w.id, [])
    s.orphans = orphans(raw, {x.key for x in flat + others + s.mine})
    ts_ = trees()
    by_id = {}
    for t in ts_:
        for i in t.ids:
            by_id.setdefault(i, []).append((t.main, t.path))
    for w in flat:
        w.trees = by_id.get(w.id, [])
    try:
        cands = candidates(ts_, raw)
        listed = {r.id for r in others}
        cands += [Cleanup(t, [], *check(t, ts_, raw), review=i) for i, t in review_trees().items() if i not in listed]
    except RuntimeError as e:
        s.error = f"opprydding: {e}"
        return s
    for c in cands:
        if clean and not c.reasons:
            s.cleaned.append(remove(c, raw))
        else:
            s.cleanup.append(c)
    return s


# ── worktrees ───────────────────────────────────────────────────────────────

REVIEW_TREE = re.compile(r"fleet-review(\d+)$")
TREE_ID = re.compile(r"(?:^t?|[-_/+])(\d{3,6})(?=$|[-_/+.])")  # fleet-9006, t9006, feat/9006-x
SKIP_DIRS = {".git", ".claude", "node_modules", "bin", "obj", "dist", "build", ".next", ".turbo", ".venv"}


class Tree:
    """A linked worktree that belongs to work items: its dir name or branch carries their ids."""
    def __init__(self, main, path, branch, head, locked, ids):
        self.main, self.path, self.branch, self.head, self.locked, self.ids = main, path, branch, head, locked, ids


def trees():
    """Linked worktrees of every repo under ROOTS whose dir name or branch carries a work
    item id (fleet-<id>, t<id>, feat/<id>-…)."""
    return [t for t in linked() if t.ids]


def review_trees():
    """{PR id: Tree} for the worktrees autopilot's reviews made: fleet-review<id>."""
    return {int(m.group(1)): t for t in linked() if (m := REVIEW_TREE.match(os.path.basename(t.path)))}


def linked():
    """Every linked worktree of the repos under ROOTS, with the work item ids it carries."""
    out = []
    for root in ROOTS:
        try:
            names = sorted(os.listdir(root))
        except OSError:
            continue
        for n in names:
            d = os.path.join(root, n)
            if not os.path.isdir(os.path.join(d, ".git")):
                continue
            entries = wf.sh("git", "-C", d, "worktree", "list", "--porcelain").split("\n\n")
            for e in entries[1:]:  # the first is the main checkout
                ls = e.splitlines()
                f = dict(l.split(" ", 1) for l in ls if " " in l)
                path, branch = f.get("worktree"), f.get("branch", "").removeprefix("refs/heads/")
                if not path or not os.path.isdir(path):
                    continue
                ids = {int(i) for x in (os.path.basename(path), branch) for i in TREE_ID.findall(x)}
                locked = next((l.removeprefix("locked").strip() or "låst" for l in ls if l.startswith("locked")), None)
                out.append(Tree(d, path, branch, f.get("HEAD", ""), locked, ids))
    return out


def worktrees():
    """{work item id: [(main checkout, worktree)]}."""
    out = {}
    for t in trees():
        for i in t.ids:
            out.setdefault(i, []).append((t.main, t.path))
    return out


# ── cleanup ─────────────────────────────────────────────────────────────────
# A worktree is finished when every work item its name carries is Done (Done/Closed/
# Removed/Resolved): that happens when its PR completes. It is removed — with the
# local branch when a completed PR merged it, and the Claude sessions that worked in it —
# only when nothing can be lost; otherwise it's listed with the reasons.

LOG = os.path.join(OUT, "cleanup.log")


class Cleanup:
    """A finished worktree: of Done work items, or (review: PR id) of an autopilot review whose
    PR left the list."""
    def __init__(self, tree, items, reasons, pr, review=None):
        self.tree, self.items, self.reasons, self.pr = tree, items, reasons, pr
        if review:
            self.id, self.title, self.url, self.label = review, f"autopilot-review av !{review}", None, f"!{review} borte"
        else:
            self.id, self.title, self.url = items[0].id, items[0].title, items[0].url
            self.label = f"#{self.id} Done"
        self.key = f"fleet-clean-{tree.path}"


def alive(pid):
    try:
        os.kill(pid, 0)
        return True
    except (OSError, ValueError):
        return False


def inside(path, tree):
    return path == tree or path.startswith(tree.rstrip("/") + "/")


def merged_pr(t):
    """The completed PR whose last source commit is this worktree's HEAD, or None."""
    m = re.search(r"dev\.azure\.com/[^/]+/([^/]+)/_git/([^/]+?)/?$",
                  wf.sh("git", "-C", t.main, "remote", "get-url", "origin"))
    if not m or not t.branch:
        return None
    proj, repo_ = urllib.parse.unquote(m.group(1)), urllib.parse.unquote(m.group(2))
    q = urllib.parse.urlencode({"searchCriteria.sourceRefName": f"refs/heads/{t.branch}",
                                "searchCriteria.status": "completed", "$top": 20})
    prs = rest(f"git/repositories/{urllib.parse.quote(repo_)}/pullrequests?{q}", project=proj)["value"]
    return next((p for p in prs if (p.get("lastMergeSourceCommit") or {}).get("commitId") == t.head), None)


def check(t, others, raw):
    """(reasons it isn't safe to remove, completed PR or None)."""
    reasons = []
    busy = [a for a in raw if inside(a.get("cwd", ""), t.path) and a.get("state") != "done"]
    if busy:
        reasons.append("agent " + ", ".join(f"{a.get('name') or a['id']} {a.get('state')}" for a in busy))
    if any(inside(o.path, t.path) for o in others if o is not t):
        reasons.append("har worktrees inni")
    if t.locked:
        pid = re.search(r"pid (\d+)", t.locked)
        if not pid or alive(int(pid.group(1))):
            reasons.append(f"låst ({t.locked[:40]})")
    if wf.sh("git", "-C", t.path, "status", "--porcelain"):
        reasons.append("ulagrede endringer")
    pr = merged_pr(t)
    if not pr and wf.sh("git", "-C", t.path, "rev-list", "--count", "HEAD", "--not", "--remotes") not in ("", "0"):
        reasons.append("commits som ikke er pushet/merget")
    return reasons, pr


def candidates(ts_, raw):
    """Cleanup per worktree whose work items are all Done, with what stands in the way."""
    ids = sorted({i for t in ts_ for i in t.ids})
    wf.fetch(ids)
    out = []
    for t in ts_:
        items = [wf._cache[i] for i in sorted(t.ids) if i in wf._cache]
        if len(items) != len(t.ids) or not all(it.done for it in items):
            continue
        reasons, pr = check(t, ts_, raw)
        out.append(Cleanup(t, items, reasons, pr))
    # innermost first, so a nested worktree goes before the one around it
    return sorted(out, key=lambda c: -c.tree.path.count("/"))


def log(line):
    os.makedirs(OUT, exist_ok=True)
    with open(LOG, "a") as f:
        f.write(f"{datetime.datetime.now().isoformat(timespec='seconds')}  {line}\n")


def remove(c, raw, force=False):
    """Remove the worktree, then its branch (when a completed PR merged it), and the Claude
    sessions that worked in it. force: also when dirty/locked/busy. Returns a result line."""
    t, done = c.tree, []
    for a in raw:
        if inside(a.get("cwd", ""), t.path):
            if a.get("state") != "done":
                subprocess.run(["claude", "stop", a["id"]], capture_output=True)
            subprocess.run(["claude", "rm", a["id"]], capture_output=True)
            done.append(f"session {a.get('name') or a['id']}")
    if os.path.isdir(t.path):
        if t.locked and force:
            wf.sh("git", "-C", t.main, "worktree", "unlock", t.path)
        r = subprocess.run(["git", "-C", t.main, "worktree", "remove"] + (["--force"] if force else []) + [t.path],
                           capture_output=True, text=True)
        if r.returncode:
            line = f"✗ {short(t.path)}: {r.stderr.strip().splitlines()[-1] if r.stderr.strip() else 'git feilet'}"
            log(line)
            return line
    done.insert(0, "worktree")
    if t.branch and c.pr and t.branch not in ("main", "master"):
        if subprocess.run(["git", "-C", t.main, "branch", "-D", t.branch], capture_output=True).returncode == 0:
            done.append(f"branch {t.branch}")
    line = f"🧹 {c.label} → fjernet {', '.join(done)} ({short(t.path)})"
    log(line)
    return line


_env_files = {}


def env_files(main):
    """.env* files in a checkout, relative paths, skipping dependency/build dirs. Cached."""
    if main not in _env_files:
        found = []
        for dirpath, dirs, files in os.walk(main):
            dirs[:] = [x for x in dirs if x not in SKIP_DIRS]
            found += [os.path.relpath(os.path.join(dirpath, f), main) for f in files if f.startswith(".env")]
        _env_files[main] = sorted(found)
    return _env_files[main]


def copy_env(main, tree):
    """Copy the main checkout's .env* files into a worktree: only where the worktree has the
    directory but not the file. Returns the copied relative paths."""
    copied = []
    for rel in env_files(main):
        dst = os.path.join(tree, rel)
        if os.path.exists(dst) or not os.path.isdir(os.path.dirname(dst)):
            continue
        try:
            shutil.copy2(os.path.join(main, rel), dst)
            copied.append(rel)
        except OSError:
            pass
    return copied


def open_code(main, tree):
    copied = copy_env(main, tree)
    r = subprocess.run(["code", tree], capture_output=True, text=True)
    if r.returncode:
        r = subprocess.run(["open", "-a", "Visual Studio Code", tree], capture_output=True, text=True)
    if r.returncode:
        raise RuntimeError(f"fikk ikke åpnet VS Code: {(r.stderr or '').strip()[:80]}")
    return f"⎇ VS Code i {short(tree)}" + (f" · kopierte {', '.join(copied)}" if copied else "")


def code_menu(w):
    return (f"#{w.id} worktrees", [(str(n), short(tree), lambda m=main, t=tree: open_code(m, t), False)
                                   for n, (main, tree) in enumerate(w.trees[:9], 1)])


def code_option(w):
    """The menu's `v` entry: straight to VS Code with one worktree, a picker with several."""
    if not w.trees:
        return []
    if len(w.trees) == 1:
        main, tree = w.trees[0]
        return [("v", f"VS Code i {os.path.basename(tree)}", lambda: open_code(main, tree), False)]
    return [("v", f"VS Code i worktree ({len(w.trees)})", lambda: code_menu(w), "sub")]


# ── launching ───────────────────────────────────────────────────────────────


def trust(path):
    """Skip claude's trust/import dialogs for path (a repo's main checkout, or the dir)."""
    common = wf.sh("git", "-C", path, "rev-parse", "--path-format=absolute", "--git-common-dir")
    root = os.path.dirname(common) if common.endswith("/.git") else path
    cfg_path = os.path.expanduser("~/.claude.json")
    try:
        with open(cfg_path) as f:
            cfg = json.load(f)
    except (OSError, ValueError):
        return
    proj = cfg.setdefault("projects", {}).setdefault(root, {})
    if proj.get("hasTrustDialogAccepted") and proj.get("hasClaudeMdExternalIncludesApproved"):
        return
    proj.update(hasTrustDialogAccepted=True, hasClaudeMdExternalIncludesApproved=True,
                hasClaudeMdExternalIncludesWarningShown=True)
    tmp = f"{cfg_path}.fleet-{os.getpid()}"
    with open(tmp, "w") as f:
        json.dump(cfg, f, indent=2)
    os.replace(tmp, cfg_path)


def where_work(w):
    """(cwd, worktree) for a work item: the one local clone its (and its children's) linked
    commits/PRs touch, in a worktree; else HOME. Maps always run in HOME."""
    if w.skill == "/wayfinder":
        return HOME, None
    items = [w.it] + wf.many(w.it.links(wf.CHILD))
    ids = repo_ids()
    paths = {clones().get(tuple(s.lower() for s in ids[r])) for t in items for r in t.repos if r in ids}
    paths.discard(None)
    if len(paths) == 1:
        return paths.pop(), f"fleet-{w.id}"
    return HOME, None


def where_review(r):
    return clones().get((r.project.lower(), r.repo.lower())), None


def where_fix(m):
    """(cwd, worktree) for fixing my PR: the checkout that already has its source branch,
    else a new worktree fleet-pr<id> in the repo's clone (no dash: not a work item id).
    (None, None) without a clone."""
    main = clones().get((m.project.lower(), m.repo.lower()))
    if not main:
        return None, None
    for e in wf.sh("git", "-C", main, "worktree", "list", "--porcelain").split("\n\n"):
        f = dict(l.split(" ", 1) for l in e.splitlines() if " " in l)
        if f.get("branch") == f"refs/heads/{m.source}" and os.path.isdir(f.get("worktree", "")):
            return f["worktree"], None
    return main, f"fleet-pr{m.id}"


def plan(x, prompt=None):
    """(cwd, cmd) that starts the background agent for a Work, Mine, Review, or anything with
    where() → (cwd, worktree) and prompt (wp's failed runs). prompt: instead of the row's own."""
    if hasattr(x, "where"):
        cwd, wt = x.where()
        prompt = prompt or x.prompt
    elif isinstance(x, Work):
        cwd, wt = where_work(x)
        prompt = prompt or x.prompt
    elif isinstance(x, Mine):
        cwd, wt = where_fix(x)
        if not cwd:
            raise RuntimeError(f"ingen lokal klone av {x.project}/{x.repo} under {', '.join(short(r) for r in ROOTS)}")
        prompt = prompt or x.prompt
    else:
        cwd, wt = where_review(x)
        prompt = prompt or (f"/review-pr {x.id}" if cwd else f"/review-pr {x.url}")
        cwd = cwd or HOME
    cmd = ["claude", SKIP, "--bg", "-n", x.key]
    if wt:
        cmd += ["-w", wt]
    return cwd, cmd + [prompt]


def launch(x, prompt=None):
    """Start the agent. Returns a one-line result; raises RuntimeError on failure."""
    cwd, cmd = plan(x, prompt)
    trust(cwd)
    r = subprocess.run(cmd, cwd=cwd, capture_output=True, text=True)
    if r.returncode:
        raise RuntimeError((r.stderr or r.stdout).strip().splitlines()[-1] if (r.stderr or r.stdout).strip()
                           else f"claude exited {r.returncode}")
    m = re.search(r"backgrounded · (\w+)", r.stdout)
    return f"▶ {x.key} startet{f' ({m.group(1)})' if m else ''} i {short(cwd)}: {cmd[-1][:60]}"


def starts(x):
    """[(label, row, prompt)] offered when enter starts an agent on x: its own prompt first, then
    fixing its PRs, then what fits the kind of row. row is whose agent (name, cwd) runs it;
    prompt None = row's own."""
    if isinstance(x, Mine):
        return [(f"fiks: {'; '.join(x.todo) or 'sjekk bygg og kommentarer'}", x, None),
                (f"/code-review {x.source} mot {x.target}", x,
                 f"/code-review PR !{x.id} ({x.url}): endringene på {x.source} mot {x.target}, "
                 f"merge-base som fast punkt. Rapporter funn, ikke endre koden."),
                ("/pr  skriv PR-beskrivelsen på nytt", x,
                 f"/pr Skriv PR-beskrivelsen til !{x.id} ({x.url}) på nytt ut fra endringene på {x.source} "
                 f"mot {x.target} og work items {', '.join(f'#{i}' for i in sorted(x.items)) or '-'}, "
                 f"og oppdater PR-en i ADO.")]
    if isinstance(x, Review):
        return [(f"/review-pr {x.id}", x, None),
                ("forklar PR-en for meg (ingen kommentarer)", x, explain(x)),
                ("test lokalt: bygg og kjør testene", x,
                 f"Sjekk ut PR !{x.id} ({x.url}), kildebranch {x.source}, i et worktree. Bygg, kjør testene og "
                 f"det som berøres, og rapporter hva som feiler eller oppfører seg rart. Ikke post kommentarer.")]
    out = [(x.prompt, x, None)]
    out += [(f"fiks PR !{m.id}: {'; '.join(m.todo) or 'sjekk bygg og kommentarer'}", m, None) for m in x.prs]
    if x.kind == "map":
        out.append(("oppsummer kartet: gjort, neste, blokkert", x,
                    f"Oppsummer kart #{x.id} «{x.title}» ({x.url}): hva er avgjort og gjort, hva er neste ledige "
                    f"ticket, og hva blokkerer. Bare les — ikke endre noe."))
    elif x.kind == "spec":
        out.append((f"/to-tickets {x.id}", x, f"/to-tickets {x.id}"))
    elif not x.decision:
        skill = "/diagnosing-bugs" if x.type.lower() == "bug" else "/tdd"
        out.append((f"{skill} {x.id}", x, f"{skill} #{x.id} «{x.title}» ({x.url})"))
        if x.prs or x.trees:
            out.append((f"/code-review {x.id}", x,
                        f"/code-review #{x.id}: endringene på branchen for #{x.id} mot målbranchen, merge-base som "
                        f"fast punkt, spec fra work item #{x.id}. Rapporter funn, ikke endre koden."))
    return out


def start_menu(x, agents_):
    """The menu enter opens on a Work/Review/Mine: numbered prompts from starts(), e for my own.
    Asks y/n first when that agent already exists."""
    def ask(r):
        st = agents_.get(r.key)
        return f"{r.key} finnes allerede ({st}) — start ny?" if st else False
    opts = [(str(n), label, lambda r=r, p=p: launch(r, p), ask(r))
            for n, (label, r, p) in enumerate(starts(x)[:9], 1)]
    what = f"#{x.id}" if isinstance(x, Work) else f"!{x.id}"
    return (f"start agent · {what} {x.title[:40]}",
            opts + [("e", "egendefinert prompt …", lambda text: launch(x, f"{about(x)}\n\n{text}"), "edit")])


def about(x):
    """One line naming the row, put before a typed prompt so the agent knows what it's about."""
    if isinstance(x, Work):
        return f"Gjelder {x.type.lower()} #{x.id} «{x.title}» i {x.project} ({x.url})."
    if isinstance(x, Mine):
        return f"Gjelder min PR !{x.id} «{x.title}» i {x.repo}, {x.source} → {x.target} ({x.url})."
    return f"Gjelder PR !{x.id} «{x.title}» av {x.who} i {x.repo}, {x.source} → {x.target} ({x.url})."


def stuck(before, after):
    """Agent names that went blocked (waiting for me) between two {name: state} maps.
    before None = first load: nothing is news yet."""
    if before is None:
        return []
    return [n for n, st in after.items() if st == "blocked" and before.get(n) != "blocked"]


def notify(snap, names, what):
    """macOS notification per agent (what: «venter på deg», «er ferdig»), titled with its item or PR."""
    titles = {x.key: f"{'#' if isinstance(x, Work) else '!'}{x.id} {x.title}"
              for x in snap.items + [t for w in snap.items for t in w.children] + snap.prs + snap.mine}
    for n in names:
        notify_one(f"{n} {what}", titles.get(n, n))


def notify_one(subtitle, text):
    script = ("on run argv\n display notification (item 2 of argv) with title \"fleet\" "
              "subtitle (item 1 of argv) sound name \"Glass\"\nend run")
    subprocess.run(["osascript", "-e", script, subtitle, text], capture_output=True)


def finished(before, after):
    """Agent names that went from working (or waiting for me) to done between two {name: state} maps."""
    if before is None:
        return []
    return [n for n, st in after.items() if st in FINISHED and before.get(n) in BUSY]


def short(path):
    return path.replace(os.path.expanduser("~"), "~", 1)


# ── autopilot ───────────────────────────────────────────────────────────────
# While the TUI runs, new PRs I'm reviewer on get a /code-review agent and my PRs that
# turn red or conflict get a fix agent — on working hours unless allowed for the session.
# Neither posts in ADO: the review only reports; the fix pushes to its branch but doesn't
# answer threads. One fleet at a time runs it (autopilot.lock). Tuned in CONFIG.

CONFIG = os.path.expanduser(os.environ.get("FLEET_CONFIG", "~/.config/fleet/config.toml"))
DEFAULTS = {"autopilot": {"enabled": True, "triggers": ["review", "build", "conflict"], "max_parallel": 2,
                          "backlog_hours": 24, "max_fix_attempts": 2, "hours": "07-17", "weekdays": "mon-fri"},
            "notify": {"start": True, "done": True, "blocked": True}}
DAYS = ("mon", "tue", "wed", "thu", "fri", "sat", "sun")
BUSY = ("running", "working", "blocked")  # agent states that hold one of autopilot's slots
FINISHED = ("done", "idle", "failed", "error")


def workhours(c):
    """(first hour, end hour, {weekday}) from hours = "07-17" and weekdays = "mon-fri" | "mon,wed"."""
    a, _, b = c["hours"].partition("-")
    days = set()
    for part in c["weekdays"].lower().split(","):
        x, _, y = part.strip().partition("-")
        days |= set(range(DAYS.index(x[:3]), DAYS.index((y or x)[:3]) + 1))
    return int(a), int(b), days


def config():
    """(DEFAULTS overlaid with CONFIG, error | ""). Unknown keys and wrong types are ignored."""
    out = {k: dict(v) for k, v in DEFAULTS.items()}
    try:
        with open(CONFIG, "rb") as f:
            got = tomllib.load(f)
    except FileNotFoundError:
        return out, ""
    except (OSError, tomllib.TOMLDecodeError) as e:
        return out, f"{short(CONFIG)}: {e}"
    for sec, vals in out.items():
        vals.update({k: v for k, v in (got.get(sec) or {}).items() if k in vals and type(v) is type(vals[k])})
    try:
        workhours(out["autopilot"])
    except ValueError:
        out["autopilot"].update(hours=DEFAULTS["autopilot"]["hours"], weekdays=DEFAULTS["autopilot"]["weekdays"])
        return out, f"{short(CONFIG)}: hours/weekdays forstås ikke — bruker 07-17 mon-fri"
    return out, ""


def work_age(t, now, days):
    """Hours from t to now, not counting days autopilot is off (weekends): Friday 16:00 is fresh on Monday."""
    h = 0.0
    while t < now:
        nxt = min(now, datetime.datetime.combine(t.date() + datetime.timedelta(days=1), datetime.time(), t.tzinfo))
        if t.weekday() in days:
            h += (nxt - t).total_seconds() / 3600
        t = nxt
    return h


def explain(r):
    """Prompt: explain a PR to me without touching it."""
    return (f"Forklar PR !{r.id} «{r.title}» ({r.url}) av {r.who} for meg: hva endres og hvorfor, hva "
            f"jeg bør se nøye på, og risiko. Bare les — ikke post kommentarer, ikke stem.")


class Auto:
    """The agent autopilot starts for a Review or Mine: the row's own agent name, so its chip and
    `claude agents` show it, with a prompt that posts nothing in ADO. launch() takes it."""
    def __init__(self, x, why=""):
        self.x, self.why, self.key, self.id, self.title = x, why, x.key, x.id, x.title

    def clone(self):
        return clones().get((self.x.project.lower(), self.x.repo.lower()))

    def where(self):
        x = self.x
        if isinstance(x, Mine):
            cwd, wt = where_fix(x)
            if not cwd:
                raise RuntimeError(f"ingen lokal klone av {x.project}/{x.repo}")
            return cwd, wt
        return (self.clone(), f"fleet-review{x.id}") if self.clone() else (HOME, None)

    @property
    def prompt(self):
        x = self.x
        if isinstance(x, Mine):
            return (f"Min PR !{x.id} i {x.repo} ({x.url}): {self.why or '; '.join(x.todo)}. Jobb på kildebranchen "
                    f"{x.source} (`git fetch origin && git switch {x.source}` om du ikke står på den). Løs konflikter "
                    f"ved å merge origin/{x.target} inn — ikke rebase, aldri force-push. Er en konflikt tvetydig, "
                    f"stopp og spør meg. Få bygget grønt, commit og push til {x.source}. Ikke svar i eller resolve "
                    f"review-tråder, ikke stem, ikke complete PR-en.")
        if not self.clone():
            return explain(x)
        return (f"Du står i et nytt worktree for PR !{x.id} «{x.title}» av {x.who} ({x.url}). Kjør "
                f"`git fetch origin {x.source} {x.target}` og `git checkout --detach origin/{x.source}`. Kjør så "
                f"/code-review med origin/{x.target} som fast punkt; spec er work itemene PR-en lenker (hent dem "
                f"fra ADO). Finnes ingen spec, hopp over Spec-aksen — ikke spør. Bare rapporter her: ikke post "
                f"kommentarer, ikke stem, ikke push.")


class Pilot:
    """Autopilot for one TUI. What must survive a restart — muted rows, what it started (one
    fingerprint per review, per PR commit for fixes), when it first saw an event, why a start
    failed — is in autopilot.json and forgotten when the row leaves the list. On/off and
    «also outside working hours» last for the session."""
    PATH = os.path.join(OUT, "autopilot.json")
    LISTS = ("muted", "gaveup")
    MAPS = ("started", "seen", "failed")

    def __init__(self, on=True):
        self.cfg, self.error = config()
        self.c = self.cfg["autopilot"]
        self.on = on and self.c["enabled"]
        self.after = False  # also outside working hours, this session
        self.queue = []  # keys waiting for a slot or working hours, in start order
        self.pending = {}  # key: when launched, until `claude agents` lists it
        self.lock = None
        os.makedirs(OUT, exist_ok=True)
        f = open(os.path.join(OUT, "autopilot.lock"), "w")
        try:
            fcntl.flock(f, fcntl.LOCK_EX | fcntl.LOCK_NB)
            self.lock = f
        except OSError:
            f.close()

    def load(self):
        try:
            with open(self.PATH) as f:
                st = json.load(f)
        except (OSError, ValueError):
            st = {}
        return {k: list(st.get(k) or []) for k in self.LISTS} | {k: dict(st.get(k) or {}) for k in self.MAPS}

    def save(self, st):
        tmp = f"{self.PATH}.{os.getpid()}"
        with open(tmp, "w") as f:
            json.dump(st, f, indent=2)
        os.replace(tmp, self.PATH)

    def open_(self, now=None):
        """Inside working hours, or allowed outside them."""
        now = now or datetime.datetime.now()
        a, b, days = workhours(self.c)
        return self.after or (now.weekday() in days and a <= now.hour < b)

    def opens(self):
        """When working hours start next, as «07:00» today or «man 07:00»."""
        a, _, days = workhours(self.c)
        now = datetime.datetime.now()
        for n in range(8):
            d = now + datetime.timedelta(days=n)
            at = d.replace(hour=a, minute=0, second=0, microsecond=0)
            if d.weekday() in days and at > now:
                return at.strftime("%H:%M") if n == 0 else f"{('man', 'tir', 'ons', 'tor', 'fre', 'lør', 'søn')[at.weekday()]} {at:%H:%M}"
        return "?"

    def trigger(self, x):
        """(why, fingerprint, when it happened | None) when autopilot would start on x, else None."""
        trig = self.c["triggers"]
        if isinstance(x, Review):
            if "review" not in trig or not x.asked or x.vote:
                return None
            return "review", f"{x.key}@review", x.created
        if x.pr.draft:
            return None
        fails = x.failing if "build" in trig else []
        why = (["merge-konflikter"] if "conflict" in trig and x.pr.conflicts else []) + [f"{n} feiler" for n in fails]
        if not why:
            return None
        commit = ((x.pr.raw.get("lastMergeSourceCommit") or {}).get("commitId") or "")[:10]
        at = max((x.pr.done_at[n] for n in fails if x.pr.done_at.get(n)), default=None)
        return "; ".join(why), f"{x.key}@{commit}", at

    def busy(self, agents_):
        now = time.time()
        self.pending = {k: t for k, t in self.pending.items() if k not in agents_ and now - t < 120}
        return sum(1 for st in agents_.values() if st in BUSY) + len(self.pending)

    def start(self, x, st, why, fp, notify_=True):
        try:
            line = launch(Auto(x, why))
        except RuntimeError as e:
            st["failed"][x.key] = str(e)[:60]
            line = f"🤖 {x.key} feilet: {e}"
        else:
            st["failed"].pop(x.key, None)
            self.pending[x.key] = time.time()
            line = "🤖 " + line
            if notify_ and self.cfg["notify"]["start"]:
                notify_one(f"🤖 startet {x.key}", f"!{x.id} {x.title}")
        st["started"].setdefault(x.key, []).append(fp)
        return line

    def tick(self, s):
        """Start what's due on the snapshot. Sets s.auto (row chips), s.autohead and s.news."""
        if not self.lock:
            s.autohead = "🤖 autopilot kjører i en annen fleet"
            return
        if not s.at or s.error:
            return
        st = self.load()
        live = {r.key: r for r in s.prs if r.asked} | {m.key: m for m in s.mine}
        for k in self.LISTS:
            st[k] = [x for x in st[k] if x in live]
        for k in self.MAPS:
            st[k] = {x: v for x, v in st[k].items() if x.split("@")[0] in live}
        now, local = time.time(), datetime.datetime.now().astimezone()
        _, _, days = workhours(self.c)
        due, chips = [], {k: ("🔕 auto av", "dim") for k in st["muted"]}
        for x in live.values():
            if x.key in st["failed"]:
                chips[x.key] = (f"🤖 feilet: {st['failed'][x.key]}", "red")
            elif x.key in st["started"]:
                chips[x.key] = ("🤖 auto", "cyan")
            t = self.trigger(x)
            if not t:
                continue
            why, fp, at = t
            seen = st["seen"].setdefault(fp, now)
            agent = s.agents.get(x.key)
            tries = st["started"].get(x.key, [])
            if x.key in st["muted"] or fp in tries or agent in BUSY or x.key in self.pending:
                continue
            if agent and not tries:  # I started that one myself
                continue
            if len(tries) >= (1 if isinstance(x, Review) else self.c["max_fix_attempts"]):
                chips[x.key] = ("🤖 ga opp", "red")
                if x.key not in st["gaveup"]:
                    st["gaveup"].append(x.key)
                    s.news.append(f"🤖 ga opp {x.key} etter {len(tries)} forsøk: {why}")
                    if self.cfg["notify"]["start"] or self.cfg["notify"]["done"]:
                        notify_one(f"🤖 ga opp {x.key}", f"!{x.id} {x.title} — {why}")
                continue
            when = (at or datetime.datetime.fromtimestamp(seen, datetime.timezone.utc)).astimezone()
            if work_age(when, local, days) > self.c["backlog_hours"]:
                continue
            due.append((isinstance(x, Review), when, x, why, fp))
        due.sort(key=lambda d: d[:2])  # fixes first, oldest first
        free = self.c["max_parallel"] - self.busy(s.agents)
        self.queue = []
        for _, _, x, why, fp in due:
            if not self.on:
                break
            if not self.open_() or free <= 0:
                self.queue.append(x.key)
                chips[x.key] = (f"⏳ venter til {self.opens()}" if not self.open_() else "⏳ i kø", "dim")
                continue
            line = self.start(x, st, why, fp)
            s.news.append(line)
            chips[x.key] = (f"🤖 feilet: {st['failed'][x.key]}", "red") if x.key in st["failed"] else ("🤖 auto", "cyan")
            free -= 0 if x.key in st["failed"] else 1
        self.save(st)
        s.auto = chips
        s.autohead = self.header(s.agents)

    def header(self, agents_):
        if not self.lock:
            return "🤖 autopilot kjører i en annen fleet"
        if not self.on:
            return "🤖 autopilot av"
        q = f" · {len(self.queue)} i kø" if self.queue else ""
        if not self.open_():
            return f"🤖 autopilot pause til {self.opens()}{q}"
        return (f"🤖 autopilot på · {self.busy(agents_)}/{self.c['max_parallel']} kjører{q}"
                + (" · også utenfor arbeidstid" if self.after else ""))

    def toggle(self):
        self.on = not self.on
        return f"🤖 autopilot {'på' if self.on else 'av'} (denne økta)"

    def allow(self):
        self.after = not self.after
        return f"🤖 {'kjører også' if self.after else 'kjører ikke'} utenfor arbeidstid (denne økta)"

    def mute(self, x):
        st = self.load()
        if x.key in st["muted"]:
            st["muted"].remove(x.key)
            line = f"🤖 autopilot på igjen for {x.key}"
        else:
            st["muted"].append(x.key)
            line = f"🔕 autopilot av for {x.key} til den er borte fra lista"
        self.save(st)
        return line

    def now(self, x):
        """«Kjør auto nå»: start the row's autopilot agent regardless of hours, slots and mute."""
        st = self.load()
        t = self.trigger(x)
        if not t and isinstance(x, Mine):
            raise RuntimeError(f"!{x.id}: ingen konflikt eller rødt bygg å fikse")
        why, fp, _ = t or ("review", f"{x.key}@review", None)
        line = self.start(x, st, why, f"{fp}#{int(time.time())}", notify_=False)
        self.save(st)
        if x.key in st["failed"]:
            raise RuntimeError(line)
        return line


def pilot_menu(p):
    if not p.lock:
        raise RuntimeError("autopilot kjører i en annen fleet")
    return (p.header({}), [
        ("a", "slå av (denne økta)" if p.on else "slå på", p.toggle, False),
        ("u", "ikke utenfor arbeidstid" if p.after else "tillat utenfor arbeidstid (denne økta)", p.allow,
         False if p.after else "autopilot også utenfor arbeidstid denne økta?")])


def pilot_options(p, x):
    """The row menu's autopilot entries for a Review or Mine."""
    if not p or not p.lock or not isinstance(x, (Review, Mine)):
        return []
    muted = x.key in p.load()["muted"]
    return [("z", "slå på autopilot igjen" if muted else "demp autopilot for raden", lambda: p.mute(x), False),
            ("n", "kjør auto nå", lambda: p.now(x), f"start autopilot-agent på {x.key} nå?")]


# ── actions ─────────────────────────────────────────────────────────────────
# What the `m` menu offers, and `fleet pr` / `fleet wi` run. Each returns a one-line
# result and raises RuntimeError with ADO's message.


def fresh(r):
    """The PR as ADO has it now (policies and merge commit change under us)."""
    return wr.PR(rest(f"git/pullrequests/{r.id}", scope="org"))


def approve(r):
    p = r.pr
    rest(f"git/repositories/{p.raw['repository']['id']}/pullrequests/{p.id}/reviewers/{me()[0]}",
         {"vote": 10}, method="PUT", project=p.project)
    return f"✓ godkjent !{p.id}"


def auto_complete(r):
    return wr.complete(fresh(r), "auto")


def complete_now(r):
    return wr.complete(fresh(r), "now")


def abandon(r):
    return wr.abandon(fresh(r))


def patch_item(w, ops):
    url = f"{A().org}/{urllib.parse.quote(w.project)}/_apis/wit/workitems/{w.id}?api-version=7.1"
    req = urllib.request.Request(url, data=json.dumps(ops).encode(), method="PATCH",
                                 headers={"Authorization": f"Bearer {A().token()}",
                                          "Content-Type": "application/json-patch+json"})
    try:
        with urllib.request.urlopen(req, timeout=30) as resp:
            return json.load(resp)
    except urllib.error.HTTPError as e:
        try:
            m = json.loads(e.read().decode("utf-8-sig")).get("message")
        except ValueError:
            m = None
        raise RuntimeError(m or f"HTTP {e.code}")
    except urllib.error.URLError as e:
        raise RuntimeError(str(e.reason))


_states = {}


def states(w):
    """The work item type's states, in the process's order."""
    k = (w.project, w.type)
    if k not in _states:
        _states[k] = [x["name"] for x in rest(f"wit/workitemtypes/{urllib.parse.quote(w.type)}/states",
                                              project=w.project)["value"]]
    return _states[k]


def set_state(w, state):
    if state not in states(w):
        raise RuntimeError(f"{w.type} har ikke state «{state}» — {', '.join(states(w))}")
    patch_item(w, [{"op": "add", "path": "/fields/System.State", "value": state}])
    return f"✓ #{w.id} → {state}"


_sprints = {}


def sprint(project):
    """(name, path) of the project's default team's current iteration."""
    if project not in _sprints:
        team = rest(f"projects/{urllib.parse.quote(project)}", scope="org").get("defaultTeam", {}).get("name") \
            or f"{project} Team"
        cur = rest("work/teamsettings/iterations?$timeframe=current", project=f"{project}/{team}")["value"]
        if not cur:
            raise RuntimeError(f"{team} har ingen nåværende sprint")
        _sprints[project] = (cur[0]["name"], cur[0]["path"])
    return _sprints[project]


def set_sprint(w):
    name, path = sprint(w.project)
    patch_item(w, [{"op": "add", "path": "/fields/System.IterationPath", "value": path}])
    return f"✓ #{w.id} → {name}"


def menu(x, pilot=None):
    """(title, [(key, label, action | submenu-builder, confirm?)]) for the row's `m` menu.
    An action returns its result line; a builder (marked by confirm "sub") returns a menu."""
    if isinstance(x, Cleanup):
        what = "ulagrede endringer og ikke-pushede commits går tapt" if x.reasons else "fjernes"
        return (f"#{x.id} {os.path.basename(x.tree.path)}", [
            ("f", "rydd likevel (force)", lambda: remove(x, sessions(), force=True),
             f"fjern {short(x.tree.path)} med makt? {what} ({', '.join(x.reasons)})"),
            ("v", "VS Code i worktreet", lambda: open_code(x.tree.main, x.tree.path), False),
            *([("o", "åpne work item", lambda: subprocess.run(["open", x.url]) and "", False)] if x.url else [])])
    if isinstance(x, Orphan):
        return (f"{x.name} ({x.state})", [
            ("x", "fjern sesjonen (stop + rm)", lambda: end(x),
             False if x.finished else f"{x.name} er {x.state} — stopp og fjern?"),
            *([("s", "stopp", lambda: stop(x), False)] if not x.finished else [])])
    if isinstance(x, Mine):
        return (f"!{x.id} {x.title[:50]}", [
            ("f", "start fix-agent", lambda: launch(x), False),
            ("u", "sett auto-complete", lambda: auto_complete(x), False),
            ("c", "complete nå", lambda: complete_now(x), f"complete !{x.id} {x.title[:40]} → {x.target}?"),
            ("x", "abandon", lambda: abandon(x), f"abandon !{x.id} {x.title[:40]}?"),
            *pilot_options(pilot, x),
            ("o", "åpne i nettleser", lambda: subprocess.run(["open", x.url]) and "", False)])
    if isinstance(x, Review):
        return (f"!{x.id} {x.title[:50]}", [
            ("a", "approve", lambda: approve(x), False),
            ("u", "sett auto-complete", lambda: auto_complete(x), False),
            ("c", "complete nå", lambda: complete_now(x), f"complete !{x.id} {x.title[:40]} → {x.target}?"),
            ("x", "abandon", lambda: abandon(x), f"abandon !{x.id} {x.title[:40]}?"),
            ("g", "start review-agent", lambda: launch(x), False),
            *pilot_options(pilot, x),
            ("o", "åpne i nettleser", lambda: subprocess.run(["open", x.url]) and "", False)])
    return (f"#{x.id} {x.title[:50]}", [
        ("s", f"endre status ({x.state})", lambda: status_menu(x), "sub"),
        ("i", "sett nåværende sprint", lambda: set_sprint(x), False),
        ("g", f"start agent ({x.skill})", lambda: launch(x), False),
        *code_option(x),
        ("o", "åpne i nettleser", lambda: subprocess.run(["open", x.url]) and "", False)])


def status_menu(w):
    return (f"#{w.id} status", [(str(n), st + ("  (nå)" if st == w.state else ""),
                                 lambda st=st: set_state(w, st), False)
                                for n, st in enumerate(states(w)[:9], 1)])


# ── rendering ───────────────────────────────────────────────────────────────

AGENT = {"running": ("▶", "cyan"), "working": ("▶", "cyan"), "blocked": ("⏸", "yellow"),
         "done": ("✓", "green"), "idle": ("✓", "green"), "failed": ("✗", "red"), "error": ("✗", "red")}
VOTE = {-10: ("✗", "red"), -5: ("⏸", "yellow"), 0: ("○", "dim")}
KIND = {"map": ("kart", "cyan"), "spec": ("spec", "green")}
STATUS = {"ledig": "green", "tatt": "yellow", "blokkert": "red"}


def agent_chip(snap, x):
    st = snap.agents.get(x.key)
    if not st:
        return []
    icon, tone = AGENT.get(st, ("●", "dim"))
    return [(f"  {icon} agent {st}", tone)]


def auto_chip(snap, x):
    c = snap.auto.get(x.key)
    return [(f"  {c[0]}", c[1])] if c else []


def mine_status(m):
    """(icon, tone, [(chip, tone)]) — worst first."""
    chips = []
    if m.pr.conflicts:
        chips.append(("konflikt", "red"))
    chips += [(f"{n} ✗", "red") for n in m.failing]
    chips += [(f"@{n} {'✗' if v == -10 else '⏸'}", "red" if v == -10 else "yellow") for n, v in m.votes]
    if m.threads:
        chips.append((f"💬 {m.threads}", "yellow"))
    waiting = [n for n, st, b in m.pr.policies if b and st in ("queued", "running")]
    chips += [(f"{n} …", "dim") for n in waiting]
    if m.pr.draft:
        chips.append(("draft", "dim"))
    if m.pr.auto:
        chips.append(("auto", "cyan"))
    tones = [t for _, t in chips]
    if "red" in tones:
        return "✗", "red", chips
    if "yellow" in tones:
        return "⏸", "yellow", chips
    if m.pr.ready:
        return "✓", "green", chips + [("klar", "green")]
    return "○", "dim", chips


def pr_chip(w):
    """My PR(s) for a work item: «↳ !1234 ✗»."""
    out = []
    for m in w.prs[:2]:
        icon, tone, _ = mine_status(m)
        out.append((f"  ↳ !{m.id} {icon}", tone))
    return out


def tree_chip(w):
    if not w.trees:
        return []
    name = os.path.basename(w.trees[0][1]) + (f" +{len(w.trees) - 1}" if len(w.trees) > 1 else "")
    return [(f"  ⎇ {name}", "cyan")]


def work_row(snap, w, multi, folded):
    label, tone = KIND.get(w.kind, (w.type.lower()[:5], "dim"))
    parts = [("● " if w.state == "Doing" else "○ ", "yellow" if w.state == "Doing" else "dim"),
             (f"#{w.id:<5} ", "dim"), (f"{label:<5} ", tone)]
    if multi:
        parts.append((f"{w.project[:12]:<12}  ", "dim"))
    if w.folds:
        parts.append(("▸ " if folded else "▾ ", "cyan"))
    parts += [(w.title[:70], "bold"), (f"  {w.state}", "dim")]
    if w.folds:
        parts.append((f"  {len(w.children)} åpne, {w.done_children} done", "dim"))
    parts.append((f"  → {w.skill}", "dim"))
    return parts + pr_chip(w) + tree_chip(w) + agent_chip(snap, w)


def child_row(snap, t, last, pad):
    kind = t.it.kind or t.type.lower()[:5]
    who = f" @{t.it.assignee.split('@')[0]}" if t.it.assignee else ""
    parts = [(" " * pad + ("└ " if last else "├ "), "dim"), (f"#{t.id:<5} ", "dim"), (f"{kind:<9} ", "cyan"),
             (f"{t.status:<8} ", STATUS.get(t.status, "dim")), (t.title[:70], None), (who, "dim")]
    if t.it.hitl:
        parts.append(("  HITL", "red"))
    parts.append((f"  → {t.skill}", "dim"))
    return parts + pr_chip(t) + tree_chip(t) + agent_chip(snap, t)


def pr_row(snap, r, wrepo):
    icon, tone = VOTE.get(r.vote, ("○", "dim"))
    parts = [(icon + " ", tone), (f"!{r.id:<5} ", "dim"), (f"{r.repo:<{wrepo}}  ", "bold"),
             (r.title[:60], None), (f"  @{r.who} {ago(r.created)}", "dim")]
    if not r.asked:
        parts.append(("  (ikke reviewer)", "dim"))
    return parts + agent_chip(snap, r) + auto_chip(snap, r)


def mine_row(snap, m, wrepo):
    icon, tone, chips = mine_status(m)
    parts = [(icon + " ", tone), (f"!{m.id:<5} ", "dim"), (f"{m.repo:<{wrepo}}  ", "bold"),
             (m.title[:60], None), (f"  {ago(m.created)}", "dim")]
    for c, t in chips:
        parts.append((f"  {c}", t))
    return parts + agent_chip(snap, m) + auto_chip(snap, m)


def orphan_row(o):
    icon, tone = AGENT.get(o.state, ("●", "dim"))
    return [(f"{icon} ", tone), (f"{o.name:<16} ", "bold"), (f"{o.state:<8} ", tone),
            (f"{ago(o.started):>4} siden  ", "dim"), (short(o.cwd), "dim")]


def lines(snap, everyone, open_=()):
    """[(parts, Work | Review | None)] — everything the list shows, in order. Maps in
    open_ (ids) show their open tickets under them."""
    out = []
    multi = len({w.project for w in snap.items}) > 1
    out.append(([(f"Work items · To Do/Doing ({len(snap.items)})", "bold")], None))
    for w in snap.items:
        folded = w.id not in open_
        out.append((work_row(snap, w, multi, folded), w))
        if w.folds and not folded:
            pad = 29 if multi else 15
            for n, t in enumerate(w.children):
                out.append((child_row(snap, t, n == len(w.children) - 1, pad), t))
            if not w.children:
                out.append(([(" " * pad + "└ ingen åpne tickets", "dim")], None))
    if not snap.items:
        out.append(([("  ingen", "dim")], None))
    if snap.old and snap.old.n:
        out.append(([(f"… {snap.old.title} (eldre enn {OLD} dager)", "dim"), ("  → åpne query", "dim")], snap.old))
    out.append(([], None))
    who = "alle andres" if everyone else "der jeg er reviewer"
    out.append(([(f"PRer uten min godkjenning · {who} ({len(snap.prs)})", "bold")], None))
    wrepo = max([len(r.repo) for r in snap.prs] + [4])
    for r in snap.prs:
        out.append((pr_row(snap, r, wrepo), r))
    if not snap.prs:
        out.append(([("  ingen", "dim")], None))
    if snap.mine:
        out.append(([], None))
        out.append(([(f"Mine PRer ({len(snap.mine)})", "bold")], None))
        wmine = max([len(m.repo) for m in snap.mine] + [4])
        for m in snap.mine:
            out.append((mine_row(snap, m, wmine), m))
    if snap.orphans:
        out.append(([], None))
        out.append(([(f"Foreldreløse agenter · elementet er borte fra lista ({len(snap.orphans)})", "bold")], None))
        for o in snap.orphans:
            out.append((orphan_row(o), o))
    if snap.cleanup:
        out.append(([], None))
        out.append(([(f"Opprydding · worktrees for Done work items ({len(snap.cleanup)})", "bold")], None))
        for c in snap.cleanup:
            where_ = f"{os.path.basename(c.tree.main)}/…/{os.path.basename(c.tree.path)}"
            why = ", ".join(c.reasons) or "trygt å fjerne"
            out.append(([("🧹 ", None), (f"{'#' if c.items else '!'}{c.id:<5} ", "dim"), (c.title[:50], None),
                         (f"  ⎇ {where_}", "cyan"), (f"  — {why}", "yellow" if c.reasons else "dim")], c))
    return out


def plain(parts):
    return "".join(s for s, _ in parts)


PAINT = {"green": green, "red": red, "yellow": yellow, "cyan": cyan, "dim": dim, "bold": bold}


# ── state file ──────────────────────────────────────────────────────────────


def work_json(snap, w):
    out = {"id": w.id, "title": w.title, "state": w.state, "type": w.type, "kind": w.kind,
           "project": w.project, "url": w.url, "prompt": w.prompt, "agent": w.key,
           "agentState": snap.agents.get(w.key), "start": f"fleet go {w.id}",
           "worktrees": [t for _, t in w.trees], "myPrs": [m.id for m in w.prs]}
    if w.trees:
        out["openInCode"] = f"fleet code {w.id}"
    if w.parent:
        out.update(ticketType=w.it.kind, status=w.status, assignee=w.it.assignee, hitl=w.it.hitl)
    if w.folds:
        out.update(doneTickets=w.done_children, tickets=[work_json(snap, t) for t in w.children])
    return out


def write_state(snap, everyone, open_=(), cur=None, msg=""):
    """screen.txt: the list as text. state.json: the same, structured (maps with all their
    open tickets, folded or not), plus how to act."""
    os.makedirs(OUT, exist_ok=True)
    now = datetime.datetime.now().astimezone().isoformat(timespec="seconds")
    screen = [f"fleet · {now} · data fra {datetime.datetime.fromtimestamp(snap.at).strftime('%H:%M:%S')}"
              if snap.at else f"fleet · {now} · henter …"]
    if snap.error:
        screen.append(f"FEIL: {snap.error}")
    for parts, x in lines(snap, everyone, open_):
        screen.append(("> " if x is not None and x is cur else "  ") + plain(parts))
    if msg:
        screen += ["", msg]
    screen += ["", "Handlinger: `fleet go <wi>` · `fleet review <pr>` · `fleet pr <pr> approve|auto|complete|abandon`"
               " · `fleet wi <wi> state <S>|sprint` · `fleet fix <pr>` · `fleet prune` · `claude agents --json --all`"]
    state = {
        "updated": now, "dataAt": snap.at, "error": snap.error or None, "message": msg or None,
        "allPrs": everyone, "selected": cur.key if cur else None, "unfoldedMaps": sorted(open_),
        "workItems": [work_json(snap, w) for w in snap.items],
        "oldWorkItems": {"count": snap.old.n, "query": snap.old.url} if snap.old else None,
        "pullRequests": [{"id": r.id, "title": r.title, "project": r.project, "repo": r.repo,
                          "author": r.who, "source": r.source, "target": r.target, "url": r.url,
                          "imReviewer": r.asked, "myVote": r.vote, "agent": r.key,
                          "agentState": snap.agents.get(r.key), "start": f"fleet review {r.id}"}
                         for r in snap.prs],
        "myPullRequests": [{"id": m.id, "title": m.title, "project": m.project, "repo": m.repo,
                            "source": m.source, "target": m.target, "url": m.url, "draft": m.pr.draft,
                            "autoComplete": m.pr.auto, "ready": m.pr.ready, "conflicts": m.pr.conflicts,
                            "policies": [{"name": n, "status": st, "blocking": b} for n, st, b in m.pr.policies],
                            "negativeVotes": dict(m.votes), "activeThreads": m.threads,
                            "workItems": sorted(m.items), "todo": m.todo, "agent": m.key,
                            "agentState": snap.agents.get(m.key), "start": f"fleet fix {m.id}"}
                           for m in snap.mine],
        "orphanAgents": [{"name": o.name, "id": o.sid, "state": o.state, "cwd": o.cwd,
                          "remove": f"fleet prune --id {o.sid}"} for o in snap.orphans],
        "agents": snap.agents,
        "cleanup": [{"workItems": [i.id for i in c.items], "title": c.title, "worktree": c.tree.path,
                     "branch": c.tree.branch, "blockedBy": c.reasons, "mergedPr": (c.pr or {}).get("pullRequestId"),
                     "force": f"fleet clean --force {c.tree.path}"} for c in snap.cleanup],
        "cleanedThisRefresh": snap.cleaned, "cleanupLog": LOG,
        "autopilot": {"status": snap.autohead or None, "rows": {k: c for k, (c, _) in snap.auto.items()},
                      "config": CONFIG, "state": Pilot.PATH},
    }
    for name, body in (("screen.txt", "\n".join(screen) + "\n"),
                       ("state.json", json.dumps(state, indent=2, ensure_ascii=False) + "\n")):
        tmp = os.path.join(OUT, f".{name}.{os.getpid()}")
        with open(tmp, "w") as f:
            f.write(body)
        os.replace(tmp, os.path.join(OUT, name))


# ── ghostty ─────────────────────────────────────────────────────────────────

SPLIT = """
on run argv
  tell application "Ghostty"
    set t to selected tab of front window
    repeat with x in terminals of t
      if (id of x as text) is item 3 of argv then return "skip"
    end repeat
    set me_ to focused terminal of t
    set cfg to {initial working directory:item 1 of argv, initial input:item 2 of argv & linefeed}
    set pane to split me_ direction left with configuration cfg
    focus me_
    return id of pane as text
  end tell
end run
"""


def split_agents_pane():
    """In Ghostty, open `claude agents` in a split to the left — unless this tab still has
    the one fleet opened last time."""
    if os.environ.get("TERM_PROGRAM") != "ghostty":
        return
    path = os.path.join(OUT, "pane")
    try:
        with open(path) as f:
            last = f.read().strip()
    except OSError:
        last = ""
    r = subprocess.run(["osascript", "-", HOME, AGENTS, last or "-"], input=SPLIT,
                       capture_output=True, text=True)
    pane = r.stdout.strip()
    if r.returncode == 0 and pane and pane != "skip":
        os.makedirs(OUT, exist_ok=True)
        with open(path, "w") as f:
            f.write(pane + "\n")


def keep_awake():
    """Keep the Mac from idle-sleeping while fleet runs, so agents keep working; the display
    may still sleep and the screensaver start. caffeinate exits with fleet (-w)."""
    if shutil.which("caffeinate"):
        subprocess.Popen(["caffeinate", "-i", "-w", str(os.getpid())],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


# ── tui ─────────────────────────────────────────────────────────────────────


def tui(scr, a):
    curses.curs_set(0)
    curses.use_default_colors()
    pal = {}
    for i, (name, col) in enumerate([("green", curses.COLOR_GREEN), ("red", curses.COLOR_RED),
                                     ("yellow", curses.COLOR_YELLOW), ("cyan", curses.COLOR_CYAN)], 1):
        curses.init_pair(i, col, -1)
        pal[name] = curses.color_pair(i)
    pal.update(dim=curses.A_DIM, bold=curses.A_BOLD)

    def put(y, x, txt, n, attr=0):
        # newlines in msg/errors and writes at the screen edge make curses return ERR
        if n <= 0:
            return
        try:
            scr.addnstr(y, x, re.sub(r"[\x00-\x1f\x7f]", " ", txt), n, attr)
        except curses.error:
            pass

    snap = Snapshot()
    lock, wake = threading.Lock(), threading.Event()
    sel, top, msg, err, written, shown = 0, 0, "", False, 0.0, None
    open_, key = set(), None  # unfolded map ids; key of the selected row, kept across refreshes
    ask = None  # (question, action) awaiting y
    pop = None  # open menu: (title, options), see menu()
    edit = None  # prompt being typed: [label, text, launch(text), confirm question | False]
    loading = True
    pilot = Pilot(on=not a.no_autopilot)
    if pilot.error:
        msg, err = pilot.error, True

    def loader():
        nonlocal snap, loading
        while True:
            loading = True
            s = snapshot(a.all, clean=not a.no_clean)
            pilot.tick(s)
            with lock:
                snap = s
            loading = False
            wake.wait(REFRESH)
            wake.clear()

    threading.Thread(target=loader, daemon=True).start()
    scr.timeout(500)

    def act(fn):
        nonlocal msg, err
        try:
            msg = fn() or ""
        except RuntimeError as e:
            msg, err = str(e), True
        wake.set()

    seen = None  # agent states at the last snapshot, for notifications
    while True:
        with lock:
            s = snap
        if s.at and s.agents is not seen:
            done_ = finished(seen, s.agents)
            if done_ and not a.quiet and pilot.cfg["notify"]["done"]:
                notify(s, done_, "er ferdig")
            names = stuck(seen, s.agents)
            if names:
                if not a.quiet and pilot.cfg["notify"]["blocked"]:
                    notify(s, names, "venter på deg")
                msg = f"⏸ venter på deg: {', '.join(names)}"
            if s.cleaned or s.news:
                msg = " · ".join(s.news + s.cleaned)
            seen = s.agents
        ls = lines(s, a.all, open_)
        rows = [x for _, x in ls if x is not None]
        keys_ = [x.key for x in rows]
        sel = keys_.index(key) if key in keys_ else max(0, min(sel, len(rows) - 1))
        cur = rows[sel] if rows else None
        key = cur.key if cur else None
        if time.time() - written >= WRITE or (s.at, key, msg, a.all, tuple(sorted(open_))) != shown:
            write_state(s, a.all, open_, cur, msg)
            written, shown = time.time(), (s.at, key, msg, a.all, tuple(sorted(open_)))

        h, w = scr.getmaxyx()
        scr.erase()
        title = f" fleet · {A().org.rsplit('/', 1)[-1]} " + (f"· {s.autohead} " if s.autohead else "") \
            + ("· henter … " if loading else "")
        put(0, 0, title, w - 1, curses.A_BOLD)
        if s.error:
            put(0, len(title), s.error, max(0, w - 1 - len(title)), pal["red"])
        at = next((y for y, (_, x) in enumerate(ls) if x is cur), 0)
        body = h - 3
        top = min(max(top, at - body + 1), at)
        if sel == 0:
            top = 0
        for y, (parts, it) in enumerate(ls[top:top + body]):
            x, row = 0, y + 1
            hl = curses.A_REVERSE if it is not None and it is cur else 0
            for txt, t in parts:
                if x >= w - 1:
                    break
                put(row, x, txt, w - 1 - x, pal.get(t, 0) | hl)
                x += len(txt)
            if hl and x < w - 1:
                put(row, x, " " * (w - 1 - x), w - 1 - x, hl)
        if pop:
            title_, opts = pop
            bw = min(w - 2, max([len(title_) + 4] + [len(l) + 8 for _, l, _, _ in opts]))
            by, bx = max(1, h - 3 - len(opts) - 2), max(0, w - bw - 2)
            fit = lambda t, n: t if len(t) <= n else t[:n - 1] + "…"
            for n, line_ in enumerate([f"┌ {fit(title_, bw - 4)} ".ljust(bw - 1, "─") + "┐"]
                                      + [f"│  {k}  {fit(l, bw - 8)}".ljust(bw - 1) + "│" for k, l, _, _ in opts]
                                      + ["└" + "─" * (bw - 2) + "┘"]):
                put(by + n, bx, line_, w - 1 - bx, pal["cyan"] if n in (0, len(opts) + 1) else 0)
            for n, (k_, _, _, _) in enumerate(opts, 1):
                put(by + n, bx + 3, k_, 1, pal["yellow"] | curses.A_BOLD)
        keys = f"↑↓ flytt · m valg · enter start agent · →/← fold ut/inn kart/spec · o åpne · a {'mine' if a.all else 'alle'} PRer · A autopilot · r oppdater · q avslutt" \
               f"  ·  {short(OUT)}/screen.txt"
        if edit:
            put(h - 1, 0, f"{edit[0]}: {edit[1]}"[-(w - 2):] + "█", w - 1, pal["cyan"] | curses.A_BOLD)
        elif ask:
            put(h - 1, 0, ask[0] + "  y/n", w - 1, pal["yellow"] | curses.A_BOLD)
        else:
            put(h - 1, 0, msg or keys, w - 1, (pal["red"] if err else pal["green"]) if msg else pal["dim"])
        scr.refresh()

        if edit:
            try:
                c = scr.get_wch()
            except curses.error:
                continue
            if c in ("\n", "\r", curses.KEY_ENTER):
                (_, text, fn, confirm), edit = edit, None
                if text.strip():
                    if confirm:
                        ask = (confirm, lambda: fn(text.strip()))
                    else:
                        act(lambda: fn(text.strip()))
            elif c == "\x1b":
                edit = None
            elif c in (curses.KEY_BACKSPACE, "\x7f", "\b"):
                edit[1] = edit[1][:-1]
            elif c == "\x15":  # ctrl-u
                edit[1] = ""
            elif c == "\x17":  # ctrl-w
                edit[1] = re.sub(r"\S*$", "", edit[1].rstrip())
            elif isinstance(c, str) and c.isprintable():
                edit[1] += c
            continue
        k = scr.getch()
        if k != -1:
            msg, err = "", False
        if ask:
            if k == -1:
                continue
            _, fn = ask
            ask = None
            if k in (ord("y"), ord("Y"), ord("j")):
                act(fn)
            continue
        if pop:
            if k == -1:
                continue
            hit = next((o for o in pop[1] if k == ord(o[0])), None)
            pop = None
            if not hit:
                continue
            _, _, fn, confirm = hit
            if confirm == "sub":
                try:
                    pop = fn()
                except RuntimeError as e:
                    msg, err = str(e), True
            elif confirm == "edit":
                st = s.agents.get(cur.key)
                edit = ["prompt", "", fn, f"{cur.key} finnes allerede ({st}) — start ny?" if st else False]
            elif confirm:
                ask = (confirm, fn)
            else:
                act(fn)
            continue
        moved = sel
        if k in (ord("q"), 27):
            return
        elif k in (curses.KEY_DOWN, ord("j")):
            sel += 1
        elif k in (curses.KEY_UP, ord("k")):
            sel -= 1
        elif k in (curses.KEY_NPAGE, 4):
            sel += body // 2
        elif k in (curses.KEY_PPAGE, 21):
            sel -= body // 2
        elif k in (ord("g"), curses.KEY_HOME):
            sel = 0
        elif k in (ord("G"), curses.KEY_END):
            sel = len(rows) - 1
        elif k == ord("a"):
            a.all = not a.all
            wake.set()
        elif k == ord("r"):
            wake.set()
        elif k == ord("A"):
            try:
                pop = pilot_menu(pilot)
            except RuntimeError as e:
                msg, err = str(e), True
        elif not cur:
            continue
        elif k in (curses.KEY_RIGHT, ord("l"), ord(" ")) and isinstance(cur, Work) and cur.folds:
            open_ ^= {cur.id} if k == ord(" ") else {cur.id} - open_
        elif k in (curses.KEY_LEFT, ord("h")) and isinstance(cur, Work) and (cur.folds or cur.parent):
            m = cur if cur.folds and cur.id in open_ else cur.parent or cur
            open_.discard(m.id)
            key = m.key
        elif k == ord("o") and cur.url:
            subprocess.run(["open", cur.url])
        elif k == ord("v") and isinstance(cur, Work) and cur.trees:
            opt = code_option(cur)[0]
            if opt[3] == "sub":
                pop = opt[2]()
            else:
                act(opt[2])
        elif isinstance(cur, Old):
            if k in (10, 13, curses.KEY_ENTER):
                subprocess.run(["open", cur.url])
        elif k == ord("m"):
            pop = menu(cur, pilot)
        elif isinstance(cur, (Cleanup, Orphan)) and k in (10, 13, curses.KEY_ENTER, ord("v")):
            pop = menu(cur)
        elif k in (10, 13, curses.KEY_ENTER):
            pop = start_menu(cur, s.agents)
        if sel != moved:
            sel = max(0, min(sel, len(rows) - 1))
            key = rows[sel].key if rows else None


# ── commands ────────────────────────────────────────────────────────────────


def cmd_live(a):
    if not (TTY and sys.stdin.isatty()):
        return cmd_ls(a)
    if not a.no_split:
        split_agents_pane()
    keep_awake()
    locale.setlocale(locale.LC_ALL, "")
    os.environ.setdefault("ESCDELAY", "25")
    try:
        curses.wrapper(tui, a)
    except KeyboardInterrupt:
        pass


def cmd_ls(a):
    s = snapshot(a.all)
    write_state(s, a.all)
    if s.error:
        die(s.error)
    for parts, _ in lines(s, a.all, {w.id for w in s.items} if a.unfold else ()):
        print("".join(PAINT[t](x) if t else x for x, t in parts))


def find_work(id):
    wf._cache.clear()
    items = wf.many([id])
    if not items:
        die(f"fant ikke work item {id}")
    parent = next((p for p in wf.many(items[0].links(wf.PARENT)) if p.is_map or p.is_spec), None)
    w = Work(items[0], Work(parent) if parent else None)
    if w.folds:
        unfold(w)
    return w


def find_review(id):
    try:
        raw = rest(f"git/pullrequests/{id}", scope="org")
    except RuntimeError as e:
        die(str(e))
    return Review(raw, me()[0])


def start(x, dry):
    cwd, cmd = plan(x)
    if dry:
        return print(dim(f"(cd {shlex.quote(cwd)} && {' '.join(shlex.quote(c) for c in cmd)})"))
    try:
        print(green(launch(x)))
    except RuntimeError as e:
        die(str(e))


def cmd_go(a):
    start(find_work(a.id), a.dry_run)


def cmd_review(a):
    start(find_review(a.id), a.dry_run)


def cmd_fix(a):
    try:
        raw = rest(f"git/pullrequests/{a.id}", scope="org")
    except RuntimeError as e:
        die(str(e))
    m = Mine(raw)
    detail(m)
    start(m, a.dry_run)


def cmd_prune(a):
    os_ = orphans(sessions(), set())
    if a.id:
        o = next((o for o in os_ if o.sid == a.id or o.name == a.id), None)
        if not o:
            die(f"ingen fleet-sesjon {a.id}")
        return run_action(end, o)
    try:
        prs = active()
        flat = work()[0]
        flat += [t for m in flat for t in m.children]
        keys = {x.key for x in flat + reviews(prs, True) + mine(prs)}
    except RuntimeError as e:
        die(str(e))
    os_ = [o for o in os_ if o.name not in keys]
    if not os_:
        return print(dim("ingen foreldreløse agenter"))
    for o in os_:
        head = f"{o.name}  {o.state}  {short(o.cwd)}"
        if not o.finished:
            print(yellow(f"▶ {head}  — kjører, fjern med --id {o.sid}"))
        elif a.dry_run:
            print(green(f"✓ {head}  — ville fjernet"))
        else:
            try:
                print(green(end(o)))
            except RuntimeError as e:
                print(red(f"✗ {e}"))


def cmd_code(a):
    trees = worktrees().get(a.id, [])
    if not trees:
        die(f"ingen worktree for #{a.id} under {', '.join(short(r) for r in ROOTS)}")
    if a.n is None and len(trees) > 1:
        for n, (_, t) in enumerate(trees, 1):
            print(f"{n}  {short(t)}")
        die("flere worktrees — velg med -n N")
    main, tree = trees[(a.n or 1) - 1]
    run_action(open_code, main, tree)


def cmd_clean(a):
    raw = sessions()
    cands = candidates(trees(), raw)
    if a.force:
        path = os.path.realpath(os.path.expanduser(a.force))
        c = next((c for c in cands if os.path.realpath(c.tree.path) == path), None)
        if not c:
            die(f"{a.force} er ikke en worktree for et Done work item")
        line = remove(c, raw, force=True)
        return print(red(line) if line.startswith("✗") else green(line))
    if not cands:
        return print(dim("ingen worktrees for Done work items"))
    while True:  # again after removing, so a worktree that had finished ones inside can go too
        removed, blocked = 0, []
        for c in cands:
            head = f"#{c.id} {c.title[:50]}  {short(c.tree.path)}"
            if c.reasons:
                blocked.append(yellow(f"🧹 {head}  — {', '.join(c.reasons)}"))
            elif a.dry_run:
                print(green(f"🧹 {head}  — ville fjernet") + dim(f" (branch {c.tree.branch})" if c.pr else ""))
            else:
                line = remove(c, raw)
                removed += not line.startswith("✗")
                print(red(line) if line.startswith("✗") else green(line))
        if not removed or not blocked:
            break
        raw = sessions()
        cands = candidates(trees(), raw)
    for line in blocked:
        print(line)


def run_action(fn, *args):
    try:
        print(green(fn(*args)))
    except RuntimeError as e:
        die(str(e))


def cmd_pr(a):
    fn = {"approve": approve, "auto": auto_complete, "complete": complete_now, "abandon": abandon}[a.action]
    run_action(fn, find_review(a.id))


def cmd_wi(a):
    w = find_work(a.id)
    if a.action == "sprint":
        return run_action(set_sprint, w)
    if not a.value:
        print(" · ".join(states(w)))
        return
    run_action(set_state, w, " ".join(a.value))


GUIDE = """\
{b}fleet — jobben min i Azure DevOps, én tast for å sette en Claude-agent på den{r}

{b}ORG{r}  {org} (alle prosjekter)

{b}LISTA{r}
  Work items   tildelt meg, state To Do eller Doing. Doing først.
  PRer         aktive, ikke draft, ikke mine, uten min godkjenning (stemme < 5).
               Default bare der jeg er reviewer; `a` / -a viser alle andres.
  Mine PRer    aktive PRer jeg har laget, draft også. Viser det som blokkerer:
                 konflikt · <bygg> ✗ · @navn ✗/⏸ (avvist / venter på endringer) · 💬 n aktive tråder
                 <policy> … (kjører/i kø) · draft · auto · klar
               ✗ rødt = noe feiler, ⏸ gult = venter på meg, ✓ = klar til complete.
               Work items som PR-en lenker (eller har id-en i branchen) får «↳ !<pr> ✗/⏸/✓» på linja.
  Foreldreløse fleet-agenter der work item/PR ikke lenger er i lista (Done, godkjent,
               completed, tatt bort). Fjernes manuelt: enter/m → x, eller `fleet prune`.

{b}KOMMANDOER{r}

  fleet [-a] [--no-split] [-q] [--no-autopilot]
                            levende liste, oppdateres hvert {refresh}. sekund
                            varsler (macOS) når en fleet-agent venter på deg eller er ferdig (-q: ingen varsler)
                            autopilot på, se AUTOPILOT (--no-autopilot: av denne økta)
                            i Ghostty: `claude agents` i en pane til venstre, bare økter under {home} (ikke om den fortsatt er der)
                            macen går ikke i dvale mens den kjører (skjerm/skjermsparer går fortsatt)
  fleet ls [-a] [-u]        lista, skrevet ut én gang (-u: kart/spec foldet ut)
  fleet go <id> [-n]        bakgrunnsagent på et work item (-n: vis kommandoen)
  fleet review <id> [-n]    bakgrunnsagent som reviewer en PR
  fleet fix <id> [-n]       bakgrunnsagent som fikser min PR: konflikter, bygg, review-kommentarer
  fleet prune [-n]          fjern ferdige foreldreløse agenter (claude rm; kjørende listes bare)
  fleet prune --id <id>     fjern én (stoppes først om den kjører)
  fleet pr <id> approve|auto|complete|abandon
                            godkjenn · sett auto-complete · fullfør nå (feiler om noe blokkerer) · forlat
  fleet wi <id> state [S]   sett state S (uten S: list typens states)
  fleet wi <id> sprint      flytt til prosjektets nåværende sprint (default-teamet)
  fleet code <id> [-n N]    VS Code i itemets worktree, med .env* kopiert fra hovedtreet
  fleet clean [-n]          fjern worktrees for Done work items der ingenting kan gå tapt
  fleet clean --force <wt>  fjern likevel (ulagrede endringer går tapt; branchen beholdes)
  fleet help                denne teksten

{b}TASTER{r}
  ↑↓ / j k  flytt · enter start agent · o åpne i nettleser · a mine/alle PRer · r oppdater · q avslutt
  A         autopilot: a slå av/på · u tillat utenfor arbeidstid (begge gjelder denne økta)
  → / l     fold ut kart/spec (åpne tickets: ledig / tatt / blokkert) · ← / h fold inn · space veksle
  m         valg for raden:
              PR         a approve · u auto-complete · c complete · x abandon · g review-agent ·
                         z demp/slå på autopilot · n kjør auto nå · o åpne
              work item  s endre status (1–9) · i nåværende sprint · g agent · v VS Code · o åpne
              min PR     f fix-agent · u auto-complete · c complete · x abandon ·
                         z demp/slå på autopilot · n kjør auto nå · o åpne
              agent      x fjern (stop + rm) · s stopp
            complete og abandon spør y/n først. esc lukker.
  v         VS Code i itemets worktree (⎇ på linja). Kopierer .env* fra hovedtreet dit
            worktreet har mappa men ikke fila — eksisterende filer røres ikke.
            Worktree hører til itemet når mappe- eller branchnavnet har id-en: fleet-<id>,
            t<id>, feat/<id>-…
  enter     start agent — velg prompt:
              1   radens egen (/implement, /wayfinder, /review-pr, fiks-prompten)
              2…  work item: fiks lenket PR · /diagnosing-bugs (Bug) el. /tdd · /code-review
                  (har PR/worktree) · /to-tickets (spec) · oppsummer (kart)
                  PR: forklar for meg · test lokalt   min PR: /code-review · /pr
              e   egendefinert prompt — enter starter, esc avbryter, ctrl-u/w sletter
                  (prefikses med hvilket element den gjelder: id, tittel, url)
            Samme agentnavn og mappe som radens egen. Finnes agenten, spør y/n først.

{b}AGENTENE{r}
  kart  → claude --bg -n fleet-wi-<id> "/wayfinder <id>"   i {home}
  annet → claude --bg -n fleet-wi-<id> "/implement <id>"   i repoet commits/PRer på itemet
          (eller barna) peker til, i worktree fleet-<id> — ellers i {home}
  kart-ticket → "/wayfinder <kart> ticket <id>" i {home}; task-tickets → "/implement <id>"
  PR    → claude --bg -n fleet-pr-<id> "/review-pr <id>"   i lokal klone av PR-ens repo
  min PR → claude --bg -n fleet-fix-<id> "<hva som blokkerer + instrukser>"  i checkouten som
          allerede har kildebranchen, ellers i worktree fleet-pr<id> i klonen. Pusher, completer ikke.
  Alle startes med --dangerously-skip-permissions — også agent view (`{agents}`).
  Kloner finnes én mappe ned i FLEET_ROOTS (default ~/visense, kolon-separert).
  Følg med: `claude agents` (venstre pane) · status vises også på linja (▶ ⏸ ✓).

{b}AUTOPILOT{r}  {d}(bare mens lista er åpen, og bare i én fleet om gangen){r}
  Starter agenter selv:
    ny PR der jeg er reviewer (ikke stemt) → fleet-pr-<id>: /code-review i worktree fleet-review<id>
                    på kildebranchen, target som fast punkt. Uten lokal klone: forklar PR-en.
                    Poster ingenting i ADO. Én gang per PR.
    min PR får rødt bygg / konflikt → fleet-fix-<id>: merger target inn, fikser, pusher. Ingen
                    force-push, svarer ikke i tråder. Én gang per commit, maks {tries} forsøk, så «🤖 ga opp».
  Ikke: drafts · PRer der jeg allerede har en agent jeg startet selv · hendelser eldre enn
  {backlog} t (helg teller ikke) · utenfor {hours} {days} — da i kø til arbeidstid starter.
  Maks {par} fleet-agenter kjører samtidig (mine teller med); resten «⏳ i kø», fix før review.
  Linja: 🤖 auto · ⏳ i kø / venter til 07:00 · 🤖 feilet: … · 🤖 ga opp · 🔕 auto av.
  Demping (m → z) huskes til raden er borte fra lista; av/på og utenfor arbeidstid (A) gjelder økta.
  Review-worktrees fjernes når PR-en er borte fra lista og ingen agent jobber der.
  Konfig: {config}   tilstand: {state}

{b}OPPRYDDING{r}  {d}(automatisk i lista; --no-clean slår av){r}
  Et worktree er ferdig når alle work items navnet bærer er Done — det skjer når PR-en
  fullføres. Ved hver oppdatering fjernes slike worktrees hvis
    ingen agent jobber der · ingen ulagrede endringer · ingen ikke-pushede commits
    (med mindre en fullført PR merget akkurat HEAD) · ikke låst · ingen worktrees inni
  Sammen med worktreet: den lokale branchen (bare når en fullført PR merget den) og
  Claude-sesjonene som jobbet der. Logg: {log}
  Det som står i veien listes under «Opprydding» med grunnen; enter/m → f rydd likevel.

{b}FOR CLAUDE{r}
  Lista skrives hvert {write}. sekund til
    {out}/screen.txt   som tekst, akkurat som den vises
    {out}/state.json   strukturert, med `start`-kommando per element
  Les dem, start agenter med `fleet go <id>` / `fleet review <id>`, og handle med
  `fleet pr <id> …` / `fleet wi <id> …`.
"""


def cmd_help(a):
    on = TTY
    print(GUIDE.format(b="\033[1m" if on else "", r="\033[0m" if on else "", org=A().org,
                       refresh=REFRESH, write=WRITE, home=short(HOME), out=short(OUT), agents=AGENTS,
                       d="\033[2m" if on else "", log=short(LOG), config=short(CONFIG),
                       state=short(Pilot.PATH), **pilot_help()))


def pilot_help():
    c = config()[0]["autopilot"]
    return dict(tries=c["max_fix_attempts"], backlog=c["backlog_hours"], hours=c["hours"],
                days=c["weekdays"], par=c["max_parallel"])


# ── cli ─────────────────────────────────────────────────────────────────────


def main():
    p = argparse.ArgumentParser(prog="fleet", description="my ADO work and PRs, handed to Claude agents")
    sub = p.add_subparsers(dest="cmd")

    s = sub.add_parser("live", help="live list")
    s.add_argument("-a", "--all", action="store_true", help="all others' PRs, not just where I'm reviewer")
    s.add_argument("--no-split", action="store_true", help="don't open the claude agents pane in Ghostty")
    s.add_argument("-q", "--quiet", action="store_true", help="no notification when an agent needs me")
    s.add_argument("--no-clean", action="store_true", help="don't remove worktrees of Done work items")
    s.add_argument("--no-autopilot", action="store_true", help="start no agents by itself this session")
    s.set_defaults(fn=cmd_live)

    s = sub.add_parser("ls", help="print the list once (and write the state files)")
    s.add_argument("-a", "--all", action="store_true")
    s.add_argument("-u", "--unfold", action="store_true", help="show maps' and specs' open tickets")
    s.set_defaults(fn=cmd_ls)

    for name, fn, h in (("go", cmd_go, "background agent on a work item"),
                        ("review", cmd_review, "background agent reviewing a PR")):
        s = sub.add_parser(name, help=h)
        s.add_argument("id", type=int)
        s.add_argument("-n", "--dry-run", action="store_true", help="print the command, start nothing")
        s.set_defaults(fn=fn)

    s = sub.add_parser("fix", help="background agent fixing my PR: conflicts, failing build, review comments")
    s.add_argument("id", type=int)
    s.add_argument("-n", "--dry-run", action="store_true", help="print the command, start nothing")
    s.set_defaults(fn=cmd_fix)

    s = sub.add_parser("prune", help="remove finished fleet agents whose item/PR is gone from the list")
    s.add_argument("-n", "--dry-run", action="store_true", help="only list")
    s.add_argument("--id", help="remove this one session (id or name), running or not")
    s.set_defaults(fn=cmd_prune)

    s = sub.add_parser("pr", help="act on a PR: approve, auto(-complete), complete, abandon")
    s.add_argument("id", type=int)
    s.add_argument("action", choices=("approve", "auto", "complete", "abandon"))
    s.set_defaults(fn=cmd_pr)

    s = sub.add_parser("wi", help="act on a work item: state <State> (none: list states), sprint")
    s.add_argument("id", type=int)
    s.add_argument("action", choices=("state", "sprint"))
    s.add_argument("value", nargs="*")
    s.set_defaults(fn=cmd_wi)

    s = sub.add_parser("code", help="open VS Code in a work item's worktree, copying .env* from the main checkout")
    s.add_argument("id", type=int)
    s.add_argument("-n", type=int, help="which worktree, when there are several")
    s.set_defaults(fn=cmd_code)

    s = sub.add_parser("clean", help="remove worktrees of Done work items where nothing can be lost")
    s.add_argument("-n", "--dry-run", action="store_true", help="only list what would go and what's in the way")
    s.add_argument("--force", metavar="WORKTREE", help="remove this one anyway (uncommitted changes are lost)")
    s.set_defaults(fn=cmd_clean)

    s = sub.add_parser("help", help="forklaring (norsk)")
    s.set_defaults(fn=cmd_help)

    argv = sys.argv[1:]
    if not argv or argv[0] not in sub.choices and argv[0] not in ("-h", "--help"):
        argv = ["live"] + argv
    a = p.parse_args(argv)
    wf._tracker = A()
    try:
        a.fn(a)
    except KeyboardInterrupt:
        sys.exit(130)


if __name__ == "__main__":
    main()
