#!/usr/bin/env python3
#
# wi — query Azure DevOps work items from the shell, the same way every time.
#
# Shares tracker, auth, rendering and `show` with wf (bin/wf), so output looks
# the same. ADO only: org/project from this repo's origin, else `az devops
# configure` defaults.
#
# Type:
#
#   wi                       my open items
#   wi ls [filters] [text]   query: -s state -t type -a who -g tag -u under -I iteration
#   wi sprint [-a who]       current iteration, grouped by state
#   wi tree 8698             item and its children, recursively
#   wi show 8700             one work item: body, links, comments (= wf show)
#   wi q "<WIQL where>"      raw WIQL condition, same listing
#   wi ask "<fritekst>"      Claude writes the WIQL (printed as a `wi q` line), runs
#                            it, and answers when it's a question
#   wi triage 8700           Claude proposes route, priority, parent, criteria and
#                            questions; y writes them to ADO (see TRIAGE below)
#   wi triage                my open Issues/Bugs nobody has triaged yet
#   wi open 8700             open in browser
#   wi help                  explained (Norwegian)
#
# Deterministic: same filters, same WIQL, same order (state, then id).
# WF_ORG / WF_PROJECT override the project, WI_TEAM the team (sprint/@me).
# --wiql prints the query instead of running it.

import argparse
import datetime
import html
import importlib.machinery
import importlib.util
import json
import os
import re
import shlex
import subprocess
import sys
import time
import urllib.error
import urllib.parse
import urllib.request

_here = os.path.dirname(os.path.realpath(__file__))
_loader = importlib.machinery.SourceFileLoader("wf", os.path.join(_here, "wf"))
_spec = importlib.util.spec_from_loader("wf", _loader)
wf = importlib.util.module_from_spec(_spec)
_loader.exec_module(wf)

from_wf = ("bold", "dim", "cyan", "green", "yellow", "red", "state_c", "DONE", "CHILD", "PARENT", "TTY", "text")
globals().update({k: getattr(wf, k) for k in from_wf})

ORDER = {"New": 0, "To Do": 0, "Proposed": 0, "Approved": 1, "Committed": 2, "Active": 3,
         "In Progress": 3, "Doing": 3, "Resolved": 4, "Done": 5, "Closed": 5, "Removed": 6}
LIMIT = 200


def die(msg):
    print(f"wi: {msg}", file=sys.stderr)
    sys.exit(1)


_ado = None


def A():
    global _ado
    if _ado is None:
        _ado = wf.Ado(wf.sh("git", "remote", "get-url", "origin"))
        wf._tracker = _ado  # wf.get/many/show read through the same tracker and cache
    return _ado


def team():
    if os.environ.get("WI_TEAM"):
        return os.environ["WI_TEAM"]
    p = A().api(f"projects/{urllib.parse.quote(A().project)}")
    return p.get("defaultTeam", {}).get("name") or f"{A().project} Team"


# ── query ───────────────────────────────────────────────────────────────────


def q(s):
    return "'" + s.replace("'", "''") + "'"


def who(s):
    return "@Me" if s in ("me", "@me") else q(s)


def where(a):
    """Filters → WIQL conditions. Every list command goes through here."""
    c = ["[System.TeamProject] = @project"]
    if a.state:
        c.append("[System.State] IN (" + ", ".join(q(s) for s in a.state) + ")")
    elif not a.all:
        c.append("[System.State] NOT IN (" + ", ".join(q(s) for s in sorted(DONE)) + ")")
    if a.type:
        c.append("[System.WorkItemType] IN (" + ", ".join(q(t) for t in a.type) + ")")
    if a.assignee == "none":
        c.append("[System.AssignedTo] = ''")
    elif a.assignee:
        c.append(f"[System.AssignedTo] = {who(a.assignee)}")
    for t in a.tag or []:
        c.append(f"[System.Tags] CONTAINS {q(t)}")
    if a.under:
        c.append(f"[System.AreaPath] UNDER {q(a.under)}")
    if a.iteration:
        c.append("[System.IterationPath] = " + ("@CurrentIteration" if a.iteration == "current"
                                                 else f"UNDER {q(a.iteration)}"))
    if a.changed:
        c.append(f"[System.ChangedDate] >= @Today - {a.changed}")
    if a.text:
        t = q(" ".join(a.text))
        c.append(f"([System.Title] CONTAINS {t} OR [System.Description] CONTAINS WORDS {t})")
    return c


def wiql(conds, order=None):
    return ("SELECT [System.Id] FROM WorkItems WHERE " + " AND ".join(conds)
            + " ORDER BY " + (order or "[System.Id]"))


LONG_TEXT = {"System.Description", "System.History", "Microsoft.VSTS.Common.AcceptanceCriteria",
             "Microsoft.VSTS.TCM.ReproSteps", "Microsoft.VSTS.TCM.SystemInfo"}
EMPTY = re.compile(r"(?i)\[([\w.]+)\]\s*(?:(is\s*not\s*empty|isnotempty|<>\s*'')|(is\s*empty|isempty|=\s*''))")


def normalize(cond):
    """Empty checks in the form ADO accepts for that field: IS [NOT] EMPTY on long text,
    = '' / <> '' elsewhere. Tags can't be tested for empty in WIQL at all, so that test
    becomes a no-op here and a filter afterwards. → (cond, untagged: None|True|False)"""
    untagged = None

    def fix(m):
        nonlocal untagged
        field, empty = m.group(1), bool(m.group(3))
        if field.lower() == "system.tags":
            untagged = empty
            return "[System.Id] > 0"
        if field in LONG_TEXT:
            return f"[{field}] IS {'' if empty else 'NOT '}EMPTY"
        return f"[{field}] {'=' if empty else '<>'} ''"

    return EMPTY.sub(fix, cond), untagged


def execute(query, limit):
    """WIQL → ids. Raises RuntimeError with ADO's message, so callers can retry or die."""
    proj = urllib.parse.quote(A().project)
    if "@currentiteration" in query.lower():
        proj += "/" + urllib.parse.quote(team())
    ids = [w["id"] for w in rest(f"wit/wiql?$top={limit}", {"query": query}, project=proj)["workItems"]]
    if len(ids) >= limit:
        print(dim(f"(first {limit} — narrow it, or --limit)"), file=sys.stderr)
    return ids


def items_of(ids, untagged=None, order=None):
    items = wf.many(ids)
    if untagged is not None:
        items = [t for t in items if (not t.tags) == untagged]
    if not order:
        items.sort(key=lambda t: (ORDER.get(t.state, 3), t.id))
    return items


def run(query, a, untagged=None):
    if a.wiql:
        print(query)
        sys.exit(0)
    try:
        ids = execute(query, a.limit)
    except RuntimeError as e:
        die(f"ADO avviste spørringen: {e}\n{dim(query)}")
    return items_of(ids, untagged, getattr(a, "order", None))


# ── ask ─────────────────────────────────────────────────────────────────────
# Fritekst → Claude → WIQL → ADO. Claude sees the project's real types, states,
# areas, iterations, people and tags (cached a day), so it names things that
# exist. Empty checks are normalised (see normalize). ADO validates the query;
# an error goes back to Claude, up to TRIES times. The query
# is printed as a `wi q` line, so a good one can be rerun without Claude.

CACHE = os.path.expanduser("~/.cache/wi")
MODEL = os.environ.get("WI_MODEL", "haiku")
TRIES = 3


def rest(path, body=None, project=None, version="7.1"):
    """Like Ado.api, but raises instead of exiting, so a bad WIQL can be retried."""
    url = f"{A().org}/{project + '/' if project else ''}_apis/{path}"
    url += ("&" if "?" in path else "?") + f"api-version={version}"
    data = json.dumps(body).encode() if body is not None else None
    req = urllib.request.Request(url, data=data, method="POST" if data else "GET",
                                 headers={"Authorization": f"Bearer {A().token()}",
                                          "Content-Type": "application/json"})
    try:
        with urllib.request.urlopen(req) as r:
            return json.load(r)
    except urllib.error.HTTPError as e:
        try:
            msg = json.loads(e.read()).get("message")
        except ValueError:
            msg = None
        raise RuntimeError(msg or f"HTTP {e.code}")


def context(fresh=False):
    """What exists in the project — the vocabulary Claude may use."""
    path = os.path.join(CACHE, re.sub(r"\W+", "_", A().where) + ".json")
    try:
        if not fresh and time.time() - os.path.getmtime(path) < 86400:
            with open(path) as f:
                return json.load(f)
    except OSError:
        pass
    p, tm = urllib.parse.quote(A().project), team()

    def paths(node, prefix=""):
        here = prefix + node["name"]
        return [here] + [x for c in node.get("children", []) for x in paths(c, here + "\\")]

    people = {}
    for t in rest(f"projects/{p}/teams")["value"]:
        for m in rest(f"projects/{p}/teams/{urllib.parse.quote(t['name'])}/members")["value"]:
            people[m["identity"]["uniqueName"]] = m["identity"]["displayName"]
    its = rest("work/teamsettings/iterations", project=f"{p}/{urllib.parse.quote(tm)}")["value"]
    ctx = {
        "team": tm,
        "types": {t["name"]: [s["name"] for s in t.get("states", [])]
                  for t in rest("wit/workitemtypes", project=p)["value"] if not t.get("isDisabled")},
        "areas": paths(rest("wit/classificationnodes/areas?$depth=3", project=p)),
        "iterations": {i["path"]: f"{(i['attributes'].get('startDate') or '')[:10]}.."
                                  f"{(i['attributes'].get('finishDate') or '')[:10]}" for i in its[-30:]},
        "people": dict(sorted(people.items())),
        "tags": sorted(t["name"] for t in rest("wit/tags", project=p, version="7.1-preview.1")["value"]),
    }
    os.makedirs(CACHE, exist_ok=True)
    with open(path, "w") as f:
        json.dump(ctx, f)
    return ctx


def claude(system, prompt, schema=None, model=MODEL):
    cmd = ["claude", "-p", "--model", model, "--tools", "", "--no-session-persistence",
           "--setting-sources", "", "--output-format", "json", "--system-prompt", system]
    if schema:
        cmd += ["--json-schema", json.dumps(schema)]
    if TTY:
        print(dim("… claude"), end="\r", file=sys.stderr, flush=True)
    r = subprocess.run(cmd, input=prompt, capture_output=True, text=True)
    if TTY:
        print("         ", end="\r", file=sys.stderr, flush=True)
    try:
        out = json.loads(r.stdout)
    except ValueError:
        die(f"claude: {(r.stderr or r.stdout).strip()[:400]}")
    if out.get("is_error"):
        die(f"claude: {out.get('result')}")
    return out.get("structured_output") if schema else (out.get("result") or "").strip()


QUERY = {
    "type": "object",
    "properties": {
        "where": {"type": "string", "description": "WIQL conditions only, the part after WHERE"},
        "order": {"type": "string", "description": "ORDER BY clause without the keywords, or empty"},
        "answer": {"type": "boolean", "description": "true if the user asks something the list alone doesn't answer"},
    },
    "required": ["where", "order", "answer"],
}

ASK_SYSTEM = """\
You turn a request about Azure DevOps work items into WIQL for project {project}.

where: only the conditions after WHERE. [System.TeamProject] = @project is added for you.
  Fields: [System.Id] [System.Title] [System.State] [System.WorkItemType] [System.AssignedTo]
  [System.CreatedBy] [System.ChangedBy] [System.CreatedDate] [System.ChangedDate] [System.Tags]
  [System.AreaPath] [System.IterationPath] [System.Description] [System.Parent]
  [Microsoft.VSTS.Common.Priority] [Microsoft.VSTS.Common.ClosedDate]
  [Microsoft.VSTS.Common.StateChangeDate] [Microsoft.VSTS.Common.AcceptanceCriteria]
  Macros: @Me, @Today, @Today - N, @StartOfWeek, @StartOfMonth, @CurrentIteration (team {team}).
  Text: [System.Title] CONTAINS 'x' OR [System.Description] CONTAINS WORDS 'x'.
  Tags: [System.Tags] CONTAINS 'tag' (only tags from the list). Areas/iterations: UNDER 'path'.
  People: [System.AssignedTo] = 'email', picked from the list; @Me for the user; '' for unassigned.
  Empty: [System.Description] / [Microsoft.VSTS.Common.AcceptanceCriteria] IS EMPTY / IS NOT EMPTY;
  every other field = '' / <> ''. "No tags": [System.Tags] = ''.
  Someone not in the list: [System.AssignedTo] CONTAINS 'their name'. Never return an empty where.
  Unless the request is about finished work or history, exclude done states:
  [System.State] NOT IN ('Done', 'Closed', 'Removed', 'Resolved').
  Use only types, states, areas, iterations, people and tags that exist below.
order: e.g. [System.ChangedDate] DESC, or "" for by id.
answer: true for questions (how many, who, which is oldest, is X done, summarise);
  false when they just want the items listed.

Today: {today}. The user: {me}. Their words may be Norwegian.
Types and states: {types}
Areas: {areas}
Iterations (path: dates — use the path only; the current one is @CurrentIteration): {iterations}
People (email: name — always use the email): {people}
Tags: {tags}
"""

ANSWER_SYSTEM = """\
Answer the user's question about Azure DevOps work items, using only the result of the query
below. The user already sees the items listed, so don't repeat them — give the answer
itself (a number, a name, a judgement), in one to three lines. Same language as the
question, no preamble; cite ids only where they add something. If the result
can't answer it, say so and what query would. Plain text, no markdown headers."""


def dq(s):
    """Shell-quote, preferring double quotes — WIQL is full of single ones."""
    return f'"{s}"' if not re.search(r'["$`!]', s) else shlex.quote(s)


def cmd_ask(a):
    question = " ".join(a.question)
    ctx = context(a.refresh)
    system = ASK_SYSTEM.format(project=A().project, today=datetime.date.today().isoformat(),
                               me=A().me(), **{k: v if isinstance(v, str) else json.dumps(v, ensure_ascii=False)
                                               for k, v in ctx.items()})
    prompt, proj = question, A().project
    errors = []
    for attempt in range(1, TRIES + 1):
        qy = claude(system, prompt, QUERY, a.model)
        where_ = qy["where"].strip()
        where_ = re.sub(r"(?is)^.*?\bWHERE\b|\bORDER\s+BY\b.*$", "", where_).strip() if \
            re.search(r"(?i)^\s*SELECT\b", where_) else where_
        if not where_:
            die("Claude fant ingen spørring — omformuler, eller prøv -m sonnet")
        said = where_  # wi q normalises too, so the rerun line keeps e.g. the tag test
        where_, untagged = normalize(where_)
        order = qy.get("order", "").strip() or None
        query = wiql(["[System.TeamProject] = @project", f"({where_})"], order)
        rerun = "wi q -A " + dq(said) + (" -O " + dq(order) if order else "")
        print(dim("$ " + rerun), file=sys.stderr)
        if a.wiql:
            return print(query)
        try:
            ids = execute(query, a.limit)
            break
        except RuntimeError as e:
            errors.append((said, str(e).strip()))
            if attempt == TRIES:
                die(f"ADO avviste spørringen {TRIES} ganger: {e}\nprøv -m sonnet, eller skriv den selv med `wi q`")
            print(dim(f"ADO: {str(e).strip()} — prøver igjen ({attempt}/{TRIES - 1})"), file=sys.stderr)
            prompt = question + "\n\nADO rejected these where clauses, don't repeat them:\n" + "\n".join(
                f"- {w}\n  error: {err}" for w, err in errors) + "\nWrite one that ADO accepts."
    items = items_of(ids, untagged, order)
    listing(items, a.group)
    if not (qy.get("answer") or a.answer) or a.list:
        return
    rows = "\n".join(f"{t.id} | {t.type} | {t.state} | {t.assignee or '-'} | {', '.join(t.tags) or '-'} | {t.title}"
                     for t in items)
    more = f"\n(truncated at {a.limit})" if len(ids) >= a.limit else ""
    print("\n" + claude(ANSWER_SYSTEM, f"Question: {question}\n\nWIQL: {query}\n\n"
                                       f"{len(items)} item(s): id | type | state | assignee | tags | title\n"
                                       f"{rows}{more}", model=a.model))


# ── triage ──────────────────────────────────────────────────────────────────
# An Issue/Bug assigned to me → Claude → a proposal: route (the triage tag, or
# wayfinder when it should become a map), priority, parent, acceptance criteria,
# questions for the reporter. The proposal is cached per work item revision in
# ~/.cache/wi/triage/<id>.json, so fleet's autopilot can triage in the background
# and I approve later without a second Claude call. Only approving writes to ADO.

TRIAGE_DIR = os.path.join(CACHE, "triage")
TRIAGE_MODEL = os.environ.get("WI_TRIAGE_MODEL", "sonnet")
ROUTES = ("ready-for-agent", "ready-for-human", "needs-info", "wayfinder")
TRIAGE_TAGS = ("needs-triage", "needs-info", "ready-for-agent", "ready-for-human")
TRIAGED = TRIAGE_TAGS[1:]
PRIO = "Microsoft.VSTS.Common.Priority"
AC = "Microsoft.VSTS.Common.AcceptanceCriteria"
REPRO = "Microsoft.VSTS.TCM.ReproSteps"

TRIAGE_SCHEMA = {
    "type": "object",
    "properties": {
        "route": {"type": "string", "enum": list(ROUTES)},
        "priority": {"type": "integer", "minimum": 1, "maximum": 4},
        "parent": {"type": "integer", "description": "id from the candidate list, or 0"},
        "criteria": {"type": "array", "items": {"type": "string"}},
        "questions": {"type": "array", "items": {"type": "string"}, "maxItems": 3},
        "summary": {"type": "string", "maxLength": 100},
        "why": {"type": "string"},
    },
    "required": ["route", "priority", "parent", "criteria", "questions", "summary", "why"],
    "additionalProperties": False,
}

TRIAGE_SYSTEM = """\
You triage one Azure DevOps work item (Issue or Bug) that was assigned to {me}, a developer.
Decide how it should be worked, without doing the work.

route — pick one:
- ready-for-agent: clear and small. An unattended coding agent can implement and verify it
  from the text alone (typo, copy change, a contained UI or logic fix with an obvious result).
- ready-for-human: clear what to do, but it needs a person: judgement on design or wording,
  legal/commercial content, access to prod or customers, manual verification, or the
  developer said so.
- needs-info: a fact only the reporter has is missing, so any fix would be a guess: where
  (page, URL, environment), what happens vs. what was expected, which customer/data, steps.
- wayfinder: too big or foggy for one working session: two or more open decisions, the
  solution is unknown and needs research/prototype/discussion, it spans several repos or
  systems, or it is more than a day or two of work / several PRs. It becomes a map.
Prefer needs-info over guessing. A one-line item that names the page and the change is
fine for ready-for-agent.

priority: 1 = production down, data loss, or customers blocked; 2 = important, this sprint;
3 = normal; 4 = cosmetic or typo. Keep the current priority when it fits.

parent: the id of the candidate below this item clearly belongs under, else 0. Keep the
current parent if it has one (return its id).

criteria: acceptance criteria as short checkable statements, only what the item says or
plainly implies — never invent requirements. Empty when route is needs-info or wayfinder,
or when the item already has them.

questions: for needs-info, 1–3 concrete questions to the reporter that unblock it. For other
routes, empty.

summary: one line, what is to be done. why: one sentence on the route.
Write criteria, questions and summary in the item's language (usually Norwegian).

Candidate parents (id | type | title):
{candidates}
"""


def triage_path(id):
    return os.path.join(TRIAGE_DIR, f"{id}.json")


def triage_record(id):
    """The cached proposal for a work item: {id, rev, at, model, proposal, applied}, or None."""
    try:
        with open(triage_path(id)) as f:
            return json.load(f)
    except (OSError, ValueError):
        return None


def save_record(r):
    os.makedirs(TRIAGE_DIR, exist_ok=True)
    tmp = f"{triage_path(r['id'])}.{os.getpid()}"
    with open(tmp, "w") as f:
        json.dump(r, f, ensure_ascii=False, indent=2)
    os.replace(tmp, triage_path(r["id"]))


def raw_item(id):
    try:
        return rest(f"wit/workitems/{id}?$expand=relations")
    except RuntimeError as e:
        die(f"#{id}: {e}")


def candidates(project):
    """Open Epics and wayfinder maps in the project: where a triaged item may go."""
    cond = ("[System.TeamProject] = @project AND [System.State] NOT IN ('Done', 'Closed', 'Removed', 'Resolved') "
            "AND ([System.WorkItemType] = 'Epic' OR [System.Tags] CONTAINS 'wayfinder:map')")
    ids = [w["id"] for w in rest("wit/wiql?$top=100", {"query": wiql([cond])},
                                 project=urllib.parse.quote(project))["workItems"]]
    return wf.many(ids)


def parent_of(raw):
    return next((int(r["url"].rsplit("/", 1)[1]) for r in raw.get("relations") or [] if r["rel"] == PARENT), 0)


def describe(raw, comments):
    """The work item as Claude reads it."""
    f = raw["fields"]
    who = lambda k: (f.get(k) or {}).get("displayName", "-")
    p = parent_of(raw)
    out = [f"#{raw['id']} {f.get('System.WorkItemType')}: {f.get('System.Title')}",
           f"State: {f.get('System.State')} · Area: {f.get('System.AreaPath')} · Iteration: {f.get('System.IterationPath')}",
           f"Priority: {f.get(PRIO, '-')} · Tags: {f.get('System.Tags') or '-'} · Parent: "
           + (f"{p} {wf.get(p).title}" if p else "-"),
           f"Created by {who('System.CreatedBy')} {f.get('System.CreatedDate', '')[:10]}, assigned to {who('System.AssignedTo')}"]
    for name, k in (("Description", "System.Description"), ("Repro steps", REPRO), ("Acceptance criteria", AC)):
        if f.get(k):
            out.append(f"\n## {name}\n{text(f[k])}")
    for who_, when, body in comments[-10:]:
        out.append(f"\n## Comment by {who_} {when[:10]}\n{text(body)}")
    return "\n".join(out)


def propose(id, model):
    """Run Claude on the work item and cache the proposal. → record"""
    raw = raw_item(id)
    f = raw["fields"]
    item = wf.get(id)
    cands = candidates(f["System.TeamProject"])
    system = TRIAGE_SYSTEM.format(me=A().me(), candidates="\n".join(
        f"{c.id} | {'map' if c.is_map else c.type} | {c.title}" for c in cands) or "(none)")
    p = claude(system, describe(raw, A().comments(item)), TRIAGE_SCHEMA, model)
    if p["parent"] and p["parent"] not in {c.id for c in cands} | {parent_of(raw)}:
        p["parent"] = 0  # only parents that exist and are open
    r = {"id": id, "rev": raw["rev"], "at": datetime.datetime.now().isoformat(timespec="seconds"),
         "model": model, "title": f.get("System.Title"), "proposal": p, "applied": False}
    save_record(r)
    return r


def route_c(route):
    return {"ready-for-agent": green, "ready-for-human": yellow, "needs-info": red, "wayfinder": cyan}[route](route)


def show_proposal(r, raw):
    f, p = raw["fields"], r["proposal"]
    cur_p = parent_of(raw)
    arrow = lambda a, b: f"{a} → {bold(str(b))}" if str(a) != str(b) else str(a)
    print(f"{bold(f.get('System.Title'))}  {dim(f'#{r['id']} {f.get('System.WorkItemType')} · {f.get('System.State')}')}")
    print(f"  {'rute':<10} {route_c(p['route'])}" + (dim("  → tag wayfinder:map, så `wf go`") if p["route"] == "wayfinder" else ""))
    print(f"  {'prioritet':<10} {arrow(f.get(PRIO, '-'), p['priority'])}")
    if p["parent"] or cur_p:  # an existing parent is kept, so only a missing one can change
        par = lambda i: f"{i} {wf.get(i).title}"
        print(f"  {'parent':<10} {par(cur_p) if cur_p else arrow('-', par(p['parent']))}")
    for name, xs in (("kriterier", p["criteria"]), ("spørsmål", p["questions"])):
        for n, x in enumerate(xs):
            print(f"  {name if n == 0 else '':<10} - {x}")
    print(f"  {'sammendrag':<10} {p['summary']}")
    print(dim(f"  {'hvorfor':<10} {p['why']}"))
    print(dim(f"  {r['model']} · {r['at'].replace('T', ' ')[:16]}" + (" · brukt" if r.get("applied") else "")))


def mention(identity):
    """An ADO @mention of a person, so they get notified of the comment."""
    return (f'<a href="#" data-vss-mention="version:2.0,{identity["id"]}">@{html.escape(identity["displayName"])}</a>'
            if identity.get("id") else "")


def apply_proposal(r, raw):
    """Write the proposal to ADO. → one line saying what changed."""
    f, p = raw["fields"], r["proposal"]
    ops, did = [{"op": "test", "path": "/rev", "value": raw["rev"]}], []
    tag = "wayfinder:map" if p["route"] == "wayfinder" else p["route"]
    tags = [t.strip() for t in (f.get("System.Tags") or "").split(";") if t.strip() and t.strip() not in TRIAGE_TAGS]
    ops.append({"op": "add", "path": "/fields/System.Tags", "value": "; ".join(tags + [tag])})
    did.append(tag)
    if f.get(PRIO) != p["priority"]:
        ops.append({"op": "add", "path": f"/fields/{PRIO}", "value": p["priority"]})
        did.append(f"P{p['priority']}")
    if p["parent"] and not parent_of(raw):
        ops.append({"op": "add", "path": "/relations/-",
                    "value": {"rel": PARENT, "url": f"{A().org}/_apis/wit/workItems/{p['parent']}"}})
        did.append(f"parent {p['parent']}")
    desc = f.get("System.Description") or ""
    if p["criteria"] and not f.get(AC) and "akseptkriterier" not in desc.lower():
        ops.append({"op": "add", "path": "/fields/System.Description", "value": desc + "<h3>Akseptkriterier</h3><ul>"
                    + "".join(f"<li>{html.escape(c)}</li>" for c in p["criteria"]) + "</ul>"})
        did.append(f"{len(p['criteria'])} kriterier")
    A().api(f"wit/workitems/{r['id']}", ops, method="PATCH", ctype="application/json-patch+json")
    if p["route"] == "needs-info" and p["questions"]:
        creator = f.get("System.CreatedBy") or {}
        to = mention(creator) + " " if creator.get("uniqueName", "").lower() != A().me().lower() else ""
        body = (f"<p>{to}Før jeg kan ta denne trenger jeg litt mer:</p><ol>"
                + "".join(f"<li>{html.escape(q)}</li>" for q in p["questions"]) + "</ol>")
        A().api(f"wit/workItems/{r['id']}/comments", {"text": body}, project=urllib.parse.quote(f["System.TeamProject"]))
        did.append(f"{len(p['questions'])} spørsmål postet")
    r.update(applied=True, rev=raw_item(r["id"])["rev"])
    save_record(r)
    return f"✓ #{r['id']} → " + " · ".join(did)


def edit_proposal(r):
    """$EDITOR on the proposal as JSON; the route must stay one of ROUTES."""
    path = os.path.join(TRIAGE_DIR, f"{r['id']}.edit.json")
    with open(path, "w") as f:
        json.dump(r["proposal"], f, ensure_ascii=False, indent=2)
    subprocess.run(shlex.split(os.environ.get("EDITOR", "vi")) + [path])
    try:
        with open(path) as f:
            p = json.load(f)
    except ValueError as e:
        die(f"ugyldig JSON: {e}")
    finally:
        os.remove(path)
    if p.get("route") not in ROUTES or set(TRIAGE_SCHEMA["required"]) - set(p):
        die(f"rute må være én av {', '.join(ROUTES)}, og alle feltene må være med")
    r["proposal"] = p
    save_record(r)


def untriaged():
    """My open Issues/Bugs without a triage tag that aren't part of a map or spec."""
    cond = ("[System.AssignedTo] = @Me AND [System.WorkItemType] IN ('Issue', 'Bug') AND [System.State] "
            "NOT IN ('Done', 'Closed', 'Removed', 'Resolved')")
    items = wf.many(execute(wiql(["[System.TeamProject] = @project", cond]), LIMIT))
    return [t for t in items if not any(x in TRIAGED or x.startswith("wayfinder:") or x == "spec" for x in t.tags)]


def cmd_triage(a):
    if not a.id:
        items = untriaged()
        if not items:
            return print(dim("alt er triagert"))
        for t in items:
            r = triage_record(t.id)
            print(line(t) + (f"  {route_c(r['proposal']['route'])} {dim(r['proposal']['summary'])}" if r else ""))
        return print(dim(f"{len(items)} utriagert · wi triage <id>"))
    raw = raw_item(a.id)
    r = triage_record(a.id)
    if a.rerun or not r or r["rev"] != raw["rev"]:
        if a.yes and r and not a.rerun:
            die(f"#{a.id} er endret siden forslaget — se på det nytt med `wi triage {a.id}`")
        r = propose(a.id, a.model)
    if a.json:
        return print(json.dumps(r, ensure_ascii=False, indent=2))
    if a.save:
        p = r["proposal"]
        return print(f"#{a.id} {p['route']} P{p['priority']} — {p['summary']}")
    show_proposal(r, raw)
    if a.yes:
        return print(apply_proposal(r, raw))
    if not sys.stdin.isatty():
        return
    while True:
        c = input(f"\n{bold('y')} skriv til ADO · {bold('e')} rediger · {bold('r')} kjør på nytt · {bold('n')} avbryt: ").strip().lower()
        if c in ("y", "j"):
            print(apply_proposal(r, raw_item(a.id)))
            if r["proposal"]["route"] == "wayfinder" and not os.environ.get("WI_NO_GO") and input("start wayfinder nå (wf go)? [y/N] ").strip().lower() in ("y", "j"):
                os.execvp("wf", ["wf", "go", str(a.id)])
            return
        if c == "e":
            edit_proposal(r)
        elif c == "r":
            r = propose(a.id, a.model)
        elif c in ("n", "q", ""):
            return
        else:
            continue
        print()
        show_proposal(r, raw)


# ── rendering ───────────────────────────────────────────────────────────────


def short(t):
    return {"Product Backlog Item": "PBI", "User Story": "Story"}.get(t, t)


def line(t, indent="  "):
    who = f" @{t.assignee.split('@')[0]}" if t.assignee else ""
    tags = f" [{', '.join(t.tags)}]" if t.tags else ""
    return (f"{indent}{cyan(f'{t.id:>5}')} {dim(f'{short(t.type):<7}')} {state_c(f'{t.state:<11}')} "
            f"{t.title}{dim(who)}{dim(tags)}")


def listing(items, group=False):
    if not items:
        return print(dim("ingen treff"))
    if not group:
        for t in items:
            print(line(t))
        return print(dim(f"{len(items)} item(s)"))
    groups = {}
    for t in items:
        groups.setdefault(t.state, []).append(t)
    for s, ts in groups.items():
        print(state_c(bold(f"{s} ({len(ts)})")))
        for t in ts:
            print(line(t))


# ── commands ────────────────────────────────────────────────────────────────


def cmd_ls(a):
    listing(run(wiql(where(a)), a), a.group)


def cmd_mine(a):
    a.assignee = a.assignee or "@me"
    cmd_ls(a)


def cmd_sprint(a):
    a.iteration = "current"
    a.group = True
    cmd_ls(a)


def cmd_q(a):
    a.text = None
    cond, untagged = normalize(" ".join(a.cond))
    listing(run(wiql(where(a) + [f"({cond})"], a.order), a, untagged), a.group)


def cmd_tree(a):
    root = wf.get(a.id)
    parents = wf.many(root.links(PARENT))
    for p in parents:
        print(dim(f"↑ {p.id} {p.title}"))

    def walk(t, depth, seen):
        if t.done and not a.all and depth:
            return
        print(line(t, "  " * (depth + 1)))
        if t.id in seen or (a.depth is not None and depth >= a.depth):
            return
        kids = wf.many(t.links(CHILD))
        wf.fetch([k for c in kids for k in c.links(CHILD)])
        for c in sorted(kids, key=lambda k: (ORDER.get(k.state, 3), k.id)):
            walk(c, depth + 1, seen | {t.id})

    walk(root, 0, set())


def cmd_show(a):
    A()
    wf.cmd_show(a)


def cmd_open(a):
    subprocess.run(["open", wf.get(a.id).url])


GUIDE = """\
{b}wi — work items i Azure DevOps fra terminalen{r}

{b}PROSJEKT{r}  {where}  {d}(team: {team}){r}
  Fra `git remote get-url origin` (dev.azure.com), ellers `az devops configure -l`.
  WF_ORG / WF_PROJECT overstyrer prosjekt, WI_TEAM team (brukes av sprint/@CurrentIteration).

{b}KOMMANDOER{r}

  wi [mine] [filtre]      mine åpne items (= wi ls -a @me)
  wi ls [filtre] [tekst]  søk. Tekst matcher tittel eller ord i beskrivelsen
  wi sprint [filtre]      nåværende iterasjon for teamet, gruppert på state
  wi tree <id> [-d N]     item + barn rekursivt (Done skjult, -A viser)
  wi show <id> [-C]       full visning: body, kriterier, lenker, kommentarer (som wf show)
  wi q "<WIQL>" [-O ord]  rå WIQL-betingelse + filtrene, f.eks. wi q "[System.CreatedBy] = @Me"
  wi ask "<fritekst>"     Claude lager WIQL, viser den som en `wi q`-linje, kjører den, og
                          svarer hvis det er et spørsmål. --wiql bare query · -l bare liste
                          · -a svar alltid · -m modell · -r hent prosjektdata på nytt
  wi triage [id]          Claude foreslår rute, prioritet, parent, kriterier og spørsmål;
                          y skriver til ADO · e rediger · r på nytt. Uten id: mine utriagerte
                          -y skriv uten å spørre · --save bare lag forslaget · -m modell
  wi open <id>            åpne i nettleser
  wi help [kommando]      denne teksten, eller flaggene til én kommando

{b}FILTRE{r}  {d}(ls, mine, sprint, q){r}

  -s, --state S     state, kan gjentas         -s Doing -s New
  -t, --type T      work item type, gjentas    -t Bug -t "Product Backlog Item"
  -a, --assignee X  @me | none | e-post        -a none
  -g, --tag T       tag, gjentas (alle må med) -g ready-for-agent
  -u, --under P     area path UNDER            -u "Visense\\\\Logit"
  -I, --iteration   current | path UNDER       -I current
  -c, --changed N   endret siste N dager       -c 7
  -A, --all         ta med Done/Closed/Removed/Resolved
  -G, --group       grupper på state
  -L, --limit N     maks antall (default {limit})
  --wiql            skriv ut WIQL-en i stedet for å kjøre den

{b}VERDT Å VITE{r}

  · Bare lesing, unntatt triage etter y. Endre ellers med `az boards work-item update` eller wf.
  · triage: rute = ready-for-agent | ready-for-human | needs-info | wayfinder (blir tag
    wayfinder:map, så `wf go <id>` tegner kartet). Skriver tag, prioritet, manglende parent,
    akseptkriterier (i beskrivelsen) og, ved needs-info, spørsmålene som kommentar til den
    som meldte saken. Forslaget caches per revisjon i ~/.cache/wi/triage — fleet lager det
    i bakgrunnen. Modell: WI_TRIAGE_MODEL (default sonnet).
  · Sortering: state (ny → aktiv → ferdig), så id. Samme filtre gir alltid samme liste.
  · Uten -s skjules ferdige states; med -s får du nøyaktig de du ber om.
  · ask: Claude får prosjektets faktiske typer, states, områder, iterasjoner, folk og tags
    (cache ~/.cache/wi, 1 døgn, -r frisker opp). ADO validerer; feil sendes tilbake, maks 3 forsøk.
  · Tomt/ikke tomt (IsEmpty, = '' …) skrives om til formen ADO godtar per felt — også i q.
    «Uten tags» går ikke i WIQL, så det filtreres etter spørringen.
    Modell: WI_MODEL (default haiku, -m sonnet ved behov). Kopier `wi q`-linjen for å kjøre uten Claude.
  · Auth: `az login` (eller azt main).
"""


def cmd_help(a, subs):
    if a.topic:
        if a.topic not in subs:
            die(f"ukjent kommando: {a.topic}")
        return subs[a.topic].print_help()
    on = TTY
    txt = GUIDE.format(b="\033[1m" if on else "", r="\033[0m" if on else "",
                       d="\033[2m" if on else "", where=A().where, team=team(), limit=LIMIT)
    if on and txt.count("\n") > os.get_terminal_size().lines:
        subprocess.run(["less", "-RFX"], input=txt, text=True)
    else:
        print(txt)


# ── cli ─────────────────────────────────────────────────────────────────────


def filters(s, text=True):
    s.add_argument("-s", "--state", action="append")
    s.add_argument("-t", "--type", action="append")
    s.add_argument("-a", "--assignee", help="@me | none | email")
    s.add_argument("-g", "--tag", action="append")
    s.add_argument("-u", "--under", help="area path")
    s.add_argument("-I", "--iteration", help="current | iteration path")
    s.add_argument("-c", "--changed", type=int, metavar="DAYS")
    s.add_argument("-A", "--all", action="store_true", help="include done states")
    s.add_argument("-G", "--group", action="store_true", help="group by state")
    s.add_argument("-L", "--limit", type=int, default=LIMIT)
    s.add_argument("--wiql", action="store_true", help="print the WIQL, don't run it")
    if text:
        s.add_argument("text", nargs="*")


def main():
    p = argparse.ArgumentParser(prog="wi", description="query Azure DevOps work items")
    sub = p.add_subparsers(dest="cmd")

    s = sub.add_parser("mine", help="my open items")
    filters(s)
    s.set_defaults(fn=cmd_mine)

    s = sub.add_parser("ls", help="query work items")
    filters(s)
    s.set_defaults(fn=cmd_ls)

    s = sub.add_parser("sprint", help="current iteration, grouped by state")
    filters(s)
    s.set_defaults(fn=cmd_sprint)

    s = sub.add_parser("q", help="raw WIQL condition")
    filters(s, text=False)
    s.add_argument("-O", "--order", help="ORDER BY clause, keeps WIQL order")
    s.add_argument("cond", nargs="+")
    s.set_defaults(fn=cmd_q)

    s = sub.add_parser("ask", help="fritekst → Claude → WIQL → svar")
    s.add_argument("question", nargs="+")
    s.add_argument("-m", "--model", default=MODEL)
    s.add_argument("-a", "--answer", action="store_true", help="always answer, not just list")
    s.add_argument("-l", "--list", action="store_true", help="never answer, just list")
    s.add_argument("-r", "--refresh", action="store_true", help="refetch project vocabulary")
    s.add_argument("-G", "--group", action="store_true", help="group by state")
    s.add_argument("-L", "--limit", type=int, default=LIMIT)
    s.add_argument("--wiql", action="store_true", help="print the WIQL, don't run it")
    s.set_defaults(fn=cmd_ask)

    s = sub.add_parser("triage", help="Claude proposes how to triage an item; y writes it to ADO")
    s.add_argument("id", type=int, nargs="?")
    s.add_argument("-m", "--model", default=TRIAGE_MODEL)
    s.add_argument("-r", "--rerun", action="store_true", help="ask Claude again even if a proposal is cached")
    s.add_argument("-y", "--yes", action="store_true", help="write the proposal to ADO without asking")
    s.add_argument("--save", action="store_true", help="only make and cache the proposal, print one line")
    s.add_argument("--json", action="store_true", help="print the cached record")
    s.set_defaults(fn=cmd_triage)

    s = sub.add_parser("tree", help="item and its children")
    s.add_argument("id", type=int)
    s.add_argument("-d", "--depth", type=int)
    s.add_argument("-A", "--all", action="store_true", help="include done children")
    s.set_defaults(fn=cmd_tree)

    s = sub.add_parser("show", help="one work item in full")
    s.add_argument("id", type=int)
    s.add_argument("-C", "--no-comments", action="store_true")
    s.set_defaults(fn=cmd_show)

    s = sub.add_parser("open", help="open in browser")
    s.add_argument("id", type=int)
    s.set_defaults(fn=cmd_open)

    s = sub.add_parser("help", help="forklaring av kommandoer og filtre")
    s.add_argument("topic", nargs="?")
    s.set_defaults(fn=lambda a: cmd_help(a, sub.choices))

    argv = sys.argv[1:]
    if not argv or argv[0] not in sub.choices and argv[0] not in ("-h", "--help"):
        argv = ["mine"] + argv
    a = p.parse_args(argv)
    A()
    try:
        a.fn(a)
    except KeyboardInterrupt:
        sys.exit(130)


if __name__ == "__main__":
    main()
