#!/bin/bash
#
# workday — the day's end and start, as notes Claude writes from what happened.
#
#   workday end [-t HH:MM] [-f <fokus>] [-n <neste>]
#                                           stop fleet and tower, prune finished agents and
#                                           worktrees, then write today's note: my own lines
#                                           (what I focused on, where I stopped) and a summary
#                                           of today's commits, unfinished worktrees and agents
#   workday plan [--fresh]                  how to attack today: the last note, fleet's list
#                                           (fleet ls) and my teams' standup, through Claude;
#                                           written once a day, --fresh writes it again
#   workday last                            the last note
#   workday start [HH:MM]                   log that the day starts, now or at HH:MM (end logs
#                                           its own end, -t the same way), and start a
#                                           background agent (workday-jobber-<date>, once a
#                                           day) that sums up how my launchd jobs went
#   workday times                           start, end and hours per day
#   workday logg <dato> <HH:MM> [<HH:MM>]   log start (and end) of another day, to fill in or
#                                           correct one
#   workday fri <dato>[..<dato>] [type]     a day off: ferie (default), syk, avspasering, or
#                                           ingen to take it back
#   workday saldo [--json]                  the time account: hours worked minus the norm,
#                                           per day and in all
#
# Notes live in iCloud, Documents/visense/workday: <date>.md (end, kept for good: the log of my
# work) and plan-<date>.md (plan, kept 7 days). Each is written whole at the end, so a reader can wait for the file to change. The Raycast
# extension (raycast/visense) runs end and plan detached and shows the files. times.tsv (time,
# start|end, or a day off at 00:00) is kept for good; the end note shows the day's hours and the
# saldo from it. A day's last start, end and day off count, so logging again corrects it.
#
# Saldo (the saldo_* settings below): from saldo_fra with balance 0, each weekday's norm is
# saldo_norm minutes; holidays, ferie and syk have none, avspasering keeps it. A day longer
# than 5:30 has saldo_lunsj minutes of lunch taken off. Weekdays without start and end (today
# aside) are flagged, not counted.

# Raycast runs with a bare PATH; claude lives in ~/.local/bin, az/uv in Homebrew.
export PATH="$HOME/.local/bin:$HOME/.dotfiles/bin:/opt/homebrew/bin:$PATH"

dir="$HOME/Library/Mobile Documents/com~apple~CloudDocs/Documents/visense/workday"
root="$HOME/visense"
day=$(date +%F)
mkdir -p "$dir"
# A plan is for its day; a week of them is enough.
find "$dir" -name 'plan-*.md' -mtime +7 -delete

die() { echo "workday: $*" >&2; exit 1; }

# The newest end note, today's included.
last() { ls "$dir"/????-??-??.md 2>/dev/null | tail -1; }

times="$dir/times.tsv"
saldo_fra=2026-10-27
saldo_norm=480
saldo_lunsj=30

hhmm() { [[ $1 =~ ^([01][0-9]|2[0-3]):[0-5][0-9]$ ]] || die "ugyldig tid: $1 (HH:MM)"; }
dato() { [[ $(date -j -f %F "$1" +%F 2>/dev/null) == "$1" ]] || die "ugyldig dato: $1 (ÅÅÅÅ-MM-DD)"; }

# stamp start|end [HH:MM] [dato]: now, or at HH:MM, today or on dato.
stamp() {
  local t=$(date +%T)
  if [[ -n $2 ]]; then
    hhmm "$2"
    t=$2:00
  fi
  printf '%sT%s\t%s\n' "${3:-$day}" "$t" "$1" >>"$times"
}

cmd_logg() {
  [[ -n $1 && -n $2 ]] || die "bruk: workday logg <dato> <HH:MM> [<HH:MM>]"
  dato "$1"
  hhmm "$2"
  [[ -z $3 ]] || hhmm "$3"
  stamp start "$2" "$1"
  [[ -z $3 ]] || stamp end "$3" "$1"
}

cmd_fri() {
  local fra=${1%%..*} til=${1##*..} type=${2:-ferie}
  [[ -n $1 ]] || die "bruk: workday fri <dato>[..<dato>] [ferie|syk|avspasering|ingen]"
  [[ $type =~ ^(ferie|syk|avspasering|ingen)$ ]] || die "ukjent type: $type (ferie, syk, avspasering, ingen)"
  dato "$fra"
  dato "$til"
  [[ $til < $fra ]] && die "$til er før $fra"
  local d=$fra
  while [[ ! $d > $til ]]; do
    printf '%sT00:00:00\t%s\n' "$d" "$type" >>"$times"
    d=$(date -j -v+1d -f %F "$d" +%F)
  done
}

cmd_saldo() {
  [[ -s $times ]] || : >"$times"
  python3 - "$times" "$saldo_fra" "$saldo_norm" "$saldo_lunsj" "$1" <<'EOF'
import datetime as dt, json, sys

path, fra, norm, lunsj, fmt = sys.argv[1], dt.date.fromisoformat(sys.argv[2]), int(sys.argv[3]), int(sys.argv[4]), sys.argv[5]
DAYS = ["man", "tir", "ons", "tor", "fre", "lør", "søn"]

def easter(y):  # anonymous Gregorian algorithm
    a, b, c = y % 19, y // 100, y % 100
    d, e = b // 4, b % 4
    g = (8 * b + 13) // 25
    h = (19 * a + b - d - g + 15) % 30
    i, k = c // 4, c % 4
    l = (32 + 2 * e + 2 * i - h - k) % 7
    m = (a + 11 * h + 19 * l) // 433
    n = (h + l - 7 * m + 90) // 25
    return dt.date(y, n, (h + l - 7 * m + 33 * n + 19) % 32)

def holidays(y):
    e = easter(y)
    out = {dt.date(y, 1, 1): "nyttårsdag", dt.date(y, 5, 1): "1. mai", dt.date(y, 5, 17): "17. mai",
           dt.date(y, 12, 25): "1. juledag", dt.date(y, 12, 26): "2. juledag"}
    for off, name in [(-3, "skjærtorsdag"), (-2, "langfredag"), (0, "1. påskedag"), (1, "2. påskedag"),
                      (39, "Kristi himmelfartsdag"), (49, "1. pinsedag"), (50, "2. pinsedag")]:
        out[e + dt.timedelta(days=off)] = name
    return out

start, end, off = {}, {}, {}
for line in open(path, encoding="utf-8"):
    ts, _, kind = line.rstrip("\n").partition("\t")
    d, t = ts[:10], ts[11:16]
    if kind == "start":
        start[d] = t
    elif kind == "end":
        end[d] = t
    elif kind:
        off[d] = None if kind == "ingen" else kind

def mins(t):
    return int(t[:2]) * 60 + int(t[3:])

today, days, saldo, hol = dt.date.today(), [], 0, {}
d = fra
while d <= today:
    hol.setdefault(d.year, holidays(d.year))
    k = d.isoformat()
    s, e, o, h = start.get(k), end.get(k), off.get(k), hol[d.year].get(d)
    norm_d = norm if d.weekday() < 5 and not h and o not in ("ferie", "syk") else 0
    worked = None
    if s and e:
        span = mins(e) - mins(s)
        worked = span - lunsj if span > 330 else span
    if worked is not None:
        status = "ok"
    elif d == today:
        status = "pågår" if s else None
    elif norm_d and o != "avspasering":
        status = "mangler"
    else:
        status = "ok" if norm_d or o or h else None  # avspasering, or a day off on a weekday
        if status and not norm_d and d.weekday() >= 5:
            status = None
    if status:
        diff = (worked or 0) - norm_d if status == "ok" else None
        saldo += diff or 0
        days.append({"date": k, "day": DAYS[d.weekday()], "start": s, "end": e, "worked": worked,
                     "norm": norm_d, "diff": diff, "off": o, "holiday": h, "status": status})
    d += dt.timedelta(days=1)

def hm(m, sign=False):
    return ("-" if m < 0 else "+" if sign else "") + f"{abs(m) // 60}:{abs(m) % 60:02}"

if fmt == "--json":
    print(json.dumps({"saldo": saldo, "text": hm(saldo, True), "fra": fra.isoformat(), "norm": norm,
                      "lunsj": lunsj, "days": days[::-1]}, ensure_ascii=False))
    sys.exit()
print(f"Saldo {hm(saldo, True)}  (fra {fra}, {hm(norm)} per dag, {lunsj} min lunsj over 5:30)")
for x in days[::-1]:
    tider = f"{x['start'] or '?':>5} – {x['end'] or '':<5}"
    note = x["holiday"] or x["off"] or ""
    if x["status"] == "mangler":
        note = "⚠ mangler start/slutt: workday logg " + x["date"] + " HH:MM HH:MM"
    elif x["status"] == "pågår":
        note = "pågår"
    worked = hm(x["worked"]) if x["worked"] is not None else ""
    diff = hm(x["diff"], True) if x["diff"] is not None else ""
    print(f"{x['date']} {x['day']}  {tider}  {worked:>5}  {diff:>6}  {note}".rstrip())
EOF
}

# Per day: the last start, the last end and the hours between.
cmd_times() {
  [[ -s $times ]] || die "ingen tider ennå"
  awk -F'\t' '
    $2 != "start" && $2 != "end" { next }
    { d = substr($1, 1, 10); t = substr($1, 12, 5) }
    !(d in seen) { seen[d]; order[++n] = d }
    $2 == "start" { s[d] = t }
    $2 == "end" { e[d] = t }
    function min(t) { return substr(t, 1, 2) * 60 + substr(t, 4, 2) }
    END {
      for (i = 1; i <= n; i++) {
        d = order[i]; h = ""
        if ((d in s) && (d in e)) { m = min(e[d]) - min(s[d]); h = sprintf("%d:%02d", m / 60, m % 60) }
        printf "%s  %5s – %-5s  %s\n", d, (d in s) ? s[d] : "?", (d in e) ? e[d] : "", h
      }
    }' "$times"
}

# Writes stdin to $1 in one go.
put() { cat >"$1.tmp" && mv "$1.tmp" "$1"; }

facts() {
  local midnight_ms=$(($(date -j -f '%F %T' "$day 00:00:00" +%s) * 1000))
  echo "## Commits i dag, per repo/worktree (alle brancher)"
  for git in "$root"/*/.git; do
    # A .git file is a worktree of another repo, which lists it already.
    [[ -d $git ]] || continue
    repo=$(dirname "$git")
    git -C "$repo" worktree list --porcelain | sed -n 's/^worktree //p' | while read -r wt; do
      branch=$(git -C "$wt" branch --show-current)
      dirty=$(git -C "$wt" status --porcelain | wc -l | tr -d ' ')
      track=
      [[ -n $branch ]] && track=$(git -C "$wt" for-each-ref --format='%(upstream:track)' "refs/heads/$branch")
      log=$(git -C "$wt" log --since=midnight --author="$(git -C "$wt" config user.email)" --format='  - %s' HEAD)
      # Only today's work, uncommitted files or unpushed commits; behind or [gone] alone is not left over.
      [[ -z $log && $dirty == 0 && $track != *ahead* ]] && continue
      echo "### ${wt#"$root"/} ($branch) · ${dirty} uncommitted filer ${track:+· $track}"
      echo "$log"
    done
  done
  echo
  echo "## Claude-agenter: startet i dag, eller blocked/running"
  claude agents --json --all 2>/dev/null |
    jq -r --argjson t "$midnight_ms" \
      '.[] | select(.startedAt >= $t or .state == "blocked" or .state == "running") | "- \(.name) · \(.state) · \(.cwd)"'
}

cmd_end() {
  local fokus= neste= tid=
  while getopts t:f:n: o; do
    case $o in
      t) tid=$OPTARG ;;
      f) fokus=$OPTARG ;;
      n) neste=$OPTARG ;;
      *) die "bruk: workday end [-t HH:MM] [-f <fokus>] [-n <neste>]" ;;
    esac
  done
  stamp end "$tid"

  # fleet's caffeinate is tied to its pid (-w), so it ends with fleet.
  pkill -TERM -f "$HOME/.dotfiles/bin/fleet"
  pkill -TERM -f "$HOME/.dotfiles/bin/tower"
  fleet prune >/dev/null 2>&1
  fleet clean >/dev/null 2>&1

  local mine=
  [[ -n $fokus ]] && mine+="### Fokus i dag"$'\n'"$fokus"$'\n\n'
  [[ -n $neste ]] && mine+="### Hvor jeg slapp / neste steg"$'\n'"$neste"$'\n\n'

  local data summary prompt
  data=$(facts)
  prompt="Under er rådata fra arbeidsdagen min ($day), og det jeg selv skrev om dagen. Skriv en kort \
oppsummering på norsk i Markdown som lar meg fortsette der jeg slapp: 1) hva jeg fikk gjort, \
2) hva som er halvferdig og hvor (repo, branch, worktree, agent som er blocked/running, \
uncommitted/upushet). Det jeg skrev selv veier tyngst; uncommitted filer alene på main/master \
er som regel støy. Bare fakta, ingen innledning, ingen overskrift på toppnivå, maks ~20 linjer."
  summary=$(claude -p --model sonnet "$prompt" <<<"${mine:+# Det jeg skrev
$mine}# Rådata
$data" 2>/dev/null) || summary=$data

  {
    echo "# $day"
    echo
    cmd_times | awk -v d="$day" '$1 == d { sub(/^[^ ]+ +/, ""); print "Arbeidstid: " $0 }'
    cmd_saldo | head -1
    echo
    [[ -n $mine ]] && printf '## Mine notater\n\n%s' "$mine"
    echo "## Oppsummering"
    echo
    echo "$summary"
  } | put "$dir/$day.md"
  cat "$dir/$day.md"
}

# A background agent sums up my launchd jobs (chores status), on haiku since reading a status
# needs no more; once a day, so a second start doesn't spawn another. Its output is closed, so
# Raycast's execFileSync doesn't wait for it.
cmd_jobs() {
  local name="workday-jobber-$day"
  claude agents --json --all 2>/dev/null | jq -e --arg n "$name" 'any(.[]; .name == $n)' >/dev/null && return
  local prompt="Kjør \`chores status\` (og \`chores status <jobb>\` for jobber som ikke er ✓) og oppsummer \
kort på norsk hvordan launchd-jobbene mine har gått siden forrige arbeidsdag: hva som kjørte, hva som \
feilet, er forfalt eller trenger meg, og for hver av dem hva jeg bør gjøre (konkret kommando). \
Ikke kjør jobbene og ikke endre noe. Alt ✓: én linje."
  (cd "$HOME/.dotfiles" && claude --dangerously-skip-permissions --bg --model haiku -n "$name" "$prompt" >/dev/null 2>&1 &)
}

cmd_plan() {
  local out="$dir/plan-$day.md"
  if [[ $1 != --fresh && -s $out ]]; then
    cat "$out"
    return
  fi

  local note tmp
  note=$(last)
  tmp=$(mktemp -d)
  # fleet ls refreshes state.json too; when ADO is unreachable, its last list is better than none.
  { fleet ls 2>/dev/null || cat "$HOME/.cache/fleet/screen.txt" 2>/dev/null; } >"$tmp/fleet" &
  standup 2>/dev/null >"$tmp/standup" &
  wait

  local prompt="I dag er $(LC_TIME=nb_NO.UTF-8 date '+%A %F'). Under er notatet fra forrige arbeidsdag \
(mine egne linjer og en oppsummering), fleet-lista mi (work items, PRer jeg skal reviewe, mine PRer, \
agenter) og teamenes standup. Foreslå på norsk i Markdown hvordan jeg bør angripe dagen: \
først det som blokkerer andre eller haster (agenter som venter på meg, mine PRer med konflikt/feil, \
reviews som har ventet), så å fortsette der jeg slapp, så resten. 3–6 punkter i rekkefølge, \
hvert med #id/!pr og ett kort hvorfor, og første konkrete handling (gjerne en fleet-kommando). \
Ingen innledning, ingen overskrift på toppnivå, maks ~25 linjer."
  {
    echo "# Notat fra forrige arbeidsdag"
    if [[ -n $note ]]; then cat "$note"; else echo "(ingen)"; fi
    echo
    echo "# fleet"
    cat "$tmp/fleet"
    echo
    echo "# Standup"
    cat "$tmp/standup"
  } | claude -p --model sonnet "$prompt" 2>/dev/null | put "$out"
  rm -rf "$tmp"
  [[ -s $out ]] || { rm -f "$out"; die "claude skrev ingen plan"; }
  cat "$out"
}

case $1 in
  end) shift; cmd_end "$@" ;;
  plan) shift; cmd_plan "$@" ;;
  start) stamp start "$2"; cmd_jobs ;;
  times) cmd_times ;;
  logg) shift; cmd_logg "$@" ;;
  fri) shift; cmd_fri "$@" ;;
  saldo) cmd_saldo "$2" ;;
  last) note=$(last); [[ -n $note ]] && cat "$note" || die "ingen notater ennå" ;;
  *) awk 'NR > 2 && !/^#/ { exit } NR > 2 { sub(/^# ?/, ""); print }' "$0"; exit 1 ;;
esac
