globals().update({k: getattr(wf, k) for k in from_wf})

FILE = os.environ.get("OPS_FIGMA_FILE", "zTyL7wC1gjK5DlciwmQmQT")
BOARD = f"https://www.figma.com/board/{FILE}/Operations"
PROJECT = "Visense"
AREA = "Visense\\Operations"
ITEM = f"https://dev.azure.com/Hussoppen/{PROJECT}/_workitems/edit/"
MODEL = os.environ.get("OPS_MODEL", "haiku")
CACHE = os.path.expanduser("~/.cache/ops")
INBOX = os.path.expanduser("~/.local/state/ops/inbox.json")
DONE_DAYS = 14   # Done tiltak stay on the board this long
ADO_EVERY, FIGMA_EVERY = 60, 300  # seconds between refreshes

# The områder as the skills know them; used until the board itself has been read.
AREAS = ["Salg → Leveranse", "Support og henvendelser", "Økonomi", "Folk og kapasitet",
         "Produktoppfølging", "Risiko og annet", "Oppstart og sjekkpunkt"]
COMMIT = re.compile(r"(?i)utfall|tiltak|beslutning")  # sections whose stickies are tiltak
NOT_AREAS = re.compile(r"(?i)tiltakslogg|trafikklys")
MONTHS = {"jan": 1, "feb": 2, "mar": 3, "apr": 4, "mai": 5, "jun": 6, "jul": 7, "aug": 8,
          "sep": 9, "okt": 10, "nov": 11, "des": 12}
MONTH_NAMES = ["januar", "februar", "mars", "april", "mai", "juni", "juli", "august",
               "september", "oktober", "november", "desember"]
DAYS = ["man", "tir", "ons", "tor", "fre", "lør", "søn"]
PAGE_MONTHS = ["jan", "feb", "mars", "apr", "mai", "juni", "juli", "aug", "sept", "okt", "nov", "des"]
STUB = "Opprettet av ops før møtet"  # epic description marker: the meeting hasn't been written up yet


def die(msg):
    print(f"ops: {msg}", file=sys.stderr)
    sys.exit(1)


def today():
    return datetime.date.today()


def day(d):
    return f"{DAYS[d.weekday()]} {d.day}. {MONTH_NAMES[d.month - 1][:3]}" if d else "?"


def meeting_date(name, ref=None):
    """«Referat 4. sept» / «Referat 21.aug» / «Operations-møte 4. september 2026» → date.
    No year: this year, unless that lands more than a month ahead — then last year."""
    m = re.search(r"(\d{1,2})\.\s*([a-zæøå]{3})[a-zæøå]*\.?(?:\s+(\d{4}))?", name.lower())
    if not m or m.group(2) not in MONTHS:
        return None
    ref = ref or today()
    y = int(m.group(3)) if m.group(3) else ref.year
    try:
        d = datetime.date(y, MONTHS[m.group(2)], int(m.group(1)))
    except ValueError:
        return None
    if not m.group(3) and d > ref + datetime.timedelta(days=31):
        d = d.replace(year=y - 1)
    return d


def long_day(d):
    return f"{d.day}. {MONTH_NAMES[d.month - 1]} {d.year}"


def epic_title(d):
    return f"Operations-møte {long_day(d)}"


def cadence(d):
    """Which template a meeting date gets. Månedlig = siste fredag i måneden (STARTSIDE);
    kvartalsvis = the månedlige in mars/juni/sept/des — an assumption, the board doesn't say."""
    last = (d + datetime.timedelta(days=7)).month != d.month
    return "Kvartalsvis" if last and d.month % 3 == 0 else "Månedlig" if last else "Ukentlig"


def next_meeting(dates):
    """Weekly rytme: a week after the newest meeting, rolled forward past today."""
    if not dates:
        return None
    d = max(dates) + datetime.timedelta(days=7)
    while d < today():
        d += datetime.timedelta(days=7)
    return d


# ── figma ───────────────────────────────────────────────────────────────────

_token = None


def figma_token():
    global _token
    if _token is None:
        _token = os.environ.get("FIGMA_TOKEN") or wf.sh(
            "security", "find-generic-password", "-a", os.environ.get("USER", ""), "-s", "figma-token", "-w")
    return _token


def figma(path):
    if not figma_token():
        raise RuntimeError("ingen Figma-token — se `ops` header (FIGMA_TOKEN / keychain figma-token)")
    req = urllib.request.Request(f"https://api.figma.com/v1/{path}", headers={"X-Figma-Token": figma_token()})
    try:
        with urllib.request.urlopen(req, timeout=60) as r:
            return json.load(r)
    except urllib.error.HTTPError as e:
        try:
            msg = json.loads(e.read()).get("err")
        except ValueError:
            msg = None
        raise RuntimeError(f"Figma {e.code}: {msg or e.reason}")
    except urllib.error.URLError as e:
        raise RuntimeError(f"Figma: {e.reason}")


def page_doc(pid, version):
    """A page's node tree, cached per file version — the board changes far less often than we look."""
    path = os.path.join(CACHE, "page-" + re.sub(r"\W", "-", pid) + ".json")
    try:
        with open(path) as f:
            c = json.load(f)
        if c["version"] == version:
            return c["doc"]
    except (OSError, ValueError, KeyError):
        pass
    doc = figma(f"files/{FILE}/nodes?ids={urllib.parse.quote(pid)}")["nodes"][pid]["document"]
    os.makedirs(CACHE, exist_ok=True)
    with open(path, "w") as f:
        json.dump({"version": version, "doc": doc}, f)
    return doc


def walk(n):
    yield n
    for c in n.get("children", []):
        yield from walk(c)


def bbox(n):
    b = n.get("absoluteBoundingBox") or {}
    return b.get("x", 0), b.get("y", 0), b.get("width", 0), b.get("height", 0)


def contains(outer, inner):
    x, y, w, h = bbox(outer)
    ix, iy, iw, ih = bbox(inner)
    cx, cy = ix + iw / 2, iy + ih / 2
    return x <= cx <= x + w and y <= cy <= y + h


def chars(n):
    if n.get("characters"):
        return n["characters"]
    return " ".join(c["characters"] for c in walk(n) if c is not n and c.get("characters"))


def fill(n):
    """First visible solid fill as (r, g, b), or None."""
    for f in n.get("fills") or []:
        if f.get("type") == "SOLID" and f.get("visible", True) and "color" in f:
            c = f["color"]
            return c["r"], c["g"], c["b"]
    return None


def colour(rgb):
    """A fill → the nearest of the few colours a terminal has."""
    if not rgb:
        return "plain"
    h, l, s = colorsys.rgb_to_hls(*rgb)
    if s < 0.2 or l > 0.93:
        return "plain"
    deg = h * 360
    return ("red" if deg < 20 or deg >= 330 else "orange" if deg < 45 else "yellow" if deg < 70
            else "green" if deg < 165 else "cyan" if deg < 250 else "magenta")


def table(n):
    """TABLE node → rows of (text, fill), ordered by position."""
    cells = [c for c in n.get("children", []) if c.get("type") == "TABLE_CELL"]
    rows = {}
    for c in cells:
        x, y, _, _ = bbox(c)
        rows.setdefault(round(y), []).append((x, chars(c).strip(), fill(c)))
    return [[(t, f) for _, t, f in sorted(r)] for _, r in sorted(rows.items())]


class Board:
    """The newest referat page, read geometrically: an område is a section no other section
    contains (on this board a bolk's sub-sections are siblings inside its bounds, not children),
    a sticky's seksjon is the smallest section around it."""

    def __init__(self, page, doc, people=None, pages=()):
        self.page_id, self.page = page
        self.pages = list(pages)
        self.date = meeting_date(self.page)
        self.people = people or {}
        nodes = list(walk(doc))
        secs = [n for n in nodes if n.get("type") == "SECTION"]
        area = lambda n: bbox(n)[2] * bbox(n)[3]
        outer = [s for s in secs if not any(o is not s and area(o) > area(s) and contains(o, s) for o in secs)]
        self.areas = []
        for o in sorted(outer, key=lambda s: (bbox(s)[0], bbox(s)[1])):
            if NOT_AREAS.search(o["name"]):
                continue
            subs = sorted((s for s in secs if s is not o and contains(o, s)), key=lambda s: (bbox(s)[0], bbox(s)[1]))
            self.areas.append({"name": o["name"].strip(), "id": o["id"],
                               "secs": [{"name": "", "id": o["id"], "stickies": []}] +
                                       [{"name": s["name"].strip(), "id": s["id"], "stickies": []} for s in subs]})
        for n in nodes:
            if n.get("type") != "STICKY":
                continue
            st = {"id": n["id"], "text": chars(n).strip(), "colour": colour(fill(n)), "pos": bbox(n)[:2]}
            around = [s for s in secs if contains(s, n)]
            if not around:
                continue
            inner = min(around, key=area)
            for a in self.areas:
                for s in a["secs"]:
                    if s["id"] == inner["id"] and (s["name"] or inner["id"] == a["id"]):
                        s["stickies"].append(st)
        for a in self.areas:
            for s in a["secs"]:
                s["stickies"].sort(key=lambda st: (st["pos"][1], st["pos"][0]))
            a["secs"] = [s for s in a["secs"] if s["name"] or s["stickies"]]
        self.areas = [a for a in self.areas if a["secs"]]
        self.traffic = []
        for n in nodes:
            if n.get("type") != "TABLE":
                continue
            rows = table(n)
            near = [s for s in secs if contains(s, n)]
            if rows and (any("trafikklys" in s["name"].lower() for s in near)
                         or any(t.lower().startswith("salg") for t, _ in rows[0])):
                for i, (label, _) in enumerate(rows[0]):
                    below = [r[i] for r in rows[1:] if i < len(r)]
                    hit = next(((t, f) for t, f in below if colour(f) != "plain" or t), ("", None))
                    if label:
                        self.traffic.append((label, colour(hit[1]), hit[0]))
                break

    def find(self, area, sec=""):
        a = next((x for x in self.areas if x["name"].lower() == (area or "").lower()), None)
        if not a:
            return None, None
        s = next((x for x in a["secs"] if x["name"] and x["name"].lower() == (sec or "").lower()), None)
        return a, s

    def vocabulary(self):
        return {a["name"]: [s["name"] for s in a["secs"] if s["name"]] for a in self.areas}

    def url(self, node=None):
        return f"{BOARD}?node-id={urllib.parse.quote((node or self.page_id).replace(':', '-'))}"


def people_of(doc):
    """STARTSIDE's Representanter table → {navn: e-post}."""
    for n in walk(doc):
        if n.get("type") != "TABLE":
            continue
        rows = table(n)
        head = [t.lower() for t, _ in rows[0]] if rows else []
        if any("navn" in h for h in head) and any("post" in h for h in head):
            ni = next(i for i, h in enumerate(head) if "navn" in h)
            ei = next(i for i, h in enumerate(head) if "post" in h)
            return {r[ni][0]: r[ei][0] for r in rows[1:] if len(r) > max(ni, ei) and r[ni][0]}
    return {}


def load_board(page=None):
    f = figma(f"files/{FILE}?depth=1")
    version, pages = f["version"], [(p["id"], p["name"]) for p in f["document"]["children"]]
    referat = [p for p in pages if p[1].lower().startswith("referat")]
    if not referat:
        raise RuntimeError("ingen «Referat …»-side på boardet")
    target = next((p for p in referat if p[0] == page), referat[-1])  # appended last = newest
    start = next((p for p in pages if p[1].strip().upper() == "STARTSIDE"), None)
    people = people_of(page_doc(start[0], version)) if start else {}
    return Board(target, page_doc(target[0], version), people, referat)


# ── ado ─────────────────────────────────────────────────────────────────────

_ado = None


def A():
    global _ado
    if _ado is None:
        _ado = wf.Ado()
    return _ado


def api(path, body=None, method=None, ctype="application/json", project=PROJECT):
    """Like wf.Ado.api, but raises instead of exiting, so the TUI survives a failed call."""
    url = f"{A().org}/{urllib.parse.quote(project) + '/' if project else ''}_apis/{path}"
    url += ("&" if "?" in url else "?") + "api-version=7.1"
    data = json.dumps(body).encode() if body is not None else None
    req = urllib.request.Request(url, data=data, method=method or ("POST" if data else "GET"),
                                 headers={"Authorization": f"Bearer {A().token()}", "Content-Type": ctype})
    try:
        with urllib.request.urlopen(req, timeout=30) as r:
            return json.load(r)
    except urllib.error.HTTPError as e:
        try:
            msg = json.loads(e.read()).get("message")
        except ValueError:
            msg = None
        raise RuntimeError(f"ADO {e.code}: {msg or e.reason}")
    except urllib.error.URLError as e:
        raise RuntimeError(f"ADO: {e.reason}")


FIELDS = ["System.Id", "System.Title", "System.State", "System.WorkItemType", "System.AssignedTo",
          "System.Tags", "System.Description", "System.CreatedDate", "System.Parent",
          "Microsoft.VSTS.Scheduling.DueDate"]


def load_ado():
    """Operations Issues (open, or Done within DONE_DAYS) and the meeting epics."""
    q = ("SELECT [System.Id] FROM WorkItems WHERE [System.AreaPath] UNDER '" + AREA + "' AND ("
         "([System.WorkItemType] = 'Issue' AND ([System.State] <> 'Done' OR [System.ChangedDate] >= @Today - "
         f"{DONE_DAYS})) OR [System.WorkItemType] = 'Epic') ORDER BY [System.Id]")
    ids = [w["id"] for w in api("wit/wiql", {"query": q})["workItems"]]
    raw = []
    for i in range(0, len(ids), 200):
        raw += api("wit/workitemsbatch", {"ids": ids[i:i + 200], "fields": FIELDS})["value"]
    if not members:
        members.update(load_members())
    items, epics = [], []
    for w in raw:
        f = w["fields"]
        if f["System.WorkItemType"] == "Epic":
            epics.append({"id": f["System.Id"], "title": f["System.Title"], "date": meeting_date(f["System.Title"]),
                          "stub": STUB in (f.get("System.Description") or "")})
            continue
        if f.get("System.AssignedTo", {}).get("uniqueName"):  # people who aren't team members still get tiltak
            members.setdefault(f["System.AssignedTo"]["displayName"], f["System.AssignedTo"]["uniqueName"])
        desc = f.get("System.Description") or ""
        eier = re.search(r"Eier:\s*(?:</b>)?\s*([^<]+)", desc)
        frist = re.search(r"Frist:\s*(?:</b>)?\s*([^<]+)", desc)
        due = f.get("Microsoft.VSTS.Scheduling.DueDate")
        items.append({
            "id": f["System.Id"], "title": f["System.Title"], "state": f["System.State"],
            "who": (f.get("System.AssignedTo") or {}).get("displayName") or (eier and html.unescape(eier.group(1)).strip()) or "",
            "assigned": bool(f.get("System.AssignedTo")),
            "frist": frist and html.unescape(frist.group(1)).strip() or "",
            "tags": [t.strip() for t in (f.get("System.Tags") or "").split(";") if t.strip()],
            "due": datetime.date.fromisoformat(due[:10]) if due else None,
            "created": datetime.date.fromisoformat(f["System.CreatedDate"][:10]),
            "parent": f.get("System.Parent"),
        })
    return items, epics


members = {}  # ADO display name → uniqueName, filled by load_ado (never fetched from the UI thread)


def load_members():
    path = os.path.join(CACHE, "members.json")
    try:
        if time.time() - os.path.getmtime(path) < 86400:
            with open(path) as f:
                return json.load(f)
    except (OSError, ValueError):
        pass
    out = {}
    p = urllib.parse.quote(PROJECT)
    for t in api(f"projects/{p}/teams", project=None)["value"]:
        for m in api(f"projects/{p}/teams/{urllib.parse.quote(t['name'])}/members", project=None)["value"]:
            out[m["identity"]["displayName"]] = m["identity"]["uniqueName"]
    os.makedirs(CACHE, exist_ok=True)
    with open(path, "w") as f:
        json.dump(out, f)
    return out


def set_state(id, state):
    api(f"wit/workitems/{id}", [{"op": "add", "path": "/fields/System.State", "value": state}],
        method="PATCH", ctype="application/json-patch+json")


def ensure_epic(d, epics):
    """The meeting's epic, created as a stub when the meeting hasn't happened yet."""
    t = epic_title(d)
    hit = next((x for x in epics if x["title"] == t), None)
    if hit:
        return hit["id"]
    id = api("wit/workitems/$Epic", [
        {"op": "add", "path": "/fields/System.Title", "value": t},
        {"op": "add", "path": "/fields/System.AreaPath", "value": AREA},
        {"op": "add", "path": "/fields/System.Description",
         "value": f"{STUB} {today().isoformat()}, som forelder for innspill fra ops-innboksen. "
                  "Referatet skrives hit av /operations-referat etter møtet."}],
        ctype="application/json-patch+json")["id"]
    epics.append({"id": id, "title": t, "date": d, "stub": True})
    return id


def create_issue(e, due, people, epic=None):
    """An innboks entry → Issue, the way operations-referat writes them."""
    c = e["c"]
    email = resolve(c.get("eier", ""), people)
    now = today().isoformat()
    tags = ["operations-mote", f"rapportert:{now}"] + (["Ikke satt"] if not c.get("frist") or c["frist"] == "Ikke satt" else [])
    desc = "<br>".join(f"<b>{k}:</b> {html.escape(v)}" for k, v in [
        ("Eier", c.get("eier") or "Ikke satt"), ("Frist", c.get("frist") or "Ikke satt"),
        ("Kilde", f"ops-innboks {now}, {c['omraade']}{' › ' + c['seksjon'] if c.get('seksjon') else ''}"),
        ("Rapportert inn", now)] + ([("Innspill", e["raw"])] if e["raw"].strip() != c["tittel"].strip() else [])
        + ([("Info", c["info"])] if c.get("info") else []))
    ops = [{"op": "add", "path": "/fields/System.Title", "value": c["tittel"]},
           {"op": "add", "path": "/fields/System.AreaPath", "value": AREA},
           {"op": "add", "path": "/fields/System.Description", "value": desc},
           {"op": "add", "path": "/fields/System.Tags", "value": "; ".join(tags)}]
    if due:
        ops.append({"op": "add", "path": "/fields/Microsoft.VSTS.Scheduling.DueDate", "value": due.isoformat()})
    if email:
        ops.append({"op": "add", "path": "/fields/System.AssignedTo", "value": email})
    if epic:
        ops.append({"op": "add", "path": "/relations/-", "value": {
            "rel": "System.LinkTypes.Hierarchy-Reverse", "url": f"{A().org}/_apis/wit/workItems/{epic}"}})
    return api("wit/workitems/$Issue", ops, ctype="application/json-patch+json")["id"]


def fold(s):
    return unicodedata.normalize("NFKD", s.lower()).encode("ascii", "ignore").decode()


def resolve(eier, people):
    """First name in «Martin/Håkon» → e-post: Representanter first, then ADO members by
    display name (Håkon finds Hakon Onshuus); ambiguous or unknown → None.
    Never a guess: a tiltak on the wrong plate looks handled."""
    first = fold(re.split(r"[/,&]| og ", eier or "")[0].strip())
    if not first:
        return None
    for source in (people, members):
        hits = {e for n, e in source.items() if e and (fold(n) == first or fold(n).split()[0] == first)}
        if hits:
            return hits.pop() if len(hits) == 1 else None
    return None


# ── claude ──────────────────────────────────────────────────────────────────


def claude(system, prompt, schema, model=MODEL, tools=None):
    cmd = ["claude", "-p", "--model", model, "--no-session-persistence", "--output-format", "json",
           "--json-schema", json.dumps(schema)]
    if tools:
        cmd += ["--allowedTools", ",".join(tools)]
    else:
        cmd += ["--tools", "", "--setting-sources", ""]
    if system:
        cmd += ["--system-prompt", system]
    r = subprocess.run(cmd, input=prompt, capture_output=True, text=True)
    try:
        out = json.loads(r.stdout)
    except ValueError:
        raise RuntimeError(f"claude: {(r.stderr or r.stdout).strip()[:300]}")
    if out.get("is_error") or out.get("structured_output") is None:
        raise RuntimeError(f"claude: {str(out.get('result'))[:300]}")
    return out["structured_output"]


CLASSIFY = """Du sorterer innspill til Visense sitt ukentlige Operations-møte (FigJam-board, tiltak i Azure DevOps).

Boardet har områder, hvert med seksjoner. Seksjoner med Utfall/Tiltak/Beslutninger i navnet holder tiltak
(noen skylder noen noe: en handling med eier). Alle andre seksjoner holder notater (status, risiko, kontekst).

For innspillet:
- kind: "tiltak" hvis det er en handling noen skal gjøre, ellers "notat".
- omraade: nøyaktig ett av områdenavnene.
- seksjon: nøyaktig ett seksjonsnavn i det området. Tiltak går i områdets Utfall/Beslutninger-seksjon.
- tittel: tiltak → én konsis imperativ norsk linje som står alene ut av kontekst (ta med det identifiserende
  substantivet, f.eks. «Fylle på lager: A-100 5pk mangler»). Notat → innspillet ryddet, uten å miste fakta.
- eier: navn fra Representanter hvis innspillet nevner en person eller «jeg» (= Sander); ellers "".
  Gjett aldri en eier.
- frist: eksplisitt frist fra teksten («innen fredag», «om 2 uker»), ellers "Ikke satt".
- relatert: id-er på åpne tiltak som handler om det samme (tom liste hvis ingen).
- info: 1–3 korte setninger som gjør innspillet mer nyttig i møtet: hva det henger sammen med blant åpne tiltak,
  hva som mangler (eier? frist? tall?), eller et konkret neste steg. Ikke gjenta tittelen. Ikke dikt opp fakta."""


def classify(raw, board, items, epics):
    vocab = board.vocabulary() if board and board.areas else {a: ["Utfall"] for a in AREAS}
    people = board.people if board else {}
    nxt = next_meeting(([board.date] if board and board.date else []) + [e["date"] for e in epics if e["date"]])
    open_ = [t for t in items if t["state"] != "Done"]
    prompt = "\n".join([
        f"I dag: {day(today())} {today().isoformat()}. Neste møte: {day(nxt)} {nxt or ''}.",
        "", "Områder og seksjoner:", json.dumps(vocab, ensure_ascii=False, indent=1),
        "", "Representanter: " + (", ".join(people) or "(ukjent)"),
        "Andre i ADO: " + ", ".join(members),
        "", "Åpne tiltak:", *[f"#{t['id']} [{t['state']}] {t['title']} — {t['who'] or 'uten eier'}" for t in open_],
        "", "Innspill:", raw])
    schema = {"type": "object", "additionalProperties": False,
              "required": ["kind", "omraade", "seksjon", "tittel", "eier", "frist", "info", "relatert"],
              "properties": {
                  "kind": {"type": "string", "enum": ["tiltak", "notat"]},
                  "omraade": {"type": "string", "enum": list(vocab)},
                  "seksjon": {"type": "string"},
                  "tittel": {"type": "string"}, "eier": {"type": "string"}, "frist": {"type": "string"},
                  "info": {"type": "string"},
                  "relatert": {"type": "array", "items": {"type": "integer"}}}}
    c = claude(CLASSIFY, prompt, schema)
    c["eier"] = "" if re.fullmatch(r"[\s\"'–-]*|(?i:ingen|ukjent|ikke satt)", c["eier"]) else c["eier"].strip()
    known = {t["id"] for t in items}
    c["relatert"] = [i for i in c.get("relatert", []) if i in known]
    if c["seksjon"] not in vocab.get(c["omraade"], []):
        c["seksjon"] = default_section(vocab.get(c["omraade"], []), c["kind"])
    return c


def default_section(secs, kind):
    return next((s for s in secs if bool(COMMIT.search(s)) == (kind == "tiltak")), "")


# ── innboks ─────────────────────────────────────────────────────────────────
# Every entry: {key, at, raw, c: classification, figma: None|"kø"|<node id>|"feil: …", ado: None|<id>}


def inbox():
    try:
        with open(INBOX) as f:
            return json.load(f)
    except (OSError, ValueError):
        return []


def save(entries):
    os.makedirs(os.path.dirname(INBOX), exist_ok=True)
    tmp = INBOX + ".tmp"
    with open(tmp, "w") as f:
        json.dump(entries, f, ensure_ascii=False, indent=1)
    os.replace(tmp, INBOX)


def entry(raw, c):
    return {"key": uuid.uuid4().hex[:8], "at": datetime.datetime.now().isoformat(timespec="seconds"),
            "raw": raw, "c": c, "figma": None, "ado": None}


def sticky_text(e):
    c = e["c"]
    if c["kind"] != "tiltak":
        return c["tittel"]
    lines = [f"Ansvarlig: {c['eier']}" if c.get("eier") else "Ansvarlig: ?", c["tittel"]]
    if c.get("frist") and c["frist"] != "Ikke satt":
        lines.append(c["frist"])
    if e.get("ado"):
        lines.append(f"ADO #{e['ado']}")
    return "\n".join(lines)


# Deterministic: Claude only relays this to the use_figma tool, it never writes code.
# A sticky goes under the lowest sticky already in its section (section-relative when the
# stickies are children of the section, page-absolute when they are siblings inside it),
# and the section grows to fit.
WRITE_JS = """const items = %s;
const page = await figma.getNodeByIdAsync(%s);
await figma.setCurrentPageAsync(page);
const out = [];
for (const it of items) {
  const sec = await figma.getNodeByIdAsync(it.section);
  if (!sec) { out.push({ key: it.key, id: "", error: "fant ikke seksjonen" }); continue; }
  const sb = sec.absoluteBoundingBox;
  const within = n => { const b = n.absoluteBoundingBox; const cx = b.x + b.width / 2, cy = b.y + b.height / 2;
    return cx >= sb.x && cx <= sb.x + sb.width && cy >= sb.y && cy <= sb.y + sb.height; };
  const kids = sec.children.filter(n => n.type === "STICKY");
  const loose = page.children.filter(n => n.type === "STICKY" && within(n));
  const s = figma.createSticky();
  await figma.loadFontAsync(s.text.fontName);
  s.text.characters = it.text;
  const all = kids.concat(loose).map(n => n.absoluteBoundingBox);
  const ax = all.length ? Math.min(...all.map(b => b.x)) : sb.x + 40;
  const ay = all.length ? Math.max(...all.map(b => b.y + b.height)) + 24 : sb.y + 80;
  if (loose.length && !kids.length) { s.x = ax; s.y = ay; }
  else { sec.appendChild(s); s.x = ax - sb.x; s.y = ay - sb.y; }
  const need = ay - sb.y + s.height + 40;
  if (need > sb.height) sec.resizeWithoutConstraints(sb.width, need);
  out.push({ key: it.key, id: s.id, error: "" });
}
return out;"""

RELAY = """First call mcp__plugin_figma_figma__create_session with fileKey %s and a short task description.
Then call the Figma MCP tool use_figma (mcp__plugin_figma_figma__use_figma) exactly once, on that fileKey and
with the returned sessionId, with the JavaScript below, unchanged. It is a FigJam file. Do not write or change
any code yourself.
Return what the tool returned as `result`. If the tool is unavailable or fails, return its error message
as `error` and null as `result`.

```js
%s
```"""


def use_figma(js, schema):
    """Run fixed JS through the Figma MCP server; Claude only relays it."""
    r = claude("", RELAY % (FILE, js), {"type": "object", "required": ["result", "error"], "properties": {
        "error": {"type": "string"}, "result": {"anyOf": [schema, {"type": "null"}]}}},
        tools=["mcp__plugin_figma_figma__create_session", "mcp__plugin_figma_figma__use_figma"])
    if r.get("result") is None:
        raise RuntimeError(f"Figma-skriving: {(r.get('error') or 'ingen svar')[:200]}"
                           " (krever /mcp → figma → Authenticate i claude)")
    return r["result"]


def writable(board, force=False):
    """Stickies belong to a meeting still to come; a page whose meeting is over is closed."""
    if not force and board.date and board.date < today():
        raise RuntimeError(f"«{board.page}» er et møte som har vært — `ops ny` åpner neste møte"
                           " (`ops sync --gammel` skriver dit likevel)")
    return board


def push(entries, board):
    """Queued entries → stickies on the newest referat page, in one use_figma call."""
    todo, out = [], []
    for e in entries:
        if e["figma"] != "kø":
            continue
        a, s = board.find(e["c"]["omraade"], e["c"].get("seksjon"))
        if not a:
            e["figma"] = f"feil: fant ikke området «{e['c']['omraade']}» på {board.page}"
            continue
        todo.append({"key": e["key"], "section": (s or a)["id"], "text": sticky_text(e)})
    if not todo:
        return 0
    js = WRITE_JS % (json.dumps(todo, ensure_ascii=False), json.dumps(board.page_id))
    r = use_figma(js, {"type": "array", "items": {"type": "object", "required": ["key", "id"], "properties": {
        "key": {"type": "string"}, "id": {"type": "string"}, "error": {"type": "string"}}}})
    done = {x["key"]: x for x in r}
    for e in entries:
        x = done.get(e["key"])
        if x:
            e["figma"] = x["id"] if x.get("id") else f"feil: {x.get('error') or 'ukjent'}"
    return sum(1 for x in done.values() if x.get("id"))


# ── data snapshot ───────────────────────────────────────────────────────────


class Data:
    def __init__(self):
        self.board, self.items, self.epics = None, [], []
        self.board_err = self.ado_err = ""
        self.board_at = self.ado_at = 0.0
        self.page = None  # chosen referat page id; None = newest

    def refresh_ado(self):
        try:
            self.items, self.epics = load_ado()
            self.ado_err = ""
        except RuntimeError as e:
            self.ado_err = str(e)
        self.ado_at = time.time()

    def refresh_board(self):
        try:
            self.board = load_board(self.page)
            self.board_err = ""
        except RuntimeError as e:
            self.board_err = str(e)
        self.board_at = time.time()

    def next_meeting(self):
        return next_meeting(([self.board.date] if self.board and self.board.date else [])
                            + [e["date"] for e in self.epics if e["date"]])

    def newest_board(self):
        """Writes always target the newest referat page, whichever page is on screen."""
        if self.board and (self.page is None or (self.board.pages and self.board.pages[-1][0] == self.board.page_id)):
            return self.board
        return load_board(None)


# ── print ───────────────────────────────────────────────────────────────────


def cmd_ls(a):
    d = Data()
    d.refresh_ado()
    d.refresh_board()
    if d.board:
        b = d.board
        print(bold(f"{b.page}") + dim(f"  ({day(b.date)})  {b.url()}"))
        if b.traffic:
            print("  " + "  ".join(f"{l}: {c if c != 'plain' else '–'}" for l, c, _ in b.traffic))
        for ar in b.areas:
            print(cyan(ar["name"]))
            for s in ar["secs"]:
                if s["stickies"]:
                    print(dim(f"  {s['name'] or '–'}"))
                for st in s["stickies"]:
                    print("    • " + st["text"].replace("\n", " · "))
    else:
        print(dim(f"board: {d.board_err}"))
    if d.ado_err:
        die(d.ado_err)
    print()
    for state in ("To Do", "Doing"):
        ts = [t for t in d.items if t["state"] == state]
        print(bold(f"{state} ({len(ts)})"))
        for t in ts:
            late = t["due"] and t["due"] < today()
            print(f"  #{t['id']}  {t['title'][:70]:70}  {t['who'] or '–':18} "
                  + (red if late else dim)(f"frist {day(t['due'])}" if t["due"] else ""))
    print(dim(f"\nNeste møte: {day(d.next_meeting())}"))


def cmd_add(a):
    raw = " ".join(a.text).strip()
    if not raw:
        die("ingen tekst")
    d = Data()
    d.refresh_ado()
    d.refresh_board()
    print(dim(f"… {MODEL} kategoriserer"), file=sys.stderr)
    try:
        c = classify(raw, d.board, d.items, d.epics)
    except RuntimeError as e:
        die(str(e))
    e = entry(raw, c)
    e["figma"] = "kø" if not a.local else None
    es = inbox()
    es.append(e)
    save(es)
    print(f"{bold(c['kind'])}  {cyan(c['omraade'])} › {c['seksjon']}\n  {c['tittel']}")
    print(dim(f"  eier {c['eier'] or '–'} · frist {c['frist']}" + (f" · relatert {', '.join('#' + str(i) for i in c['relatert'])}" if c["relatert"] else "")))
    if c["info"]:
        print(dim("  " + c["info"]))
    print(dim(f"lagret i innboks ({e['key']})" + (" · i kø for boardet — `ops sync`" if e["figma"] else "")))


def cmd_sync(a):
    es = inbox()
    if not any(e["figma"] == "kø" for e in es):
        print("ingenting i kø")
        return
    try:
        b = writable(load_board(None), a.gammel)
    except RuntimeError as e:
        die(str(e))
    print(dim(f"… skriver til {b.page} via Figma-MCP"), file=sys.stderr)
    try:
        n = push(es, b)
    except RuntimeError as e:
        die(str(e))
    finally:
        save(es)
    print(f"{n} sticky(er) skrevet til {b.page}")
    for e in es:
        if str(e["figma"]).startswith("feil"):
            print(red(f"  {e['c']['tittel'][:60]}: {e['figma']}"))


# ── ny ──────────────────────────────────────────────────────────────────────
# The same steps as /operations-nytt-referat, deterministic: clone the template page (it
# lands last, which is how everything finds the newest referat), then clone the previous
# page's tiltakslogg bolk onto it and refill its table from ADO.

CLONE_PAGE_JS = """const tpl = await figma.getNodeByIdAsync(%s);
await figma.setCurrentPageAsync(tpl);
const page = tpl.clone();
page.name = %s;
return { page: page.id, last: figma.root.children.indexOf(page) === figma.root.children.length - 1 };"""

# A bolk is not a container: the section, its texts and the table are page children inside
# its bounds, so they are cloned one by one at the same position.
TILTAKSLOGG_JS = """const ids = %s, rows = %s, sub = %s, tname = %s;
const dst = await figma.getNodeByIdAsync(%s);
await figma.setCurrentPageAsync(dst);
const load = async t => { const n = t.characters.length;
  for (const f of (n ? t.getRangeAllFontNames(0, n) : [t.fontName])) await figma.loadFontAsync(f); };
let table = null;
for (const id of ids) {
  const src = await figma.getNodeByIdAsync(id);
  const c = src.clone();
  dst.appendChild(c);
  c.x = src.x; c.y = src.y;
  if (c.type === "TABLE") table = c;
  if (c.type === "TEXT" && c.name === "Undertittel") { await load(c); c.characters = sub; }
}
if (!table) return { table: "", rows: 0, error: "fant ingen tabell i tiltaksloggen" };
table.name = tname;
const pat = table.numRows > 2 ? [table.cellAt(1, 0).fills, table.cellAt(2, 0).fills] : null;
while (table.numRows > rows.length + 1 && table.numRows > 2) table.removeRow(table.numRows - 1);
while (table.numRows < rows.length + 1) table.insertRow(table.numRows);
for (let i = 0; i < rows.length; i++) {
  for (let j = 0; j < 3; j++) {
    const cell = table.cellAt(i + 1, j);
    await load(cell.text);
    cell.text.characters = rows[i][j] || " ";
    if (j < 2) cell.text.hyperlink = { type: "URL", value: rows[i][3] };
    if (pat) cell.fills = pat[i %% 2];
  }
}
const probe = table.numRows > 1 ? table.cellAt(1, 1).text : null;
return { table: table.id, rows: table.numRows, error: "",
         probe: probe ? probe.characters + " → " + JSON.stringify(probe.hyperlink) : "" };"""


def cmd_ny(a):
    try:
        f = figma(f"files/{FILE}?depth=1")
        items, epics = load_ado()
    except RuntimeError as e:
        die(str(e))
    version, pages = f["version"], [(p["id"], p["name"]) for p in f["document"]["children"]]
    referat = [(i, n, meeting_date(n)) for i, n in pages if n.lower().startswith("referat")]
    dated = [r for r in referat if r[2]]
    if not dated:
        die("ingen daterte «Referat …»-sider å regne ut fra")
    newest = referat[-1]
    warn = []
    if a.dato:
        d = meeting_date(a.dato)
        if not d:
            die(f"skjønner ikke datoen «{a.dato}» — skriv f.eks. «23. okt»")
    else:
        wds = [r[2].weekday() for r in dated]
        wd = max(set(wds), key=wds.count)  # the weekday the pages agree on
        d = (newest[2] or max(r[2] for r in dated)) + datetime.timedelta(days=1)
        while d.weekday() != wd:
            d += datetime.timedelta(days=1)
        if d < today():
            skipped = d
            while d < today():
                d += datetime.timedelta(days=7)
            warn.append(f"ingen side for {day(skipped)}" + (f"–{day(d - datetime.timedelta(days=7))}"
                        if d - skipped > datetime.timedelta(days=7) else "") + " — møte uten referat?")
    if any(r[2] == d for r in referat):
        die(f"«{next(r[1] for r in referat if r[2] == d)}» finnes allerede")
    kind = cadence(d)
    tpl = next((p for p in pages if p[1].strip().lower() == kind.lower()), None)
    if not tpl:
        die(f"fant ikke malen «{kind}»")
    name = f"Referat {d.day}. {PAGE_MONTHS[d.month - 1]}"

    weekly = next((p for p in pages if p[1].strip().lower() == "ukentlig"), None)
    extra = []
    if kind != "Ukentlig" and weekly:
        base = {n["name"] for n in page_doc(weekly[0], version)["children"] if n["type"] == "SECTION"}
        extra = [n["name"] for n in page_doc(tpl[0], version)["children"] if n["type"] == "SECTION" and n["name"] not in base]
        if not extra:
            warn.append(f"malen «{kind}» er fortsatt en kopi av Ukentlig")
        start = next((p for p in pages if p[1].strip().upper() == "STARTSIDE"), None)
        text = " ".join(chars(n) for n in walk(page_doc(start[0], version))) if start else ""
        q = (d.month - 1) // 3 + 1
        if not re.search(rf"Mål Q{q} {d.year}", text):
            warn.append(f"Mål Q{q} {d.year} står ikke på STARTSIDE — ingenting å måle mot")
        if "salgstall" not in text.lower():
            warn.append("Salgstall er ikke definert på STARTSIDE — avklar i møtet")
        if kind == "Kvartalsvis":
            warn.append("kvartalsregelen (siste fredag i mars/juni/sept/des) er antatt, står ikke på STARTSIDE")

    if newest[2]:
        ep = next((e for e in epics if e["date"] == newest[2]), None)
        if not ep or ep["stub"]:
            warn.append(f"«{newest[1]}» er ikke behandlet ({'bare stub-' if ep else 'ingen '}epic) — tiltakene derfra"
                        " mangler i ADO; kjør /operations-referat på den først")

    open_ = sorted((t for t in items if t["state"] != "Done"), key=lambda t: t["id"])
    rows = [[str(t["id"]), t["title"], t["who"], f"{ITEM}{t['id']}"] for t in open_]
    doc = page_doc(newest[0], version)
    log = next((n for n in doc["children"] if n["type"] == "SECTION" and "tiltakslogg" in n["name"].lower()), None)
    ids, sub = [], ""
    if log:
        ids = [n["id"] for n in doc["children"] if n is log or contains(log, n)]
        old = next((chars(n) for n in doc["children"] if n["type"] == "TEXT" and n["name"] == "Undertittel" and contains(log, n)), "")
        sub = re.sub(r"per \d{1,2}\.\s*\w+ \d{4}", f"per {long_day(d)}", old)
    else:
        warn.append(f"ingen tiltakslogg på «{newest[1]}» å klone — siden får ingen")

    states = {s: sum(1 for t in open_ if t["state"] == s) for s in ("To Do", "Doing")}
    print(f"Neste møte: {bold(day(d) + ' ' + str(d.year))}  ({kind.lower()})")
    print(f"Ny side:    «{name}», duplisert fra malen «{tpl[1]}»" + (f" (+ {', '.join(extra)})" if extra else ""))
    if log:
        print(f"Tiltakslogg: {len(open_)} åpne tiltak ({states['To Do']} To Do, {states['Doing']} Doing)"
              + (f", eldste #{open_[0]['id']} fra {day(open_[0]['created'])}" if open_ else ""))
    for w in warn:
        print(yellow(f"  ! {w}"))
    if not a.yes:
        if not sys.stdin.isatty():
            die("boardet er delt — bekreft med -y når det ikke er en terminal")
        if input("Opprett siden? [j/N] ").strip().lower() not in ("j", "ja", "y", "yes"):
            print("avbrutt")
            return

    print(dim("… kloner malen via Figma-MCP"), file=sys.stderr)
    try:
        r = use_figma(CLONE_PAGE_JS % (json.dumps(tpl[0]), json.dumps(name)), {
            "type": "object", "required": ["page", "last"],
            "properties": {"page": {"type": "string"}, "last": {"type": "boolean"}}})
    except RuntimeError as e:
        die(str(e))
    pid = r["page"]
    url = f"{BOARD}?node-id={pid.replace(':', '-')}"
    print(f"Opprettet «{name}» ({kind.lower()})\n  {url}")
    if not r["last"]:
        print(red("  ! siden havnet ikke sist — flytt den sist, ellers finner ops og skillene feil side"))
    if not ids:
        return
    print(dim(f"… fyller tiltaksloggen ({len(rows)} rader)"), file=sys.stderr)
    try:
        t = use_figma(TILTAKSLOGG_JS % (json.dumps(ids), json.dumps(rows, ensure_ascii=False),
                                        json.dumps(sub, ensure_ascii=False),
                                        json.dumps(f"Tiltakslogg {d.day}. {PAGE_MONTHS[d.month - 1]}"),
                                        json.dumps(pid)), {
            "type": "object", "required": ["table", "rows", "error"],
            "properties": {"table": {"type": "string"}, "rows": {"type": "integer"},
                           "error": {"type": "string"}, "probe": {"type": "string"}}})
    except RuntimeError as e:
        die(f"siden finnes, men tiltaksloggen feilet: {e}")
    if t["error"] or t["rows"] != len(rows) + 1:
        got = t["error"] or f"{t['rows']} rader, ventet {len(rows) + 1}"
        print(red(f"  ! tiltakslogg: {got}"))
    else:
        print(f"Tiltakslogg: {len(rows)} åpne tiltak ført videre" + dim(f"  ({t.get('probe', '')[:90]})"))
    unowned = [f"#{x['id']}" for x in open_ if not x["assigned"]]
    if unowned:
        print(dim(f"  uten ansvarlig i ADO: {', '.join(unowned)}"))


# ── tui ─────────────────────────────────────────────────────────────────────


def wrap(text, w):
    out = []
    for para in (text or "").split("\n"):
        out += textwrap.wrap(para, max(4, w)) or [""]
    return out


def tui(scr, a):
    curses.curs_set(0)
    curses.use_default_colors()
    pal = {}
    for i, (name, col) in enumerate([("green", curses.COLOR_GREEN), ("red", curses.COLOR_RED),
                                     ("yellow", curses.COLOR_YELLOW), ("cyan", curses.COLOR_CYAN),
                                     ("magenta", curses.COLOR_MAGENTA), ("blue", curses.COLOR_BLUE)], 1):
        curses.init_pair(i, col, -1)
        pal[name] = curses.color_pair(i)
    orange = 208 if curses.COLORS >= 256 else curses.COLOR_RED
    curses.init_pair(7, orange, -1)
    pal.update(orange=curses.color_pair(7), plain=0, dim=curses.A_DIM, bold=curses.A_BOLD)
    scr.timeout(250)

    def put(y, x, txt, n, attr=0):
        if n <= 0:
            return
        try:
            scr.addnstr(y, x, re.sub(r"[\x00-\x1f\x7f]", " ", txt), n, attr)
        except curses.error:
            pass

    d = Data()
    es = inbox()
    lock = threading.Lock()
    view, col, row, colscroll = 0, 0, {}, 0
    msg, err, busy = "", False, ""
    edit = None      # [label, text, fn(text)]
    ask = None       # (question, fn)
    draft = None     # entry awaiting a decision
    detail = None    # lines of the open details box
    wake = threading.Event()

    def note(m, e=False):
        nonlocal msg, err
        msg, err = m, e

    def act(label, fn):
        """fn runs off the UI thread; its return is the message."""
        nonlocal busy

        def run():
            nonlocal busy
            try:
                r = fn()
                if r:
                    note(r)
            except RuntimeError as e:
                note(str(e), True)
            finally:
                busy = ""
        busy = label
        threading.Thread(target=run, daemon=True).start()

    def loader():
        while True:
            if time.time() - d.ado_at > ADO_EVERY:
                d.refresh_ado()
            if time.time() - d.board_at > FIGMA_EVERY:
                d.refresh_board()
            wake.wait(5)
            wake.clear()

    threading.Thread(target=loader, daemon=True).start()

    def persist():
        with lock:
            save(es)

    # ── cards: every view is columns of cards {lines: [(text, attr)], bar, ref} ──

    def board_cols(cw):
        b = d.board
        if not b:
            return [("Board", [{"lines": [(d.board_err or "henter board …", pal["dim"])], "bar": pal["dim"], "ref": None}])]
        cols = []
        for ar in b.areas:
            cards = []
            for s in ar["secs"]:
                if s["name"]:
                    cards.append({"head": s["name"], "commit": bool(COMMIT.search(s["name"]))})
                for st in s["stickies"]:
                    cards.append({"lines": [(t, 0) for t in wrap(st["text"], cw - 3)],
                                  "bar": pal.get(st["colour"], 0) | curses.A_BOLD, "ref": ("sticky", st, ar, s)})
                for e in es:
                    if (e["figma"] == "kø" or str(e["figma"]).startswith("feil")) \
                            and e["c"]["omraade"] == ar["name"] and (e["c"].get("seksjon") or "") == s["name"]:
                        cards.append({"lines": [(t, pal["dim"]) for t in wrap("⇡ " + sticky_text(e), cw - 3)],
                                      "bar": pal["red" if e["figma"] != "kø" else "dim"], "ref": ("entry", e)})
            cols.append((ar["name"], cards))
        return cols

    def item_card(t, cw):
        late = t["due"] and t["due"] < today() and t["state"] != "Done"
        sub = " · ".join(x for x in [t["who"] or "uten eier", f"due {day(t['due'])}" if t["due"] else "",
                                     f"fra {day(t['created'])}"] if x)
        bar = pal["red"] if late else {"Doing": pal["yellow"], "Done": pal["green"]}.get(t["state"], pal["cyan"])
        return {"lines": [(x, pal["dim"] if t["state"] == "Done" else 0) for x in wrap(f"#{t['id']} {t['title']}", cw - 3)]
                         + [(x, pal["red"] if late else pal["dim"]) for x in wrap(sub, cw - 3)],
                "bar": bar | curses.A_BOLD, "ref": ("item", t)}

    def item_cols(cw):
        if d.ado_err and not d.items:
            return [("Tiltak", [{"lines": [(d.ado_err, pal["red"])], "bar": pal["red"], "ref": None}])]
        cols = []
        for state in ("To Do", "Doing", "Done"):
            ts = [t for t in d.items if t["state"] == state]
            ts.sort(key=lambda t: (t["due"] or datetime.date.max, t["id"]) if state != "Done" else (-t["id"],))
            cols.append((f"{state} ({len(ts)})", [item_card(t, cw) for t in ts]))
        return cols

    def entry_card(e, cw):
        c = e["c"]
        status = ("⇡ i kø for board" if e["figma"] == "kø" else str(e["figma"]) if str(e["figma"]).startswith("feil")
                  else "✓ på board" if e["figma"] else "lokal")
        status += f" · ADO #{e['ado']}" if e["ado"] else ""
        rel = ", ".join(f"#{i}" for i in c.get("relatert", []))
        lines = [(x, curses.A_BOLD) for x in wrap(c["tittel"], cw - 3)]
        lines += [(f"{c['kind']} · {c['omraade']} › {c.get('seksjon') or '–'}", pal["cyan"])]
        lines += [(x, pal["dim"]) for x in wrap(" · ".join(y for y in [
            f"eier {c['eier']}" if c.get("eier") else "", f"frist {c['frist']}" if c.get("frist") else "",
            f"relatert {rel}" if rel else ""] if y), cw - 3)]
        lines += [(x, pal["dim"]) for x in wrap(c.get("info", ""), cw - 3)]
        lines += [(f"{status} · {e['at'][:16].replace('T', ' ')}", pal["red"] if status.startswith("feil") else pal["green"] if "✓" in status else pal["yellow"])]
        return {"lines": lines, "bar": pal["magenta"] | curses.A_BOLD, "ref": ("entry", e)}

    def inbox_cols(cw):
        return [(f"Innboks ({len(es)})", [entry_card(e, cw) for e in reversed(es)] or
                 [{"lines": [("tomt — n for nytt innspill", pal["dim"])], "bar": pal["dim"], "ref": None}])]

    def columns(w):
        if view == 2:
            return inbox_cols(min(w - 2, 100)), min(w - 2, 100)
        n = len(d.board.areas) if view == 0 and d.board else 3
        per = max(1, min(n, w // 30))
        cw = max(20, (w - 1) // per)
        return (board_cols if view == 0 else item_cols)(cw), cw

    def selected(cols):
        if not cols:
            return None
        c = min(col, len(cols) - 1)
        cards = [x for x in cols[c][1] if "head" not in x and x.get("ref")]
        if not cards:
            return None
        return cards[min(row.get((view, c), 0), len(cards) - 1)]

    def draw_cols(cols, cw, y0, h, w):
        nonlocal colscroll
        per = max(1, w // cw)
        c = min(col, len(cols) - 1)
        if c < colscroll:
            colscroll = c
        if c >= colscroll + per:
            colscroll = c - per + 1
        colscroll = max(0, min(colscroll, max(0, len(cols) - per)))
        for i, (name, cards) in enumerate(cols[colscroll:colscroll + per]):
            ci = colscroll + i
            x = i * cw
            cur = ci == c
            put(y0, x, f" {name} "[:cw - 1], cw - 1, (curses.A_REVERSE if cur else 0) | curses.A_BOLD | pal["cyan"])
            # layout, then scroll so the selected card is visible
            lines, k, want = [], 0, min(row.get((view, ci), 0), max(0, sum(1 for x in cards if "head" not in x and x.get("ref")) - 1))
            sel_top = sel_bot = 0
            for card in cards:
                if "head" in card:
                    lines.append((f"─ {card['head']} ", pal["yellow"] if card["commit"] else pal["dim"], None, False))
                    continue
                is_sel = cur and card.get("ref") and k == want
                if is_sel:
                    sel_top = len(lines)
                for j, (t, at) in enumerate(card["lines"]):
                    lines.append((t, at, card["bar"], is_sel))
                if is_sel:
                    sel_bot = len(lines)
                lines.append(("", 0, None, False))
                if card.get("ref"):
                    k += 1
            room = h - 1
            top = 0
            if cur and sel_bot > room:
                top = min(sel_top, sel_bot - room)
            for j, (t, at, bar, is_sel) in enumerate(lines[top:top + room]):
                yy = y0 + 1 + j
                if bar is not None:
                    put(yy, x, "▌", 1, bar)
                    put(yy, x + 2, t.ljust(cw - 3) if is_sel else t, cw - 3, at | (curses.A_REVERSE if is_sel else 0))
                else:
                    put(yy, x, (t + "─" * cw)[:cw - 1] if t else "", cw - 1, at)
            if top + room < len(lines):
                put(y0 + h - 1, x + cw - 3, "↓", 1, pal["dim"])

    def draw_box(lines, title, h, w):
        bw = min(w - 4, 90)
        body = []
        for t, at in lines:
            body += [(x, at) for x in wrap(t, bw - 4)]
        bh = min(h - 4, len(body) + 3)
        y0, x0 = max(1, (h - bh) // 2), (w - bw) // 2
        for j in range(bh):
            put(y0 + j, x0, " " * bw, bw, 0)
        put(y0, x0, "┌" + "─" * (bw - 2) + "┐", bw, pal["cyan"])
        put(y0, x0 + 2, f" {title} ", bw - 4, pal["cyan"] | curses.A_BOLD)
        for j in range(1, bh - 1):
            put(y0 + j, x0, "│", 1, pal["cyan"])
            put(y0 + j, x0 + bw - 1, "│", 1, pal["cyan"])
        put(y0 + bh - 1, x0, "└" + "─" * (bw - 2) + "┘", bw, pal["cyan"])
        for j, (t, at) in enumerate(body[:bh - 2]):
            put(y0 + 1 + j, x0 + 2, t, bw - 4, at)

    def draft_lines(e):
        c = e["c"]
        people = d.board.people if d.board else {}
        email = resolve(c.get("eier"), people)
        rel = [t for t in d.items if t["id"] in c.get("relatert", [])]
        return ([(c["tittel"], curses.A_BOLD), ("", 0),
                 (f"type     {c['kind']}", pal["yellow"] if c["kind"] == "tiltak" else 0),
                 (f"område   {c['omraade']} › {c.get('seksjon') or '–'}", pal["cyan"]),
                 (f"eier     {c.get('eier') or '–'}" + (f"  ({email})" if email else "  (ingen ADO-match)" if c.get("eier") else ""), 0),
                 (f"frist    {c.get('frist') or '–'}", 0)]
                + ([("", 0), ("info     " + c["info"], pal["green"])] if c.get("info") else [])
                + ([("", 0), ("relatert", pal["dim"])] + [(f"  #{t['id']} {t['title']} ({t['state']}, {t['who'] or '–'})", pal["dim"]) for t in rel] if rel else [])
                + [("", 0), ("innspill " + e["raw"], pal["dim"]), ("", 0),
                   ("enter lagre + kø til board · a + ADO-issue · l bare lokalt · t type · o/O område · u seksjon · e rediger · esc forkast", pal["yellow"])])

    def detail_of(ref):
        kind = ref[0]
        if kind == "sticky":
            _, st, ar, s = ref
            return f"{ar['name']} › {s['name'] or '–'}", [(st["text"], 0), ("", 0), ("o åpne i Figma", pal["dim"])]
        if kind == "item":
            t = ref[1]
            return f"#{t['id']} · {t['state']}", [
                (t["title"], curses.A_BOLD), ("", 0),
                (f"eier     {t['who'] or '–'}" + ("" if t["assigned"] or not t["who"] else "  (ikke tildelt i ADO)"), 0),
                (f"frist    {t['frist'] or '–'} · due {day(t['due'])}", 0),
                (f"opprettet {day(t['created'])}" + (f" · epic #{t['parent']}" if t["parent"] else ""), 0),
                (f"tags     {', '.join(t['tags'])}", pal["dim"]), ("", 0),
                ("o åpne i ADO · > neste state · < forrige", pal["dim"])]
        e = ref[1]
        return "Innspill", draft_lines(e)[:-1] + [("o åpne · f kø til board · a ADO-issue · x slett", pal["dim"])]

    def cycle_area(e, step):
        vocab = d.board.vocabulary() if d.board and d.board.areas else {x: ["Utfall"] for x in AREAS}
        names = list(vocab)
        i = names.index(e["c"]["omraade"]) if e["c"]["omraade"] in names else -1
        e["c"]["omraade"] = names[(i + step) % len(names)]
        e["c"]["seksjon"] = default_section(vocab[e["c"]["omraade"]], e["c"]["kind"])

    def cycle_section(e):
        vocab = d.board.vocabulary() if d.board and d.board.areas else {x: ["Utfall"] for x in AREAS}
        secs = vocab.get(e["c"]["omraade"], [])
        if secs:
            i = secs.index(e["c"]["seksjon"]) if e["c"].get("seksjon") in secs else -1
            e["c"]["seksjon"] = secs[(i + 1) % len(secs)]

    def classify_bg(raw):
        nonlocal draft

        def run():
            nonlocal draft
            draft = entry(raw, classify(raw, d.board, d.items, d.epics))
        act(f"{MODEL} kategoriserer …", run)

    def keep(e, queue=True):
        e["figma"] = "kø" if queue else e["figma"]
        with lock:
            if e not in es:
                es.append(e)
        persist()

    def make_issue(e):
        def run():
            due = d.next_meeting()
            epic = ensure_epic(due, d.epics) if due else None
            id = create_issue(e, due, d.board.people if d.board else {}, epic)
            e["ado"] = id
            persist()
            d.refresh_ado()
            return f"opprettet #{id} — {ITEM}{id}"
        who = resolve(e["c"].get("eier"), d.board.people if d.board else {})
        return (f"Opprett ADO Issue «{e['c']['tittel'][:50]}» → {who or 'uten assignee'}, due {day(d.next_meeting())},"
                f" under «{epic_title(d.next_meeting()) if d.next_meeting() else '–'}»?",
                lambda: act("oppretter i ADO …", run))

    def sync():
        def run():
            b = writable(d.newest_board())
            n = push(es, b)
            persist()
            d.board_at = 0
            wake.set()
            fails = sum(1 for e in es if str(e["figma"]).startswith("feil"))
            return f"{n} sticky(er) skrevet til {b.page}" + (f" · {fails} feilet" if fails else "")
        if not any(e["figma"] == "kø" for e in es):
            note("ingenting i kø")
            return
        if not d.board:
            note("boardet er ikke lest — trenger Figma-token for å vite hvor stickies skal", True)
            return
        act("skriver til board via Figma-MCP …", run)

    def move(t, step):
        order = ["To Do", "Doing", "Done"]
        i = order.index(t["state"]) if t["state"] in order else 0
        to = order[max(0, min(2, i + step))]
        if to == t["state"]:
            return

        def run():
            set_state(t["id"], to)
            t["state"] = to
            d.refresh_ado()
            return f"#{t['id']} → {to}"
        nonlocal ask
        ask = (f"#{t['id']} {t['state']} → {to}?", lambda: act("oppdaterer …", run))

    while True:
        h, w = scr.getmaxyx()
        scr.erase()
        b = d.board
        queued = sum(1 for e in es if e["figma"] == "kø")
        nxt = d.next_meeting()
        head = " · ".join(x for x in [
            "ops", f"{b.page} ({day(b.date)})" if b else "board: " + (d.board_err[:50] if d.board_err else "henter …"),
            f"neste møte {day(nxt)}" if nxt else "",
            f"{sum(1 for t in d.items if t['state'] != 'Done')} åpne tiltak" if d.items else (d.ado_err[:40] or "henter ADO …"),
            f"⇡{queued} i kø" if queued else ""] if x)
        put(0, 0, head, w - 1, curses.A_BOLD)
        x = 0
        for i, name in enumerate(["1 Board", "2 Tiltak", "3 Innboks"]):
            put(1, x, f" {name} ", w - x - 1, curses.A_REVERSE | curses.A_BOLD if i == view else pal["dim"])
            x += len(name) + 3
        if b and b.traffic and view == 0:
            x += 2
            for label, c, t in b.traffic:
                put(1, x, "●", 1, pal.get(c, 0) | curses.A_BOLD if c != "plain" else pal["dim"])
                put(1, x + 2, label, w - x - 3, pal["dim"])
                x += len(label) + 4

        cols, cw = columns(w)
        draw_cols(cols, cw, 3, h - 5, w)
        cur = selected(cols)

        if draft:
            draw_box(draft_lines(draft), "Nytt innspill", h, w)
        elif detail:
            draw_box(detail[1], detail[0], h, w)

        keys = "n nytt · 1/2/3 visning · ←→↑↓ flytt · enter detaljer · o åpne · S synk board · r oppdater · q avslutt"
        if edit:
            put(h - 1, 0, f"{edit[0]}: {edit[1]}"[-(w - 2):] + "█", w - 1, pal["cyan"] | curses.A_BOLD)
        elif ask:
            put(h - 1, 0, ask[0] + "  y/n", w - 1, pal["yellow"] | curses.A_BOLD)
        elif busy:
            put(h - 1, 0, "… " + busy, w - 1, pal["yellow"])
        else:
            put(h - 1, 0, msg or keys, w - 1, (pal["red"] if err else pal["green"]) if msg else pal["dim"])
        scr.refresh()

        if edit:
            try:
                c = scr.get_wch()
            except curses.error:
                continue
            if c in ("\n", "\r", curses.KEY_ENTER):
                (_, text, fn), edit = edit, None
                if text.strip():
                    fn(text.strip())
            elif c == "\x1b":
                edit = None
            elif c in (curses.KEY_BACKSPACE, "\x7f", "\b"):
                edit[1] = edit[1][:-1]
            elif c == "\x15":
                edit[1] = ""
            elif c == "\x17":
                edit[1] = re.sub(r"\S*$", "", edit[1].rstrip())
            elif isinstance(c, str) and c.isprintable():
                edit[1] += c
            continue

        k = scr.getch()
        if k == -1:
            continue
        msg, err = "", False
        ch = chr(k) if 32 <= k < 256 else "\0"  # "" would be `in` every key string
        if ask:
            _, fn = ask
            ask = None
            if ch in "yYj":
                fn()
            continue
        if draft:
            e = draft
            if k in (10, 13, curses.KEY_ENTER):
                keep(e)
                draft = None
                note("lagret · i kø for boardet (S for å synke)")
            elif ch == "a":
                keep(e)
                draft = None
                ask = make_issue(e)
            elif ch == "l":
                keep(e, queue=False)
                draft = None
                note("lagret lokalt i innboksen")
            elif ch == "t":
                e["c"]["kind"] = "notat" if e["c"]["kind"] == "tiltak" else "tiltak"
                cycle_area(e, 0)
            elif ch in "oO":
                cycle_area(e, 1 if ch == "o" else -1)
            elif ch == "u":
                cycle_section(e)
            elif ch == "e":
                draft = None
                edit = ["nytt", e["raw"], classify_bg]
            elif k == 27:
                draft = None
                note("forkastet")
            continue
        if detail:
            if ch == "o" and cur:
                k = ord("o")
                detail = None
            elif k in (27, 10, 13, ord("q")):
                detail = None
                continue
            else:
                detail = None
        ncols = len(cols)
        if ch == "q":
            return
        elif ch in "123":
            view = int(ch) - 1
            col = 0
        elif k == 9:
            view = (view + 1) % 3
            col = 0
        elif k in (curses.KEY_RIGHT, ord("l")):
            col = min(ncols - 1, col + 1)
        elif k in (curses.KEY_LEFT, ord("h")):
            col = max(0, col - 1)
        elif k in (curses.KEY_DOWN, ord("j")):
            row[(view, col)] = row.get((view, col), 0) + 1
            n = sum(1 for x in cols[min(col, ncols - 1)][1] if x.get("ref")) if cols else 0
            row[(view, col)] = min(row[(view, col)], max(0, n - 1))
        elif k in (curses.KEY_UP, ord("k")):
            row[(view, col)] = max(0, row.get((view, col), 0) - 1)
        elif ch in ("n", "/", "i"):
            edit = ["nytt", "", classify_bg]
        elif ch == "r":
            d.ado_at = d.board_at = 0
            wake.set()
            note("oppdaterer …")
        elif ch == "S":
            sync()
        elif ch in "[]" and d.board and d.board.pages:
            ids = [p[0] for p in d.board.pages]
            i = ids.index(d.board.page_id) if d.board.page_id in ids else len(ids) - 1
            i = max(0, min(len(ids) - 1, i + (1 if ch == "]" else -1)))
            d.page = None if i == len(ids) - 1 else ids[i]
            d.board_at = 0
            wake.set()
            note(f"henter {d.board.pages[i][1]} …")
        elif cur and k in (10, 13, curses.KEY_ENTER):
            detail = detail_of(cur["ref"])
        elif cur and ch == "o":
            ref = cur["ref"]
            url = (d.board.url(ref[1]["id"]) if ref[0] == "sticky" and d.board else
                   f"{ITEM}{ref[1]['id']}" if ref[0] == "item" else
                   f"{ITEM}{ref[1]['ado']}" if ref[1].get("ado") else
                   d.board.url(ref[1]["figma"]) if d.board and ref[1].get("figma") and ":" in str(ref[1]["figma"]) else None)
            if url:
                subprocess.Popen(["open", url], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            else:
                note("ingen lenke ennå", True)
        elif cur and ch in "<>" and cur["ref"][0] == "item":
            move(cur["ref"][1], 1 if ch == ">" else -1)
        elif cur and ch == "f" and cur["ref"][0] == "entry":
            cur["ref"][1]["figma"] = "kø"
            persist()
            note("i kø for boardet (S for å synke)")
        elif cur and ch == "a" and cur["ref"][0] == "entry":
            e = cur["ref"][1]
            if e.get("ado"):
                note(f"har allerede ADO #{e['ado']}", True)
            else:
                ask = make_issue(e)
        elif cur and ch == "x" and cur["ref"][0] == "entry":
            e = cur["ref"][1]

            def drop(e=e):
                with lock:
                    es.remove(e)
                persist()
                note("slettet fra innboksen (ikke fra board/ADO)")
            ask = (f"Slett «{e['c']['tittel'][:50]}» fra innboksen?", drop)


def cmd_live(a):
    locale.setlocale(locale.LC_ALL, "")
    os.environ.setdefault("ESCDELAY", "25")
    curses.wrapper(tui, a)


def main():
    p = argparse.ArgumentParser(prog="ops", description="Operations-boardet og tiltakene i terminalen.")
    sub = p.add_subparsers(dest="cmd")
    sub.add_parser("ls", help="board og åpne tiltak, skrevet ut én gang")
    ad = sub.add_parser("add", help="kategoriser ett innspill og lagre det i innboksen")
    ad.add_argument("text", nargs="+")
    ad.add_argument("-l", "--local", action="store_true", help="ikke legg i kø for boardet")
    sy = sub.add_parser("sync", help="skriv innspill i kø til boardet som stickies")
    sy.add_argument("--gammel", action="store_true", help="skriv selv om nyeste side er et møte som har vært")
    ny = sub.add_parser("ny", help="åpne neste møte: ny referat-side fra riktig mal, med åpne tiltak")
    ny.add_argument("dato", nargs="?", help="møtedato, f.eks. «23. okt» (utelat for å regne den ut)")
    ny.add_argument("-y", "--yes", action="store_true", help="ikke spør før siden opprettes")
    a = p.parse_args()
    {"ls": cmd_ls, "add": cmd_add, "sync": cmd_sync, "ny": cmd_ny}.get(a.cmd, cmd_live)(a)


if __name__ == "__main__":
    main()
