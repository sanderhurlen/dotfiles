_loader.exec_module(wf)
from_wf = ("bold", "dim", "cyan", "green", "yellow", "red", "TTY")
globals().update({k: getattr(wf, k) for k in from_wf})

FILE = os.environ.get("OPS_FIGMA_FILE", "zTyL7wC1gjK5DlciwmQmQT")
BOARD = f"https://www.figma.com/board/{FILE}/Operations"
PROJECT = "Visense"
AREA = "Visense\\Operations"
