# The temaer as the templates have them; used until the board itself has been read.
AREAS = ["Salg -> Leveranse", "Support og henvendelser", "Økonomi", "Produktoppfølging",
         "Folk og kapasitet", "Risiko og annet", "Kvartal"]
COMMIT = re.compile(r"(?i)utfall|tiltak|beslutning")  # sections whose stickies are tiltak
NOT_AREAS = re.compile(r"(?i)tiltakslogg|trafikklys")
TAGGED = re.compile(r"#(\d{3,})")  # a sticky that already is an ADO tiltak
MONTHS = {"jan": 1, "feb": 2, "mar": 3, "apr": 4, "mai": 5, "jun": 6, "jul": 7, "aug": 8,
          "sep": 9, "okt": 10, "nov": 11, "des": 12}
MONTH_NAMES = ["januar", "februar", "mars", "april", "mai", "juni", "juli", "august",
               "september", "oktober", "november", "desember"]
DAYS = ["man", "tir", "ons", "tor", "fre", "lør", "søn"]
PAGE_MONTHS = ["jan", "feb", "mars", "apr", "mai", "juni", "juli", "aug", "sept", "okt", "nov", "des"]
STUB = "Opprettet av ops før møtet"  # epic description: the meeting hasn't been written up yet
LUKKET = "Lukket av ops"               # epic description: lukk has run; any non-stub epic counts as closed
WEEK = datetime.timedelta(days=7)


def die(msg):
    print(f"ops: {msg}", file=sys.stderr)
    sys.exit(1)


def today():
    return datetime.date.today()


def day(d):
    return f"{DAYS[d.weekday()]} {d.day}. {MONTH_NAMES[d.month - 1][:3]}" if d else "?"


def meeting_date(name, ref=None):
    """«Referat 4. sept» / «Referat 21.aug» / «Operations-møte 4. september 2026» → date.
    No year: this year, unless that lands more than a month ahead — then last year."""
    m = re.search(r"(\d{1,2})\.\s*([a-zæøå]{3})[a-zæøå]*\.?(?:\s+(\d{4}))?", name.lower())
    if not m or m.group(2) not in MONTHS:
        return None
    ref = ref or today()
    y = int(m.group(3)) if m.group(3) else ref.year
    try:
        d = datetime.date(y, MONTHS[m.group(2)], int(m.group(1)))
    except ValueError:
        return None
    if not m.group(3) and d > ref + datetime.timedelta(days=31):
        d = d.replace(year=y - 1)
    return d


def long_day(d):
    return f"{d.day}. {MONTH_NAMES[d.month - 1]} {d.year}"


def epic_title(d):
    return f"Operations-møte {long_day(d)}"


def cadence(d):
    """Which template a meeting date gets. Månedlig = siste fredag i måneden (STARTSIDE);
    kvartalsvis = the månedlige in mars/juni/sept/des — an assumption, the board doesn't say."""
    last = (d + WEEK).month != d.month
    return "Kvartalsvis" if last and d.month % 3 == 0 else "Månedlig" if last else "Ukentlig"


def next_meeting(dates, closed=()):
    """The first known meeting from today on that isn't closed; otherwise a week after the
    newest, rolled forward past today and past closed meetings."""
    dates = [d for d in dates if d]
    up = sorted(d for d in dates if d >= today() and d not in closed)
    if up:
        return up[0]
    if not dates:
        return None
    d = max(dates) + WEEK
    while d < today() or d in closed:
        d += WEEK
    return d


def confirm(q, yes=False):
    if yes:
        return True
    if not sys.stdin.isatty():
        die("boardet og ADO er delt — bekreft med -y når det ikke er en terminal")
    return input(f"{q} [j/N] ").strip().lower() in ("j", "ja", "y", "yes")


# ── figma ───────────────────────────────────────────────────────────────────

_token = None


def figma_token():
    global _token
    if _token is None:
        _token = os.environ.get("FIGMA_TOKEN") or wf.sh(
            "security", "find-generic-password", "-a", os.environ.get("USER", ""), "-s", "figma-token", "-w")
    return _token


def figma(path):
    if not figma_token():
        raise RuntimeError("ingen Figma-token — se `ops` header (FIGMA_TOKEN / keychain figma-token)")
    req = urllib.request.Request(f"https://api.figma.com/v1/{path}", headers={"X-Figma-Token": figma_token()})
    try:
        with urllib.request.urlopen(req, timeout=60) as r:
            return json.load(r)
    except urllib.error.HTTPError as e:
        try:
            msg = json.loads(e.read()).get("err")
        except ValueError:
            msg = None
        raise RuntimeError(f"Figma {e.code}: {msg or e.reason}")
    except urllib.error.URLError as e:
        raise RuntimeError(f"Figma: {e.reason}")


def page_doc(pid, version):
    """A page's node tree, cached per file version — the board changes far less often than we look."""
    path = os.path.join(CACHE, "page-" + re.sub(r"\W", "-", pid) + ".json")
    try:
        with open(path) as f:
            c = json.load(f)
        if c["version"] == version:
            return c["doc"]
    except (OSError, ValueError, KeyError):
        pass
    doc = figma(f"files/{FILE}/nodes?ids={urllib.parse.quote(pid)}")["nodes"][pid]["document"]
    os.makedirs(CACHE, exist_ok=True)
    with open(path, "w") as f:
        json.dump({"version": version, "doc": doc}, f)
    return doc


def walk(n):
    yield n
    for c in n.get("children", []):
        yield from walk(c)


def bbox(n):
    b = n.get("absoluteBoundingBox") or {}
    return b.get("x", 0), b.get("y", 0), b.get("width", 0), b.get("height", 0)


def contains(outer, inner):
    x, y, w, h = bbox(outer)
    ix, iy, iw, ih = bbox(inner)
    cx, cy = ix + iw / 2, iy + ih / 2
    return x <= cx <= x + w and y <= cy <= y + h


def chars(n):
    if n.get("characters"):
        return n["characters"]
    return " ".join(c["characters"] for c in walk(n) if c is not n and c.get("characters"))


def table(n):
    """TABLE node → rows of cell texts, ordered by position."""
    rows = {}
    for c in n.get("children", []):
        if c.get("type") == "TABLE_CELL":
            x, y, _, _ = bbox(c)
            rows.setdefault(round(y), []).append((x, chars(c).strip()))
    return [[t for _, t in sorted(r)] for _, r in sorted(rows.items())]


class Board:
    """A referat page, read geometrically: a tema is a section no other section contains
    (on older pages a tema's sub-sections are siblings inside its bounds, on newer ones its
    children — both read the same), a sticky's seksjon is the smallest section around it."""

    def __init__(self, page, doc, people=None):
        self.page_id, self.page = page
        self.date = meeting_date(self.page)
        self.people = people or {}
        nodes = list(walk(doc))
        secs = [n for n in nodes if n.get("type") == "SECTION"]
        area = lambda n: bbox(n)[2] * bbox(n)[3]
        outer = [s for s in secs if not any(o is not s and area(o) > area(s) and contains(o, s) for o in secs)]
        self.areas = []
        for o in sorted(outer, key=lambda s: (bbox(s)[0], bbox(s)[1])):
            if NOT_AREAS.search(o["name"]):
                continue
            subs = sorted((s for s in secs if s is not o and contains(o, s)), key=lambda s: (bbox(s)[0], bbox(s)[1]))
            self.areas.append({"name": o["name"].strip(), "id": o["id"],
                               "secs": [{"name": "", "id": o["id"], "stickies": []}] +
                                       [{"name": s["name"].strip(), "id": s["id"], "stickies": []} for s in subs]})
        for n in nodes:
            if n.get("type") != "STICKY":
                continue
            st = {"id": n["id"], "text": chars(n).strip(), "pos": bbox(n)[:2]}
            around = [s for s in secs if contains(s, n)]
            if not around:
                continue
            inner = min(around, key=area)
            for a in self.areas:
                for s in a["secs"]:
                    if s["id"] == inner["id"] and (s["name"] or inner["id"] == a["id"]):
                        s["stickies"].append(st)
        for a in self.areas:
            for s in a["secs"]:
                s["stickies"].sort(key=lambda st: (st["pos"][1], st["pos"][0]))
            a["secs"] = [s for s in a["secs"] if s["name"] or s["stickies"]]
        self.areas = [a for a in self.areas if a["secs"]]

    def find(self, area, sec=""):
        a = next((x for x in self.areas if x["name"].lower() == (area or "").lower()), None)
        if not a:
            return None, None
        s = next((x for x in a["secs"] if x["name"] and x["name"].lower() == (sec or "").lower()), None)
        return a, s

    def vocabulary(self):
        return {a["name"]: [s["name"] for s in a["secs"] if s["name"]] for a in self.areas}

    def stickies(self):
        for a in self.areas:
            for s in a["secs"]:
                for st in s["stickies"]:
                    yield a, s, st

    def url(self, node=None):
        return f"{BOARD}?node-id={urllib.parse.quote((node or self.page_id).replace(':', '-'))}"


def people_of(doc):
    """STARTSIDE's Representanter table → {navn: e-post}."""
    for n in walk(doc):
        if n.get("type") != "TABLE":
            continue
        rows = table(n)
        head = [t.lower() for t in rows[0]] if rows else []
        if any("navn" in h for h in head) and any("post" in h for h in head):
            ni = next(i for i, h in enumerate(head) if "navn" in h)
            ei = next(i for i, h in enumerate(head) if "post" in h)
            return {r[ni]: r[ei] for r in rows[1:] if len(r) > max(ni, ei) and r[ni]}
    return {}


# ── ado ─────────────────────────────────────────────────────────────────────

_ado = None


def A():
    global _ado
    if _ado is None:
        _ado = wf.Ado()
    return _ado


def api(path, body=None, method=None, ctype="application/json", project=PROJECT):
    """Like wf.Ado.api, but raises instead of exiting, so the TUI survives a failed call."""
    url = f"{A().org}/{urllib.parse.quote(project) + '/' if project else ''}_apis/{path}"
    url += ("&" if "?" in url else "?") + "api-version=7.1"
    data = json.dumps(body).encode() if body is not None else None
    req = urllib.request.Request(url, data=data, method=method or ("POST" if data else "GET"),
                                 headers={"Authorization": f"Bearer {A().token()}", "Content-Type": ctype})
    try:
        with urllib.request.urlopen(req, timeout=30) as r:
            return json.load(r)
    except urllib.error.HTTPError as e:
        try:
            msg = json.loads(e.read()).get("message")
        except ValueError:
            msg = None
        raise RuntimeError(f"ADO {e.code}: {msg or e.reason}")
    except urllib.error.URLError as e:
        raise RuntimeError(f"ADO: {e.reason}")


FIELDS = ["System.Id", "System.Title", "System.State", "System.WorkItemType", "System.AssignedTo",
          "System.Tags", "System.Description", "System.CreatedDate", "System.Parent",
          "Microsoft.VSTS.Scheduling.DueDate"]


def wiql(where):
    q = f"SELECT [System.Id] FROM WorkItems WHERE [System.AreaPath] UNDER '{AREA}' AND {where} ORDER BY [System.Id]"
    ids = [w["id"] for w in api("wit/wiql", {"query": q})["workItems"]]
    out = []
    for i in range(0, len(ids), 200):
        out += api("wit/workitemsbatch", {"ids": ids[i:i + 200], "fields": FIELDS})["value"]
    return [w["fields"] for w in out]


def load_ado():
    """Open Operations Issues, and every meeting epic."""
    raw = wiql("(([System.WorkItemType] = 'Issue' AND [System.State] <> 'Done' AND [System.State] <> 'Removed')"
               " OR [System.WorkItemType] = 'Epic')")
    if not members:
        members.update(load_members())
    items, epics = [], []
    for f in raw:
        desc = f.get("System.Description") or ""
        if f["System.WorkItemType"] == "Epic":
            epics.append({"id": f["System.Id"], "title": f["System.Title"], "state": f["System.State"],
                          "date": meeting_date(f["System.Title"]), "stub": STUB in desc, "lukket": LUKKET in desc or STUB not in desc})
            continue
        if f.get("System.AssignedTo", {}).get("uniqueName"):  # people who aren't team members still get tiltak
            members.setdefault(f["System.AssignedTo"]["displayName"], f["System.AssignedTo"]["uniqueName"])
        eier = re.search(r"Eier:\s*(?:</b>)?\s*([^<]+)", desc)
        frist = re.search(r"Frist:\s*(?:</b>)?\s*([^<]+)", desc)
        due = f.get("Microsoft.VSTS.Scheduling.DueDate")
        items.append({
            "id": f["System.Id"], "title": f["System.Title"], "state": f["System.State"],
            "who": (f.get("System.AssignedTo") or {}).get("displayName") or (eier and html.unescape(eier.group(1)).strip()) or "",
            "assigned": bool(f.get("System.AssignedTo")),
            "frist": frist and html.unescape(frist.group(1)).strip() or "",
            "due": datetime.date.fromisoformat(due[:10]) if due else None,
            "created": datetime.date.fromisoformat(f["System.CreatedDate"][:10]),
            "parent": f.get("System.Parent"),
        })
    return items, epics


members = {}  # ADO display name → uniqueName, filled by load_ado


def load_members():
    path = os.path.join(CACHE, "members.json")
    try:
        if datetime.datetime.now().timestamp() - os.path.getmtime(path) < 86400:
            with open(path) as f:
                return json.load(f)
    except (OSError, ValueError):
        pass
    out = {}
    p = urllib.parse.quote(PROJECT)
    for t in api(f"projects/{p}/teams", project=None)["value"]:
        for m in api(f"projects/{p}/teams/{urllib.parse.quote(t['name'])}/members", project=None)["value"]:
            out[m["identity"]["displayName"]] = m["identity"]["uniqueName"]
    os.makedirs(CACHE, exist_ok=True)
    with open(path, "w") as f:
        json.dump(out, f)
    return out


def patch(id, fields):
    api(f"wit/workitems/{id}", [{"op": "add", "path": f"/fields/{k}", "value": v} for k, v in fields.items()],
        method="PATCH", ctype="application/json-patch+json")


def set_state(id, state):
    patch(id, {"System.State": state})


def set_due(id, d):
    patch(id, {"Microsoft.VSTS.Scheduling.DueDate": d.isoformat()})


def ensure_epic(d, epics):
    """The meeting's epic, created as a stub when the meeting hasn't been written up yet."""
    t = epic_title(d)
    hit = next((x for x in epics if x["title"] == t), None)
    if hit:
        return hit["id"]
    id = api("wit/workitems/$Epic", [
        {"op": "add", "path": "/fields/System.Title", "value": t},
        {"op": "add", "path": "/fields/System.AreaPath", "value": AREA},
        {"op": "add", "path": "/fields/System.Description",
         "value": f"{STUB} {today().isoformat()}. Referatet skrives hit av `ops lukk` etter møtet."}],
        ctype="application/json-patch+json")["id"]
    epics.append({"id": id, "title": t, "state": "To Do", "date": d, "stub": True, "lukket": False})
    return id


def create_issue(c, raw, due, people, epic, kilde):
    """A tiltak → Issue: tagged, assigned when the eier resolves, due at the next meeting."""
    email = resolve(c.get("eier", ""), people)
    now = today().isoformat()
    tags = ["operations-mote", f"rapportert:{now}"] + (["Ikke satt"] if not c.get("frist") or c["frist"] == "Ikke satt" else [])
    desc = "<br>".join(f"<b>{k}:</b> {html.escape(v)}" for k, v in [
        ("Eier", c.get("eier") or "Ikke satt"), ("Frist", c.get("frist") or "Ikke satt"),
        ("Kilde", kilde), ("Rapportert inn", now)]
        + ([("Innspill", raw)] if raw.strip() != c["tittel"].strip() else [])
        + ([("Info", c["info"])] if c.get("info") else []))
    ops = [{"op": "add", "path": "/fields/System.Title", "value": c["tittel"]},
           {"op": "add", "path": "/fields/System.AreaPath", "value": AREA},
           {"op": "add", "path": "/fields/System.Description", "value": desc},
           {"op": "add", "path": "/fields/System.Tags", "value": "; ".join(tags)}]
    if due:
        ops.append({"op": "add", "path": "/fields/Microsoft.VSTS.Scheduling.DueDate", "value": due.isoformat()})
    if email:
        ops.append({"op": "add", "path": "/fields/System.AssignedTo", "value": email})
    if epic:
        ops.append({"op": "add", "path": "/relations/-", "value": {
            "rel": "System.LinkTypes.Hierarchy-Reverse", "url": f"{A().org}/_apis/wit/workItems/{epic}"}})
    return api("wit/workitems/$Issue", ops, ctype="application/json-patch+json")["id"]


def fold(s):
    return unicodedata.normalize("NFKD", s.lower()).encode("ascii", "ignore").decode()


def resolve(eier, people):
    """First name in «Martin/Håkon» → e-post: Representanter first, then ADO members by
    display name (Håkon finds Hakon Onshuus); ambiguous or unknown → None.
    Never a guess: a tiltak on the wrong plate looks handled."""
    first = fold(re.split(r"[/,&]| og ", eier or "")[0].strip())
    if not first:
        return None
    for source in (people, members):
        hits = {e for n, e in source.items() if e and (fold(n) == first or fold(n).split()[0] == first)}
        if hits:
            return hits.pop() if len(hits) == 1 else None
    return None


def tidy(dry=False):
    """Close every epic whose meeting is over and whose Issues are all Done.
    A meeting that was never written up (stub) and has no Issues is left alone."""
    epics = [f for f in wiql("[System.WorkItemType] = 'Epic' AND [System.State] <> 'Done' AND [System.State] <> 'Removed'")]
    if not epics:
        return []
    ids = ", ".join(str(f["System.Id"]) for f in epics)
    kids = wiql(f"[System.WorkItemType] = 'Issue' AND [System.Parent] IN ({ids}) AND [System.State] <> 'Removed'")
    closed = []
    for f in epics:
        d = meeting_date(f["System.Title"])
        if not d or d >= today():
            continue
        mine = [k for k in kids if k.get("System.Parent") == f["System.Id"]]
        if any(k["System.State"] != "Done" for k in mine):
            continue
        if not mine and STUB in (f.get("System.Description") or ""):
            continue
        if not dry:
            set_state(f["System.Id"], "Done")
        closed.append((f["System.Id"], f["System.Title"], len(mine)))
    return closed


def report_tidy(closed, dry=False):
    for id, t, n in closed:
        print(dim(f"rydding: {'ville lukket' if dry else 'lukket'} epic #{id} «{t}»"
                  + (f" — alle {n} tiltak Done" if n else " — ingen tiltak")))


# ── claude ──────────────────────────────────────────────────────────────────


def claude(system, prompt, schema, model=MODEL, tools=None):
    cmd = ["claude", "-p", "--model", model, "--no-session-persistence", "--output-format", "json",
           "--json-schema", json.dumps(schema)]
    if tools:
        cmd += ["--allowedTools", ",".join(tools)]
    else:
        cmd += ["--tools", "", "--setting-sources", ""]
    if system:
        cmd += ["--system-prompt", system]
    r = subprocess.run(cmd, input=prompt, capture_output=True, text=True)
    try:
        out = json.loads(r.stdout)
    except ValueError:
        raise RuntimeError(f"claude: {(r.stderr or r.stdout).strip()[:300]}")
    if out.get("is_error") or out.get("structured_output") is None:
        raise RuntimeError(f"claude: {str(out.get('result'))[:300]}")
    return out["structured_output"]


CLASSIFY = """Du sorterer innspill til Visense sitt ukentlige Operations-møte (FigJam-board, tiltak i Azure DevOps).

Boardet har temaer, hvert med seksjoner. Seksjoner med Utfall/Tiltak/Beslutninger i navnet holder tiltak
(noen skylder noen noe: en handling med eier). Andre seksjoner (Rapport) holder notater (status, tall, kontekst).

For innspillet:
- kind: "tiltak" hvis det er en handling noen skal gjøre, ellers "notat".
- omraade: nøyaktig ett av temanavnene.
- seksjon: nøyaktig ett seksjonsnavn i det temaet. Tiltak går i Utfall, notater i Rapport.
- tittel: tiltak → én konsis imperativ norsk linje som står alene ut av kontekst (ta med det identifiserende
  substantivet, f.eks. «Fylle på lager: A-100 5pk mangler»). Notat → innspillet ryddet, uten å miste fakta.
- eier: navn fra Representanter hvis innspillet nevner en person eller «jeg» (= Sander); ellers "".
  Gjett aldri en eier.
- frist: eksplisitt frist fra teksten («innen fredag», «om 2 uker»), ellers "Ikke satt".
- relatert: id-er på åpne tiltak som handler om det samme (tom liste hvis ingen).
- info: 1–3 korte setninger som gjør innspillet mer nyttig i møtet: hva det henger sammen med blant åpne tiltak,
  hva som mangler (eier? frist? tall?), eller et konkret neste steg. Ikke gjenta tittelen. Ikke dikt opp fakta."""


def classify(raw, ctx, kind=None):
    board = ctx.board
    vocab = board.vocabulary() if board and board.areas else {a: ["Rapport", "Utfall"] for a in AREAS}
    people = board.people if board else {}
    nxt = ctx.next
    prompt = "\n".join([
        f"I dag: {day(today())} {today().isoformat()}. Neste møte: {day(nxt)} {nxt or ''}.",
        "", "Temaer og seksjoner:", json.dumps(vocab, ensure_ascii=False, indent=1),
        "", "Representanter: " + (", ".join(people) or "(ukjent)"),
        "Andre i ADO: " + ", ".join(members),
        "", "Åpne tiltak:", *[f"#{t['id']} [{t['state']}] {t['title']} — {t['who'] or 'uten eier'}" for t in ctx.items],
        "", "Innspill:", raw])
    schema = {"type": "object", "additionalProperties": False,
              "required": ["kind", "omraade", "seksjon", "tittel", "eier", "frist", "info", "relatert"],
              "properties": {
                  "kind": {"type": "string", "enum": ["tiltak", "notat"]},
                  "omraade": {"type": "string", "enum": list(vocab)},
                  "seksjon": {"type": "string"},
                  "tittel": {"type": "string"}, "eier": {"type": "string"}, "frist": {"type": "string"},
                  "info": {"type": "string"},
                  "relatert": {"type": "array", "items": {"type": "integer"}}}}
    c = claude(CLASSIFY, prompt, schema)
    c["eier"] = clean_eier(c["eier"])
    known = {t["id"] for t in ctx.items}
    c["relatert"] = [i for i in c.get("relatert", []) if i in known]
    if kind and kind != c["kind"]:
        c["kind"], c["seksjon"] = kind, ""
    if c["seksjon"] not in vocab.get(c["omraade"], []) or bool(COMMIT.search(c["seksjon"])) != (c["kind"] == "tiltak"):
        c["seksjon"] = default_section(vocab.get(c["omraade"], []), c["kind"])
    return c


def same(title, items):
    """An Issue that already is this tiltak: older pages' stickies don't carry their #id."""
    best = max(items, key=lambda t: difflib.SequenceMatcher(None, fold(title), fold(t["title"])).ratio(), default=None)
    if best and difflib.SequenceMatcher(None, fold(title), fold(best["title"])).ratio() >= 0.75:
        return best
    return None


def clean_eier(s):
    return "" if re.fullmatch(r"[\s\"'–-]*|(?i:ingen|ukjent|ikke satt)", s or "") else s.strip()


def default_section(secs, kind):
    return next((s for s in secs if bool(COMMIT.search(s)) == (kind == "tiltak")), "")


PARSE = """Du gjør stickies fra Utfall-seksjonene på Visense sitt Operations-board om til tiltak i Azure DevOps.
Sticky-tekst er fri form og linjeskift kan mangle. Typisk: «Ansvarlig: Martin  Gjennomgå bruk av Varenavn  Ta et møte om 2 uker».

For hver sticky, med samme id:
- tittel: handlingen som én konsis imperativ norsk linje som står alene ut av kontekst; fold inn det identifiserende
  substantivet. Uten «Ansvarlig:»-delen.
- eier: teksten etter Ansvarlig:/Eier: (kan være flere, «Martin/Håkon»), ellers et navn som nevnes, ellers "".
  Gjett aldri.
- frist: eksplisitt frist i teksten («innen 16. sept», «om 2 uker», «snarest»), ellers "Ikke satt"."""

REFERAT = """Du skriver møtereferatet for Visense sitt Operations-møte, som HTML til beskrivelsen av møtets epic
i Azure DevOps (<h3>, <ul>/<li>, <b> og <br> fungerer).

Start med <b>Operations-møte <dato></b><br>, så Kilde (FigJam-siden) og Neste møte, hver med <br>.
Deretter én <h3> per tema som har innhold, i boardets rekkefølge. Skriv lesbar prosa, ikke en sticky-dump: slå
sammen stickies som sier det samme, behold navn og tall ordrett (S-200, uke 39, 500 sensorer), dropp temaer
uten innhold. Den som ikke var i møtet skal kunne lese dette og vite hva som skjedde.
Avslutt med <h3>Tiltak</h3> og en <ul> med hvert tiltak som «#id tittel — eier».
Ikke dikt opp noe som ikke står i stickies."""


# ── innboks ─────────────────────────────────────────────────────────────────
# Every entry: {key, at, raw, kind: None|"tiltak"|"notat" (forced by «t:»/«n:»), c: classification,
# ado: None|<id>, figma: None|"kø"|<node id>|"feil: …", err: ""}
# `ops add` only appends; the worker (`ops _worker`, started detached) does the slow part:
# sort with Haiku, create the Issue, write the stickies — every entry under one lock, so
# any number of `ops add` can run while it works.


class locked:
    """flock on a file next to the innboks; `with locked("inbox"):` around every read-modify-write."""

    def __init__(self, name, block=True):
        self.path, self.block = os.path.join(os.path.dirname(INBOX), name + ".lock"), block

    def __enter__(self):
        os.makedirs(os.path.dirname(self.path), exist_ok=True)
        self.f = open(self.path, "w")
        try:
            fcntl.flock(self.f, fcntl.LOCK_EX | (0 if self.block else fcntl.LOCK_NB))
        except BlockingIOError:
            self.f.close()
            return False
        return True

    def __exit__(self, *_):
        if not self.f.closed:
            fcntl.flock(self.f, fcntl.LOCK_UN)
            self.f.close()


def inbox():
    try:
        with open(INBOX) as f:
            return json.load(f)
    except (OSError, ValueError):
        return []


def save(entries):
    os.makedirs(os.path.dirname(INBOX), exist_ok=True)
    tmp = INBOX + ".tmp"
    with open(tmp, "w") as f:
        json.dump(entries, f, ensure_ascii=False, indent=1)
    os.replace(tmp, INBOX)


def update(key, **fields):
    with locked("inbox"):
        es = inbox()
        for e in es:
            if e["key"] == key:
                e.update(fields)
        save(es)


def entry(raw, c=None):
    kind = None
    m = re.match(r"(?i)\s*([tn]):\s*", raw)
    if m:
        kind, raw = ("tiltak" if m.group(1).lower() == "t" else "notat"), raw[m.end():]
    return {"key": uuid.uuid4().hex[:8], "at": datetime.datetime.now().isoformat(timespec="seconds"),
            "raw": raw.strip(), "kind": kind, "c": c, "figma": None, "ado": None, "err": ""}


def enqueue(raw):
    e = entry(raw)
    with locked("inbox"):
        es = inbox()
        es.append(e)
        save(es)
    spawn_worker()
    return e


def spawn_worker():
    os.makedirs(os.path.dirname(INBOX), exist_ok=True)
    log = open(os.path.join(os.path.dirname(INBOX), "worker.log"), "a")
    subprocess.Popen([os.path.realpath(__file__), "_worker"], stdin=subprocess.DEVNULL, stdout=log, stderr=log,
                     start_new_session=True)


def stage(e):
    """Where an entry is: sorterer → ADO → board → ferdig, or feil / venter på side."""
    if e.get("err"):
        return "feil"
    if not e.get("c"):
        return "sorterer"
    if e["c"]["kind"] == "tiltak" and not e.get("ado"):
        return "ADO"
    if e.get("figma") == "kø":
        return "board"
    if str(e.get("figma")).startswith("feil"):
        return "feil"
    return "ferdig"


def sticky_text(e):
    c = e["c"]
    if c["kind"] != "tiltak":
        return c["tittel"]
    lines = [(f"#{e['ado']} " if e.get("ado") else "") + c["tittel"],
             f"Ansvarlig: {c['eier']}" if c.get("eier") else "Ansvarlig: ?"]
    if c.get("frist") and c["frist"] != "Ikke satt":
        lines.append(f"Frist: {c['frist']}")
    return "\n".join(lines)


# ── figma writes ────────────────────────────────────────────────────────────
# Deterministic: Claude only relays this JS to the use_figma tool, it never writes code.

# A sticky goes to the right of the last sticky in its section, or starts a new row under
# them; the section, and the tema around it, grow to fit. Section-relative when the stickies
# are the section's children, page-absolute when they are loose inside it (older pages).
WRITE_JS = """const items = %s;
const page = await figma.getNodeByIdAsync(%s);
await figma.setCurrentPageAsync(page);
const out = [];
for (const it of items) {
  const sec = await figma.getNodeByIdAsync(it.section);
  if (!sec) { out.push({ key: it.key, id: "", error: "fant ikke seksjonen" }); continue; }
  const sb = sec.absoluteBoundingBox;
  const within = n => { const b = n.absoluteBoundingBox; const cx = b.x + b.width / 2, cy = b.y + b.height / 2;
    return cx >= sb.x && cx <= sb.x + sb.width && cy >= sb.y && cy <= sb.y + sb.height; };
  const kids = sec.children.filter(n => n.type === "STICKY");
  const loose = page.children.filter(n => n.type === "STICKY" && within(n));
  const s = figma.createSticky();
  await figma.loadFontAsync(s.text.fontName);
  s.text.characters = it.text;
  const all = kids.concat(loose).map(n => n.absoluteBoundingBox);
  let ax = sb.x + 40, ay = sb.y + 80;
  if (all.length) {
    const top = Math.max(...all.map(b => b.y));
    const row = all.filter(b => b.y > top - 40);
    const last = row.reduce((a, b) => (b.x > a.x ? b : a));
    ax = last.x + last.width + 24; ay = last.y;
    if (ax + s.width > sb.x + sb.width - 24) { ax = Math.min(...all.map(b => b.x)); ay = Math.max(...all.map(b => b.y + b.height)) + 24; }
  }
  if (loose.length && !kids.length) { s.x = ax; s.y = ay; }
  else { sec.appendChild(s); s.x = ax - sb.x; s.y = ay - sb.y; }
  const need = ay - sb.y + s.height + 40;
  if (need > sb.height) sec.resizeWithoutConstraints(sb.width, need);
  const p = sec.parent;
  if (p && p.type === "SECTION") {
    const pb = p.absoluteBoundingBox, bottom = sb.y + Math.max(need, sb.height) + 80 - pb.y;
    if (bottom > pb.height) p.resizeWithoutConstraints(pb.width, bottom);
  }
  out.push({ key: it.key, id: s.id, error: "" });
}
return out;"""

# lukk prefixes «#id» to the stickies it made Issues of, so a second run skips them.
RETAG_JS = """const items = %s;
const page = await figma.getNodeByIdAsync(%s);
await figma.setCurrentPageAsync(page);
let n = 0;
for (const it of items) {
  const s = await figma.getNodeByIdAsync(it.id);
  if (!s || s.type !== "STICKY") continue;
  const len = s.text.characters.length;
  for (const f of (len ? s.text.getRangeAllFontNames(0, len) : [s.text.fontName])) await figma.loadFontAsync(f);
  s.text.characters = it.text;
  n++;
}
return { n };"""

# watch: a small round … in the sticky's top right corner while the Issue is made, removed when it's
# done (no mark), and the sticky's new text when there is one. One mark per sticky, found by name.
MARK_JS = """const items = %s;
const page = await figma.getNodeByIdAsync(%s);
await figma.setCurrentPageAsync(page);
let n = 0;
for (const it of items) {
  const s = await figma.getNodeByIdAsync(it.id);
  if (!s || s.type !== "STICKY") continue;
  if (it.text) {
    const len = s.text.characters.length;
    for (const f of (len ? s.text.getRangeAllFontNames(0, len) : [s.text.fontName])) await figma.loadFontAsync(f);
    s.text.characters = it.text;
  }
  const name = "ops-merke " + s.id;
  let m = s.parent.findChild(c => c.name === name);
  if (!it.mark) { if (m) m.remove(); n++; continue; }
  if (!m) {
    m = figma.createShapeWithText();
    m.name = name;
    m.shapeType = "ELLIPSE";
    m.resize(32, 32);
    s.parent.appendChild(m);
  }
  await figma.loadFontAsync(m.text.fontName);
  m.text.characters = it.mark;
  m.fills = [{ type: "SOLID", color: { r: 1, g: 0.85, b: 0.4 } }];
  m.strokes = [];
  m.x = s.x + s.width - 22; m.y = s.y - 10;
  n++;
}
return { n };"""

# The tiltakslogg section's table gets one row per open tiltak (id and title link to ADO),
# the section grows to fit, and stickies of tiltak that are Done turn green.
LOG_JS = """const rows = %s, sub = %s, done = %s;
const page = await figma.getNodeByIdAsync(%s);
await figma.setCurrentPageAsync(page);
const load = async t => { const n = t.characters.length;
  for (const f of (n ? t.getRangeAllFontNames(0, n) : [t.fontName])) await figma.loadFontAsync(f); };
const sec = page.children.find(n => n.type === "SECTION" && /tiltakslogg/i.test(n.name));
if (!sec) return { rows: 0, green: 0, error: "fant ingen tiltakslogg på siden" };
const sb = sec.absoluteBoundingBox;
const inside = n => { const b = n.absoluteBoundingBox; return b.x >= sb.x && b.y >= sb.y && b.x < sb.x + sb.width && b.y < sb.y + sb.height; };
const table = sec.findOne(n => n.type === "TABLE") || page.children.find(n => n.type === "TABLE" && inside(n));
const subt = sec.findOne(n => n.type === "TEXT" && n.name === "Undertittel") || page.children.find(n => n.type === "TEXT" && n.name === "Undertittel" && inside(n));
if (!table) return { rows: 0, green: 0, error: "fant ingen tabell i tiltaksloggen" };
if (subt && sub) { await load(subt); subt.characters = sub; }
const pat = table.numRows > 2 ? [table.cellAt(1, 0).fills, table.cellAt(2, 0).fills] : null;
while (table.numRows > Math.max(rows.length, 1) + 1) table.removeRow(table.numRows - 1);
while (table.numRows < rows.length + 1) table.insertRow(table.numRows);
for (let i = 0; i < Math.max(rows.length, 1); i++) {
  for (let j = 0; j < 3; j++) {
    const cell = table.cellAt(i + 1, j);
    await load(cell.text);
    cell.text.characters = rows[i] ? rows[i][j] || " " : " ";
    if (rows[i] && j < 2) cell.text.hyperlink = { type: "URL", value: rows[i][3] };
    if (pat) cell.fills = pat[i %% 2];
  }
}
const tb = table.absoluteBoundingBox, need = tb.y + tb.height - sb.y + 64;
if (need > sb.height) sec.resizeWithoutConstraints(sb.width, need);
let green = 0;
if (done.length) for (const s of page.findAllWithCriteria({ types: ["STICKY"] })) {
  const m = s.text.characters.match(/#(\\d{3,})/);
  if (m && done.includes(+m[1])) { s.fills = [{ type: "SOLID", color: { r: 0xcd / 255, g: 0xf4 / 255, b: 0xd3 / 255 } }]; green++; }
}
return { rows: table.numRows - 1, green, error: "" };"""

CLONE_PAGE_JS = """const tpl = await figma.getNodeByIdAsync(%s);
await figma.setCurrentPageAsync(tpl);
const page = tpl.clone();
page.name = %s;
return { page: page.id, last: figma.root.children.indexOf(page) === figma.root.children.length - 1 };"""

RELAY = """First call mcp__plugin_figma_figma__create_session with fileKey %s and a short task description.
Then call the Figma MCP tool use_figma (mcp__plugin_figma_figma__use_figma) exactly once, on that fileKey and
with the returned sessionId, with the JavaScript below, unchanged. It is a FigJam file. Do not write or change
any code yourself.
Return what the tool returned as `result`. If the tool is unavailable or fails, return its error message
as `error` and null as `result`.

```js
%s
```"""


def use_figma(js, schema):
    """Run fixed JS through the Figma MCP server; Claude only relays it."""
    r = claude("", RELAY % (FILE, js), {"type": "object", "required": ["result", "error"], "properties": {
        "error": {"type": "string"}, "result": {"anyOf": [schema, {"type": "null"}]}}},
        tools=["mcp__plugin_figma_figma__create_session", "mcp__plugin_figma_figma__use_figma"])
    if r.get("result") is None:
        raise RuntimeError(f"Figma-skriving: {(r.get('error') or 'ingen svar')[:200]}"
                           " (krever /mcp → figma → Authenticate i claude)")
    return r["result"]


def push(entries, board):
    """Queued entries → stickies on the board, in one use_figma call."""
    todo = []
    for e in entries:
        if e["figma"] != "kø":
            continue
        a, s = board.find(e["c"]["omraade"], e["c"].get("seksjon"))
        if not a:
            e["figma"] = f"feil: fant ikke temaet «{e['c']['omraade']}» på {board.page}"
            continue
        todo.append({"key": e["key"], "section": (s or a)["id"], "text": sticky_text(e)})
    if not todo:
        return 0
    js = WRITE_JS % (json.dumps(todo, ensure_ascii=False), json.dumps(board.page_id))
    r = use_figma(js, {"type": "array", "items": {"type": "object", "required": ["key", "id"], "properties": {
        "key": {"type": "string"}, "id": {"type": "string"}, "error": {"type": "string"}}}})
    done = {x["key"]: x for x in r}
    for e in entries:
        x = done.get(e["key"])
        if x:
            e["figma"] = x["id"] if x.get("id") else f"feil: {x.get('error') or 'ukjent'}"
    return sum(1 for x in done.values() if x.get("id"))


def log_rows(items):
    return [[str(t["id"]), t["title"], t["who"], f"{ITEM}{t['id']}"] for t in sorted(items, key=lambda t: t["id"])]


def write_log(page_id, d, items, done=()):
    sub = f"Åpne tiltak per {long_day(d)} (To Do / Doing). Fylles fra ADO av ops."
    return use_figma(LOG_JS % (json.dumps(log_rows(items), ensure_ascii=False), json.dumps(sub, ensure_ascii=False),
                               json.dumps(sorted(done)), json.dumps(page_id)), {
        "type": "object", "required": ["rows", "green", "error"],
        "properties": {"rows": {"type": "integer"}, "green": {"type": "integer"}, "error": {"type": "string"}}})


# ── context ─────────────────────────────────────────────────────────────────


class Ctx:
    """Board pages, ADO tiltak and epics, and which meeting is next."""

    def __init__(self, need_board=True):
        self.items, self.epics = load_ado()
        self.version, self.pages, self.board, self.board_err, self.people = None, [], None, "", {}
        try:
            f = figma(f"files/{FILE}?depth=1")
            self.version = f"{f['version']}:{f.get('lastModified', '')}"  # version alone lags behind edits
            self.pages = [(p["id"], p["name"]) for p in f["document"]["children"]]
            start = next((p for p in self.pages if p[1].strip().upper() == "STARTSIDE"), None)
            self.people = people_of(page_doc(start[0], self.version)) if start else {}
        except RuntimeError as e:
            self.board_err = str(e)
        self.referat = [(i, n, meeting_date(n)) for i, n in self.pages if n.lower().startswith("referat")]
        self.closed = {e["date"] for e in self.epics if e["lukket"] and e["date"]}
        self.next = next_meeting([r[2] for r in self.referat] + [e["date"] for e in self.epics], self.closed)
        if need_board and self.next:
            self.board = self.board_for(self.next)

    def page_for(self, d):
        return next(((i, n) for i, n, pd in self.referat if pd == d), None)

    def board_for(self, d):
        p = self.page_for(d)
        if not p:
            return None
        try:
            return Board(p, page_doc(p[0], self.version), self.people)
        except RuntimeError as e:
            self.board_err = str(e)
            return None

    def epic(self, d):
        return next((e for e in self.epics if e["date"] == d), None)


# ── add ─────────────────────────────────────────────────────────────────────


def cmd_add(a):
    raw = " ".join(a.text).strip()
    if a.dry:
        if not raw:
            die("ingen tekst")
        e = entry(raw)
        try:
            ctx = Ctx()
            c = classify(e["raw"], ctx, e["kind"])
        except RuntimeError as err:
            die(str(err))
        print(f"{bold(c['kind'])}  {cyan(c['omraade'])} › {c['seksjon'] or '–'}\n  {c['tittel']}")
        print(dim(f"  eier {c['eier'] or '–'} · frist {c['frist']}"))
        if c["info"]:
            print(dim("  " + c["info"]))
        return
    if raw:
        e = enqueue(raw)
        waiting = sum(1 for x in inbox() if stage(x) not in ("ferdig", "feil") and x["key"] != e["key"])
        print(f"i kø{f' ({waiting} foran)' if waiting else ''} — `ops kø` viser hvordan det går")
        return
    if not (TTY and sys.stdin.isatty()):
        die("ingen tekst")
    locale.setlocale(locale.LC_ALL, "")
    os.environ.setdefault("ESCDELAY", "25")
    curses.wrapper(add_tui)


def entry_line(e):
    """(icon, colour name, text) for one innboks entry."""
    st, c = stage(e), e.get("c") or {}
    kind = c.get("kind") or e.get("kind") or ""
    what = (f"#{e['ado']} " if e.get("ado") else "") + (c.get("tittel") or e["raw"])
    where = f"{c['omraade']} › {c.get('seksjon') or '–'}" if c else ""
    who = c.get("eier") if kind == "tiltak" and c.get("eier") else ""
    tail = {"sorterer": "sorterer …", "ADO": "lager ADO-issue …", "board": "venter på board",
            "feil": e.get("err") or str(e.get("figma")), "ferdig": "på board"}[st]
    icon, col = {"sorterer": ("…", "dim"), "ADO": ("…", "yellow"), "board": ("⇡", "yellow"),
                 "feil": ("!", "red"), "ferdig": ("✓", "green")}[st]
    return icon, col, f"{kind or '?':6} {what}" + (f"  — {who}" if who else ""), f"{where}  {tail}".strip()


def cmd_ko(a):
    es = inbox()
    if a.igjen:
        with locked("inbox"):
            es = inbox()
            for e in es:
                if stage(e) == "feil":
                    e["err"] = ""
                    if str(e.get("figma")).startswith("feil"):
                        e["figma"] = "kø"
            save(es)
        spawn_worker()
        print("feilede innspill prøves igjen")
        return
    shown = [e for e in es if stage(e) != "ferdig"] + [e for e in es if stage(e) == "ferdig"][-a.antall:]
    shown.sort(key=lambda e: e["at"])
    if not shown:
        print("køen er tom")
    for e in shown:
        icon, col, text, tail = entry_line(e)
        paint = {"dim": dim, "yellow": yellow, "red": red, "green": green}[col]
        print(f"{paint(icon)} {text[:80]}  {dim(tail)}")
    with locked("worker", block=False) as free:
        if not free:
            print(dim("worker jobber …"))
        elif any(stage(e) in ("sorterer", "ADO") for e in es):
            print(yellow("worker kjører ikke — `ops kø --igjen` starter den"))


def add_tui(scr):
    curses.curs_set(1)
    curses.use_default_colors()
    for i, col in enumerate([curses.COLOR_RED, curses.COLOR_YELLOW, curses.COLOR_GREEN, curses.COLOR_CYAN], 1):
        curses.init_pair(i, col, -1)
    pal = {"red": curses.color_pair(1), "yellow": curses.color_pair(2), "green": curses.color_pair(3),
           "cyan": curses.color_pair(4), "dim": curses.A_DIM}
    scr.timeout(400)
    since = datetime.datetime.now().isoformat(timespec="seconds")
    text = ""

    def put(y, x, s, n, attr=0):
        try:
            scr.addnstr(y, x, re.sub(r"[\x00-\x1f\x7f]", " ", s), max(0, n), attr)
        except curses.error:
            pass

    while True:
        h, w = scr.getmaxyx()
        scr.erase()
        es = inbox()
        mine = [e for e in es if e["at"] >= since or stage(e) not in ("ferdig",)]
        busy = sum(1 for e in mine if stage(e) in ("sorterer", "ADO", "board"))
        put(0, 0, f"ops add — {len(mine)} innspill" + (f", {busy} under arbeid" if busy else ""), w - 1, curses.A_BOLD)
        put(1, 0, "enter = i kø · t: tiltak · n: notat · esc avslutter (køen jobber videre)", w - 1, curses.A_DIM)
        room = h - 5
        y = 3
        for e in mine[-(room // 2):]:
            icon, col, line, tail = entry_line(e)
            put(y, 0, icon, 1, pal[col] | curses.A_BOLD)
            put(y, 2, line, w - 3)
            put(y + 1, 4, tail, w - 5, pal["red"] if col == "red" else curses.A_DIM)
            y += 2
        put(h - 1, 0, "> " + text[-(w - 4):], w - 1, pal["cyan"] | curses.A_BOLD)
        try:
            scr.move(h - 1, min(w - 1, 2 + len(text[-(w - 4):])))
        except curses.error:
            pass
        scr.refresh()
        try:
            c = scr.get_wch()
        except curses.error:
            continue
        if c in ("\n", "\r", curses.KEY_ENTER):
            if text.strip():
                enqueue(text.strip())
            text = ""
        elif c == "\x1b" or (c == "\x04" and not text):
            return
        elif c in (curses.KEY_BACKSPACE, "\x7f", "\b"):
            text = text[:-1]
        elif c == "\x15":
            text = ""
        elif c == "\x17":
            text = re.sub(r"\S*$", "", text.rstrip())
        elif isinstance(c, str) and c.isprintable():
            text += c


# ── worker ──────────────────────────────────────────────────────────────────


def cmd_worker(a):
    """Drain the innboks: sort, create Issues, write stickies. One worker at a time; a second
    one waits for the lock and then picks up whatever arrived meanwhile."""
    with locked("worker"):
        ctx = None
        while True:
            es = inbox()
            if not any(stage(e) in ("sorterer", "ADO", "board") for e in es):
                return
            if ctx is None:
                try:
                    ctx = Ctx()
                except RuntimeError as err:
                    print(f"{datetime.datetime.now():%F %T} {err}", flush=True)
                    return
            new = [e for e in es if stage(e) == "sorterer"]

            def sort(e):
                try:
                    return e["key"], classify(e["raw"], ctx, e.get("kind")), ""
                except RuntimeError as err:
                    return e["key"], None, str(err)
            with concurrent.futures.ThreadPoolExecutor(4) as ex:
                for key, c, err in ex.map(sort, new):
                    update(key, c=c, err=err, figma="kø" if c else None)

            for e in [e for e in inbox() if stage(e) == "ADO"]:
                try:
                    nxt = ctx.next
                    id = create_issue(e["c"], e["raw"], nxt, ctx.people, ensure_epic(nxt, ctx.epics),
                                      f"ops add {e['at'][:10]}, {e['c']['omraade']}")
                    update(e["key"], ado=id)
                except RuntimeError as err:
                    update(e["key"], err=str(err))

            queued = [e for e in inbox() if stage(e) == "board"]
            if queued and ctx.board:
                try:
                    push(queued, ctx.board)
                    for e in queued:
                        update(e["key"], figma=e["figma"])
                except RuntimeError as err:
                    for e in queued:
                        update(e["key"], figma=f"feil: {err}")
            if not any(stage(e) in ("sorterer", "ADO") for e in inbox()):
                return  # what's left waits for a board page (`ops neste`) or for `ops kø --igjen`


# ── watch ───────────────────────────────────────────────────────────────────
# A sticky is taken only once its text is the same on two looks in a row, so nobody's half-typed
# line becomes an Issue. Issues made but not yet tagged on the board are kept in watch.json, so a
# failed board write is retried instead of making the Issue twice.

WATCH = os.path.join(os.path.dirname(INBOX), "watch.json")


def watch_made():
    try:
        with open(WATCH) as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}


def save_made(made):
    os.makedirs(os.path.dirname(WATCH), exist_ok=True)
    with open(WATCH, "w") as f:
        json.dump(made, f, ensure_ascii=False, indent=1)


def say(msg):
    print(f"{datetime.datetime.now():%H:%M:%S} {msg}", flush=True)


def watch_pass(state, dry, wait=True):
    """One look at the next meeting's page: Utfall stickies without #id → Issues, stickies retagged."""
    f = figma(f"files/{FILE}?depth=1")
    ver = f"{f['version']}:{f.get('lastModified', '')}"
    if wait and ver == state.get("ver") and not state["pending"]:
        return
    state["ver"] = ver
    ctx = Ctx()
    board = ctx.board
    if not board:
        if state.get("missing") != ctx.next:
            say(dim(ctx.board_err or f"ingen side for {day(ctx.next)} ennå — `ops neste` lager den"))
        state["missing"], state["pending"] = ctx.next, {}
        return
    state["missing"] = None
    d = board.date
    if d in ctx.closed:
        return
    loose = {st["id"]: (ar, s, st) for ar, s, st in board.stickies()
             if s["name"] and COMMIT.search(s["name"]) and st["text"] and not TAGGED.search(st["text"])}
    made = watch_made()
    ready = [v for k, v in loose.items() if k not in made and (not wait or state["pending"].get(k) == v[2]["text"])]
    state["pending"] = {k: v[2]["text"] for k, v in loose.items() if k not in made and v not in ready}
    retag = [{"id": k, "text": t} for k, t in made.items() if k in loose]
    if ready and not dry:
        try:
            mark(board, [{"id": st["id"], "mark": "…"} for _, _, st in ready])
        except RuntimeError as e:
            say(red(f"merke: {e}"))
    nxt = d if d > today() else next_meeting(
        [r[2] for r in ctx.referat] + [e["date"] for e in ctx.epics] + [d + WEEK], ctx.closed | {d})
    for ar, s, st in ready:
        c = classify(st["text"], ctx, "tiltak")
        c["omraade"] = ar["name"]
        hit = same(c["tittel"], ctx.items)
        if hit:
            text = f"#{hit['id']} {st['text']}"
            say(dim(f"= #{hit['id']} {hit['title'][:60]} — finnes i ADO, stickyen får #{hit['id']}"))
        elif dry:
            say(f"ville laget  {c['tittel'][:64]}  " + dim(f"{c['eier'] or '–'} · {c['frist']} · {ar['name']}"))
            continue
        else:
            id = create_issue(c, st["text"], nxt, ctx.people, ensure_epic(d, ctx.epics),
                              f"{epic_title(d)}, {ar['name']} › {s['name']} (sticky)")
            ctx.items.append({"id": id, "title": c["tittel"]})
            text = sticky_text({"c": c, "ado": id})
            say(green(f"#{id}") + f"  {c['tittel']}  " + dim(f"{c['eier'] or 'uten eier'} · {ar['name']}"))
        made[st["id"]] = text
        save_made(made)
        retag.append({"id": st["id"], "text": text})
    if dry or not retag:
        return
    mark(board, retag)
    save_made({k: t for k, t in watch_made().items() if k not in {r["id"] for r in retag}})
    say(dim(f"{len(retag)} sticky(er) oppdatert på «{board.page}»"))


def mark(board, items):
    return use_figma(MARK_JS % (json.dumps(items, ensure_ascii=False), json.dumps(board.page_id)),
                     {"type": "object", "required": ["n"], "properties": {"n": {"type": "integer"}}})


def cmd_watch(a):
    with locked("watch", block=False) as free:
        if not free:
            die("ops watch kjører allerede")
        if not a.dry:
            cmd_ko(argparse.Namespace(igjen=True, antall=0))
        if not a.en:
            cmd_apne(a)
            say(dim(f"følger med på boardet hvert {a.hvert}. sekund — ctrl-c avslutter"))
        state = {"pending": {}}
        try:
            while True:
                try:
                    watch_pass(state, a.dry, wait=not a.en)
                except RuntimeError as e:
                    say(red(str(e)))
                if a.en:
                    return
                time.sleep(a.hvert)
        except KeyboardInterrupt:
            print()


# ── neste ───────────────────────────────────────────────────────────────────


def cmd_neste(a):
    try:
        ctx = Ctx(need_board=False)
        closed = tidy(dry=a.dry)
    except RuntimeError as e:
        die(str(e))
    report_tidy(closed, a.dry)
    if ctx.board_err:
        die(ctx.board_err)
    referat, pages = ctx.referat, ctx.pages
    dated = [r for r in referat if r[2]]
    if not dated:
        die("ingen daterte «Referat …»-sider å regne ut fra")
    newest = referat[-1]
    warn = []
    if a.dato:
        d = meeting_date(a.dato)
        if not d:
            die(f"skjønner ikke datoen «{a.dato}» — skriv f.eks. «23. okt»")
    else:
        wds = [r[2].weekday() for r in dated]
        wd = max(set(wds), key=wds.count)  # the weekday the pages agree on
        d = (newest[2] or max(r[2] for r in dated)) + datetime.timedelta(days=1)
        while d.weekday() != wd:
            d += datetime.timedelta(days=1)
        if d < today():
            skipped = d
            while d < today():
                d += WEEK
            warn.append(f"ingen side for {day(skipped)}" + (f"–{day(d - WEEK)}" if d - skipped > WEEK else "")
                        + " — møte uten referat?")
    if any(r[2] == d for r in referat):
        die(f"«{next(r[1] for r in referat if r[2] == d)}» finnes allerede")
    kind = cadence(d)
    tpl = next((p for p in pages if p[1].strip().lower() == kind.lower()), None)
    if not tpl:
        die(f"fant ikke malen «{kind}»")
    if kind == "Kvartalsvis":
        warn.append("kvartalsregelen (siste fredag i mars/juni/sept/des) er antatt, står ikke på STARTSIDE")
    name = f"Referat {d.day}. {PAGE_MONTHS[d.month - 1]}"
    if newest[2] and newest[2] < d:
        ep = ctx.epic(newest[2])
        if not ep or not ep["lukket"]:
            warn.append(f"«{newest[1]}» er ikke lukket — tiltakene derfra mangler i ADO; kjør `ops lukk {newest[2].day}."
                        f" {PAGE_MONTHS[newest[2].month - 1]}` først")
    queued = [e for e in inbox() if stage(e) == "board"]

    print(f"Neste møte: {bold(day(d) + ' ' + str(d.year))}  ({kind.lower()})")
    print(f"Ny side:    «{name}», fra malen «{tpl[1]}»")
    print(f"Tiltakslogg: {len(ctx.items)} åpne tiltak"
          + (f" ({sum(t['state'] == 'To Do' for t in ctx.items)} To Do, {sum(t['state'] == 'Doing' for t in ctx.items)} Doing)" if ctx.items else ""))
    print(f"Epic:       «{epic_title(d)}»" + (" (finnes)" if ctx.epic(d) else " (ny)"))
    if queued:
        print(f"Kø:         {len(queued)} sticky(er) skrives til siden")
    for w in warn:
        print(yellow(f"  ! {w}"))
    if a.dry:
        print(dim("--dry: ingenting skrevet"))
        return
    if not confirm("Opprett siden?", a.yes):
        print("avbrutt")
        return

    try:
        ensure_epic(d, ctx.epics)
        print(dim("… kloner malen via Figma-MCP"), file=sys.stderr)
        r = use_figma(CLONE_PAGE_JS % (json.dumps(tpl[0]), json.dumps(name)), {
            "type": "object", "required": ["page", "last"],
            "properties": {"page": {"type": "string"}, "last": {"type": "boolean"}}})
    except RuntimeError as e:
        die(str(e))
    pid = r["page"]
    print(f"Opprettet «{name}» ({kind.lower()})\n  {BOARD}?node-id={pid.replace(':', '-')}")
    if not r["last"]:
        print(red("  ! siden havnet ikke sist — flytt den sist, ellers finner ops feil side"))
    print(dim(f"… fyller tiltaksloggen ({len(ctx.items)} rader)"), file=sys.stderr)
    try:
        t = write_log(pid, d, ctx.items)
        print(red(f"  ! tiltakslogg: {t['error']}") if t["error"] else f"Tiltakslogg: {t['rows']} åpne tiltak ført videre")
    except RuntimeError as e:
        print(red(f"  ! tiltakslogg feilet: {e}"))
    unowned = [f"#{x['id']}" for x in ctx.items if not x["assigned"]]
    if unowned:
        print(dim(f"  uten ansvarlig i ADO: {', '.join(unowned)}"))
    if queued:
        spawn_worker()
        print(f"{len(queued)} sticky(er) fra køen skrives i bakgrunnen — `ops kø`")


# ── åpne ────────────────────────────────────────────────────────────────────


def cmd_apne(a):
    try:
        ctx = Ctx(need_board=False)
    except RuntimeError as e:
        die(str(e))
    if ctx.board_err:
        die(ctx.board_err)
    page = ctx.page_for(ctx.next)
    if not page:
        print(yellow(f"ingen side for {day(ctx.next)} ennå — `ops neste` lager den; åpner boardet"), file=sys.stderr)
    url = f"{BOARD}?node-id={page[0].replace(':', '-')}" if page else BOARD
    print(f"{bold(page[1]) if page else 'Operations'}  {dim(url)}")
    subprocess.Popen(["open", url], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


# ── lukk ────────────────────────────────────────────────────────────────────


def cmd_lukk(a):
    try:
        ctx = Ctx(need_board=False)
    except RuntimeError as e:
        die(str(e))
    if ctx.board_err:
        die(ctx.board_err)
    if a.dato:
        d = meeting_date(a.dato)
        if not d or not ctx.page_for(d):
            die(f"fant ingen referat-side for «{a.dato}»")
    else:
        held = [r[2] for r in ctx.referat if r[2] and r[2] <= today()]
        if not held:
            die("ingen referat-side for et møte som har vært")
        d = max(held)
    if d in ctx.closed and not a.igjen:
        die(f"møtet {day(d)} er allerede lukket (`--igjen` skriver referatet på nytt)")
    board = ctx.board_for(d)
    if not board:
        die(ctx.board_err or f"kunne ikke lese siden for {day(d)}")
    nxt = next_meeting([r[2] for r in ctx.referat] + [e["date"] for e in ctx.epics] + [d + WEEK], ctx.closed | {d})
    ep = ctx.epic(d)
    known = ctx.items + ([{"id": f["System.Id"], "title": f["System.Title"]} for f in
                          wiql(f"[System.WorkItemType] = 'Issue' AND [System.Parent] = {ep['id']}")] if ep else [])

    new = [(ar, s, st) for ar, s, st in board.stickies() if s["name"] and COMMIT.search(s["name"]) and not TAGGED.search(st["text"])]
    tagged = [(ar, s, st) for ar, s, st in board.stickies() if TAGGED.search(st["text"])]
    print(f"{bold(board.page)}  ({day(d)})  {dim(board.url())}")
    print(dim(f"… {MODEL} leser {len(new)} tiltak fra Utfall"), file=sys.stderr)
    try:
        parsed = {}
        if new:
            r = claude(PARSE, json.dumps([{"id": st["id"], "tema": ar["name"], "tekst": st["text"]} for ar, s, st in new],
                                         ensure_ascii=False),
                       {"type": "object", "required": ["tiltak"], "properties": {"tiltak": {"type": "array", "items": {
                           "type": "object", "required": ["id", "tittel", "eier", "frist"],
                           "properties": {k: {"type": "string"} for k in ("id", "tittel", "eier", "frist")}}}}})
            parsed = {t["id"]: t for t in r["tiltak"]}
    except RuntimeError as e:
        die(str(e))
    todo, found = [], []
    for ar, s, st in new:
        p = parsed.get(st["id"]) or {"tittel": st["text"].split("\n")[0], "eier": "", "frist": "Ikke satt"}
        c = {"tittel": p["tittel"].strip(), "eier": clean_eier(p["eier"]), "frist": p.get("frist") or "Ikke satt"}
        hit = same(c["tittel"], known)
        (found.append((st, hit)) if hit else todo.append((ar, s, st, c)))

    print(f"\nNye tiltak → ADO (due {day(nxt)}, under «{epic_title(d)}»):" if todo else "\nIngen nye tiltak i Utfall.")
    for i, (ar, s, st, c) in enumerate(todo, 1):
        who = resolve(c["eier"], ctx.people)
        print(f"  {i:2}. {c['tittel'][:64]:64} {c['eier'] or '–':14} {dim(who or ('ingen ADO-match' if c['eier'] else ''))}"
              + (yellow(f"  [{c['frist']}]") if c["frist"] != "Ikke satt" else ""))
    for st, hit in found:
        print(dim(f"  = #{hit['id']} {hit['title'][:60]} — finnes i ADO, stickyen får #{hit['id']}"))
    if tagged:
        print(dim(f"  + {len(tagged)} sticky(er) som allerede er tiltak: "
                  + ", ".join("#" + TAGGED.search(st["text"]).group(1) for _, _, st in tagged)))
    notes = sum(1 for _, s, _ in board.stickies() if not (s["name"] and COMMIT.search(s["name"])))
    print(f"Referat: {notes} notater fra {len(board.areas)} temaer → beskrivelsen til «{epic_title(d)}»")
    if a.dry:
        closed = tidy(dry=True)
        report_tidy(closed, True)
        print(dim("--dry: ingenting skrevet"))
        return
    if not confirm("Opprett tiltakene og lukk møtet?", a.yes):
        print("avbrutt")
        return

    try:
        epic = ensure_epic(d, ctx.epics)
        made, retag = [], [{"id": st["id"], "text": f"#{hit['id']} {st['text']}"} for st, hit in found]
        for ar, s, st, c in todo:
            id = create_issue(c, st["text"], nxt, ctx.people, epic,
                              f"{epic_title(d)}, {ar['name']} › {s['name']}")
            made.append((id, c))
            retag.append({"id": st["id"], "text": f"#{id} {st['text']}"})
            print(green(f"  #{id}") + f"  {c['tittel']}")
        tiltak = [f"#{id} {c['tittel']} — {c['eier'] or 'uten eier'}" for id, c in made]
        tiltak += [f"#{TAGGED.search(st['text']).group(1)} {st['text'].splitlines()[0]}" for _, _, st in tagged]
        tiltak += [f"#{hit['id']} {hit['title']}" for _, hit in found]
        stickies = [{"tema": ar["name"], "seksjon": s["name"] or "–", "tekst": st["text"]} for ar, s, st in board.stickies()]
        print(dim(f"… {REFERAT_MODEL} skriver referatet"), file=sys.stderr)
        ref = claude(REFERAT, "\n".join([
            f"Møte: {epic_title(d)}. FigJam-side: «{board.page}» ({board.url()}). Neste møte: {nxt.isoformat()}.",
            "", "Stickies:", json.dumps(stickies, ensure_ascii=False, indent=1),
            "", "Tiltak:", *tiltak]), {"type": "object", "required": ["html"], "properties": {"html": {"type": "string"}}},
            model=REFERAT_MODEL)["html"]
        patch(epic, {"System.Description": ref + f"<br><br><i>{LUKKET} {today().isoformat()}.</i>"})
        print(f"Referat skrevet til epic #{epic}  {ITEM}{epic}")
        if retag:
            print(dim("… merker stickies med #id"), file=sys.stderr)
            use_figma(RETAG_JS % (json.dumps(retag, ensure_ascii=False), json.dumps(board.page_id)),
                      {"type": "object", "required": ["n"], "properties": {"n": {"type": "integer"}}})
        closed = tidy()
    except RuntimeError as e:
        die(str(e))
    report_tidy(closed)
    unowned = [f"#{id}" for id, c in made if not resolve(c["eier"], ctx.people)]
    if unowned:
        print(yellow(f"Uten assignee: {', '.join(unowned)}"))
    print(f"Møtet {day(d)} er lukket. Neste: `ops neste`")


# ── log ─────────────────────────────────────────────────────────────────────


def sort_key(t):
    return (t["due"] or datetime.date.max, t["id"])


def print_log(ctx):
    for t in sorted(ctx.items, key=sort_key):
        late = t["due"] and t["due"] < today()
        print((red if late else dim)(f"{day(t['due']) if t['due'] else '–':11}") + f" #{t['id']}  {t['title'][:64]:64} "
              + dim(f"{t['who'] or '–':16} {t['state']}"))


def cmd_log(a):
    try:
        ctx = Ctx(need_board=False)
        closed = tidy()
    except RuntimeError as e:
        die(str(e))
    report_tidy(closed)
    if not (TTY and sys.stdin.isatty()):
        print_log(ctx)
        return
    locale.setlocale(locale.LC_ALL, "")
    os.environ.setdefault("ESCDELAY", "25")
    done = set()
    curses.wrapper(log_tui, ctx, done)
    if done and not a.ingen_board:
        page = ctx.page_for(ctx.next)
        if page:
            print(dim(f"… oppdaterer tiltaksloggen på «{page[1]}»"), file=sys.stderr)
            try:
                left = [t for t in ctx.items if t["state"] != "Done"]
                r = write_log(page[0], ctx.next, left, done)
                print(red(r["error"]) if r["error"] else f"tiltakslogg: {r['rows']} åpne · {r['green']} sticky(er) grønne")
            except RuntimeError as e:
                print(red(str(e)))


def log_tui(scr, ctx, done):
    curses.curs_set(0)
    curses.use_default_colors()
    for i, col in enumerate([curses.COLOR_RED, curses.COLOR_YELLOW, curses.COLOR_GREEN, curses.COLOR_CYAN], 1):
        curses.init_pair(i, col, -1)
    RED, YEL, GRN, CYA = (curses.color_pair(i) for i in range(1, 5))
    scr.timeout(250)
    items = sorted(ctx.items, key=sort_key)
    sel, top, msg, busy = 0, 0, "", []
    ask = None

    def put(y, x, s, n, attr=0):
        try:
            scr.addnstr(y, x, re.sub(r"[\x00-\x1f\x7f]", " ", s), max(0, n), attr)
        except curses.error:
            pass

    def run(label, fn):
        def go():
            nonlocal msg
            try:
                msg = fn() or ""
            except RuntimeError as e:
                msg = "! " + str(e)
            finally:
                busy.remove(label)
        busy.append(label)
        threading.Thread(target=go, daemon=True).start()

    def toggle(t):
        to = "To Do" if t["state"] == "Done" else "Done"

        def fn():
            set_state(t["id"], to)
            t["state"] = to
            (done.add if to == "Done" else done.discard)(t["id"])
            return f"#{t['id']} → {to}"
        run("oppdaterer", fn)

    def doing(t):
        to = "To Do" if t["state"] == "Doing" else "Doing"

        def fn():
            set_state(t["id"], to)
            t["state"] = to
            return f"#{t['id']} → {to}"
        run("oppdaterer", fn)

    def shift(t, weeks):
        base = t["due"] or ctx.next or today()
        to = base + weeks * WEEK

        def fn():
            set_due(t["id"], to)
            t["due"] = to
            return f"#{t['id']} due {day(to)}"
        run("oppdaterer", fn)

    while True:
        h, w = scr.getmaxyx()
        scr.erase()
        open_ = [t for t in items if t["state"] != "Done"]
        late = sum(1 for t in open_ if t["due"] and t["due"] < today())
        put(0, 0, f"Tiltak — {len(open_)} åpne · {late} forfalt · neste møte {day(ctx.next)}", w - 1, curses.A_BOLD)
        room = h - 3
        sel = max(0, min(sel, len(items) - 1))
        top = min(max(top, sel - room + 1), sel)
        for i, t in enumerate(items[top:top + room]):
            y, cur = 2 + i, top + i == sel
            isdone = t["state"] == "Done"
            overdue = t["due"] and t["due"] < today() and not isdone
            attr = curses.A_REVERSE if cur else 0
            put(y, 0, " " * (w - 1), w - 1, attr)
            put(y, 0, f"{day(t['due']) if t['due'] else '–':11}", 11, attr | (RED if overdue else curses.A_DIM))
            put(y, 12, ("✓ " if isdone else "▸ " if t["state"] == "Doing" else "  "), 2,
                attr | (GRN if isdone else YEL))
            put(y, 14, f"#{t['id']} {t['title']}", w - 34, attr | (curses.A_DIM if isdone else 0))
            put(y, w - 19, f"{(t['who'] or '–')[:18]}", 18, attr | curses.A_DIM)
        if ask:
            put(h - 1, 0, ask[0] + "  j/n", w - 1, YEL | curses.A_BOLD)
        elif busy:
            put(h - 1, 0, "… " + busy[0], w - 1, YEL)
        else:
            put(h - 1, 0, msg or "x løst · u +1 uke · U −1 uke · d doing · o åpne · r oppdater · q avslutt",
                w - 1, (RED if msg.startswith("!") else GRN) if msg else curses.A_DIM)
        scr.refresh()

        k = scr.getch()
        if k == -1:
            continue
        ch = chr(k) if 32 <= k < 256 else "\0"
        if ask:
            fn, ask = ask[1], None
            if ch in "jJyY":
                fn()
            continue
        msg = ""
        t = items[sel] if items else None
        if ch == "q" or k == 27:
            if busy:
                msg = "venter på ADO …"
                continue
            return
        elif k in (curses.KEY_DOWN, ord("j")):
            sel += 1
        elif k in (curses.KEY_UP, ord("k")):
            sel -= 1
        elif k == curses.KEY_NPAGE:
            sel += room
        elif k == curses.KEY_PPAGE:
            sel -= room
        elif t and ch == "x":
            toggle(t)
        elif t and ch == "d" and t["state"] != "Done":
            doing(t)
        elif t and ch in "uU":
            shift(t, 1 if ch == "u" else -1)
        elif t and ch == "o":
            subprocess.Popen(["open", f"{ITEM}{t['id']}"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        elif ch == "r":
            def fn():
                nonlocal items
                fresh, _ = load_ado()
                keep = [t for t in items if t["state"] == "Done"]
                items = sorted(fresh + [t for t in keep if t["id"] not in {f["id"] for f in fresh}], key=sort_key)
                return "oppdatert"
            run("henter", fn)


def main():
    p = argparse.ArgumentParser(prog="ops", description="Operations-møtet: boardet i FigJam, tiltakene i ADO.")
    sub = p.add_subparsers(dest="cmd")
    ne = sub.add_parser("neste", aliases=["ny"], help="før møtet: ny referat-side fra riktig mal, med tiltakslogg")
    ne.add_argument("dato", nargs="?", help="møtedato, f.eks. «30. okt» (utelat for å regne den ut)")
    ne.add_argument("--dry", action="store_true", help="vis planen, skriv ingenting")
    ne.add_argument("-y", "--yes", action="store_true", help="ikke spør")
    ad = sub.add_parser("add", help="nytt innspill i kø (uten tekst: skriv mange etter hverandre)")
    ad.add_argument("text", nargs="*", help="«t: …» = tiltak, «n: …» = notat, ellers bestemmer Haiku")
    ad.add_argument("--dry", action="store_true", help="bare vis sorteringen, legg ingenting i kø")
    ko = sub.add_parser("kø", help="innspillene og hvor langt de har kommet")
    ko.add_argument("--igjen", action="store_true", help="prøv feilede innspill igjen")
    ko.add_argument("-n", "--antall", type=int, default=10, help="ferdige innspill som vises (10)")
    lg = sub.add_parser("log", help="åpne tiltak etter frist: x løst, u +1 uke")
    lg.add_argument("--ingen-board", action="store_true", help="ikke oppdater tiltaksloggen på boardet etterpå")
    lu = sub.add_parser("lukk", help="etter møtet: Utfall → ADO, referat → epic, møtet lukkes")
    lu.add_argument("dato", nargs="?", help="møtedato (utelat for siste møte som ikke er lukket)")
    lu.add_argument("--dry", action="store_true", help="vis planen, skriv ingenting")
    lu.add_argument("--igjen", action="store_true", help="lukk et møte som allerede er lukket på nytt")
    lu.add_argument("-y", "--yes", action="store_true", help="ikke spør")
    wa = sub.add_parser("watch", aliases=["o", "åpne", "sync"], help="under møtet: nye Utfall-stickies → ADO-issues, stickyen ryddes og får #id")
    wa.add_argument("--en", action="store_true", help="én runde, uten å vente på at stickyen er ferdigskrevet")
    wa.add_argument("--dry", action="store_true", help="vis hva som ville blitt laget, skriv ingenting")
    wa.add_argument("--hvert", type=int, default=30, help="sekunder mellom hver titt (30)")
    sub.add_parser("_worker")
    a = p.parse_args()
    if a.cmd is None:
        a = p.parse_args(["log"])
    {"neste": cmd_neste, "ny": cmd_neste, "add": cmd_add, "log": cmd_log, "lukk": cmd_lukk, "watch": cmd_watch, "sync": cmd_watch,
     "kø": cmd_ko, "åpne": cmd_watch, "o": cmd_watch, "_worker": cmd_worker}[a.cmd](a)


if __name__ == "__main__":
    main()
