#compdef wf wi wp wr fleet ops chores entra
#
# Generated by script/completions from each bin's argparse — run it again after changing one.

# work items / PRs fleet last saw, as id:title
_bins_items() {
  local f=${XDG_CACHE_HOME:-$HOME/.cache}/fleet/state.json
  [[ -r $f ]] || return 1
  local -a ids=(${(f)"$(jq -r '.workItems[]? | ., (.tickets[]? // empty) | "\(.id):\(.title | gsub(":"; "\\:"))"' $f 2>/dev/null)"})
  _describe -t work-items 'work item' ids
}
_bins_prs() {
  local f=${XDG_CACHE_HOME:-$HOME/.cache}/fleet/state.json
  [[ -r $f ]] || return 1
  local -a ids=(${(f)"$(jq -r '(.pullRequests[]?, .myPullRequests[]?) | "\(.id):\(.repo) \(.title | gsub(":"; "\\:"))"' $f 2>/dev/null)"})
  _describe -t pull-requests 'pull request' ids
}
_bins_repos() {
  local r; for r in ${(s.:.)${FLEET_ROOTS:-$HOME/visense}}; do _files -W ${~r} -/; done
}
_bins_jobs() {
  local -a jobs=(~/Library/LaunchAgents/com.sanderhurlen.*.plist(N:t:r))
  compadd ${jobs#com.sanderhurlen.}
}
_bins_branches() {
  compadd ${(f)"$(git for-each-ref --format='%(refname:short)' refs/heads 2>/dev/null)"}
}

_bins_wf() {
  local -a subs=(
    'maps:list wayfinder maps'
    'repos:open maps grouped by the repos they touch'
    'map:map overview'
    'spec:spec ticket status'
    'next:next takeable ticket id'
    'open:open in browser'
    'show:one work item in full'
    'go:/wayfinder on a map'\''s next ticket; an empty map is charted, a triaged item run'
    'run:background /implement agent per ticket, in a worktree of this repo'
    'fan:wf run every launchable AFK ticket of a spec'
    'done:close items; a map or spec only when everything under it is done'
    'help:forklaring av modellen, flyten og kommandoene'
  )
  if (( CURRENT == 2 )); then
    [[ $PREFIX == -* ]] && { _arguments '(-n --dry-run)'{-n,--dry-run}'[print the claude command, change nothing]'; return; }
    _describe -t commands 'wf command' subs; return
  fi
  local sub=$words[2]; shift words; (( CURRENT-- ))
  case $sub in
    (maps) _arguments '(-a --all)'{-a,--all}'[include Done maps]' ;;
    (repos) _arguments '(-a --all)'{-a,--all}'[include Done maps]' ;;
    (map) _arguments '1:id:_bins_items' ;;
    (spec) _arguments '1:id:_bins_items' ;;
    (next) _arguments '1:id:_bins_items' ;;
    (open) _arguments '1:id:_bins_items' ;;
    (show) _arguments '1:id:_bins_items' '(-C --no-comments)'{-C,--no-comments}'[]' ;;
    (go) _arguments '1:map:_bins_items' '2::ticket:_bins_items' '--bg[background session (default for research)]' '(-i --interactive)'{-i,--interactive}'[interactive even for research]' ;;
    (run) _arguments '*:ids:_bins_items' '(-i --interactive)'{-i,--interactive}'[foreground session]' '(-f --force)'{-f,--force}'[ignore blockers, readiness, claims, HITL]' '--no-claim[don'\''t assign/set Doing]' ;;
    (fan) _arguments '1:spec:_bins_items' '(-y --yes)'{-y,--yes}'[]' '--no-claim[]' ;;
    (done) _arguments '*:ids:_bins_items' '(-f --force)'{-f,--force}'[close even with open items under it]' ;;
    (help) _arguments '1::topic:(maps repos map spec next open show go run fan done help)' ;;
  esac
}

